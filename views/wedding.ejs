<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="<%= wedding.theme?.background || '#fcfbf7' %>">
  <title><%= wedding.bride?.name || 'Bride' %> & <%= wedding.groom?.name || 'Groom' %> — The Wedding Celebration</title>
  <meta name="description" content="<%= wedding.opening?.text || 'Undangan Pernikahan Online Eksklusif' %>">

  <!-- Open Graph / Meta -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= wedding.bride?.name || '' %> & <%= wedding.groom?.name || '' %> Wedding Invitation">
  <meta property="og:description" content="<%= wedding.opening?.text || 'Kami mengundang Anda untuk hadir di hari bahagia kami.' %>">
  <% if (wedding.gallery && wedding.gallery[0]?.url) { %>
    <meta property="og:image" content="<%= wedding.gallery[0].url %>">
  <% } %>

  <!-- Google Fonts: Luxury Editorial Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    :root {
      --bg-main: <%= wedding.theme?.background || '#fbf9f5' %>;
      --text-main: <%= wedding.theme?.text || '#2b2623' %>;
      --accent: <%= wedding.theme?.accent || '#8a735c' %>;
      --accent-rgb: 138, 115, 92;
      --accent-hover: #735f4b;
      --muted: <%= wedding.theme?.muted || '#787068' %>;
      --card-bg: rgba(255, 255, 255, 0.65);
      --card-border: rgba(138, 115, 92, 0.18);
      --glass-bg: rgba(251, 249, 245, 0.82);
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-display: 'Cinzel', 'Playfair Display', serif;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: var(--font-sans);
      overflow-x: hidden;
      line-height: 1.6;
      background-image: 
        radial-gradient(at 10% 20%, rgba(var(--accent-rgb), 0.04) 0px, transparent 50%),
        radial-gradient(at 90% 80%, rgba(var(--accent-rgb), 0.05) 0px, transparent 50%);
      background-attachment: fixed;
    }

    body.locked {
      overflow: hidden;
      height: 100vh;
    }

    /* Typography Utilities */
    .font-serif { font-family: var(--font-serif); }
    .font-display { font-family: var(--font-display); }
    .font-sans { font-family: var(--font-sans); }

    /* Cover / Entrance Overlay */
    .cover-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100svh;
      padding: 24px;
      text-align: center;
      background: var(--bg-main);
      transition: transform 1s cubic-bezier(0.77, 0, 0.175, 1), opacity 0.8s ease, visibility 0.8s ease;
      background-image: 
        radial-gradient(circle at 50% 30%, rgba(var(--accent-rgb), 0.08) 0%, transparent 70%),
        radial-gradient(circle at 50% 80%, rgba(var(--accent-rgb), 0.05) 0%, transparent 60%);
    }

    .cover-overlay::before {
      content: "";
      position: absolute;
      inset: 15px;
      border: 1px solid rgba(var(--accent-rgb), 0.2);
      pointer-events: none;
      border-radius: 12px;
    }

    .cover-overlay.opened {
      transform: translateY(-100%);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .cover-card {
      position: relative;
      width: min(100%, 540px);
      padding: 40px 24px;
      z-index: 2;
      animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .badge-eyebrow {
      display: inline-block;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      font-size: 11px;
      font-weight: 600;
      color: var(--accent);
      margin-bottom: 20px;
      padding: 4px 14px;
      background: rgba(var(--accent-rgb), 0.08);
      border-radius: 999px;
      border: 1px solid rgba(var(--accent-rgb), 0.15);
    }

    .cover-title {
      font-family: var(--font-serif);
      font-size: clamp(48px, 11vw, 84px);
      font-weight: 400;
      line-height: 0.95;
      letter-spacing: -0.01em;
      margin: 15px 0 25px;
      color: var(--text-main);
    }

    .cover-title span {
      display: block;
      font-family: var(--font-serif);
      font-style: italic;
      font-size: 0.5em;
      color: var(--accent);
      margin: 4px 0;
    }

    .cover-guest-box {
      margin: 25px auto 35px;
      padding: 20px;
      border-radius: 16px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      backdrop-filter: blur(10px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    }

    .cover-guest-box small {
      display: block;
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .cover-guest-box strong {
      display: block;
      font-family: var(--font-serif);
      font-size: clamp(22px, 5vw, 30px);
      font-weight: 600;
      color: var(--text-main);
      letter-spacing: 0.02em;
    }

    .btn-open {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: var(--accent);
      color: #ffffff;
      border: 0;
      padding: 15px 36px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 10px 25px rgba(var(--accent-rgb), 0.35);
      transition: all 0.35s ease;
    }

    .btn-open:hover {
      background: var(--accent-hover);
      transform: translateY(-2px);
      box-shadow: 0 14px 28px rgba(var(--accent-rgb), 0.45);
    }

    /* Layout Frame */
    .app-container {
      max-width: 860px;
      margin: 0 auto;
      min-height: 100vh;
      position: relative;
      padding: 0 20px 140px;
    }

    /* Common Section Styles */
    section {
      padding: 90px 0;
      position: relative;
    }

    .section-header {
      text-align: center;
      margin-bottom: 50px;
    }

    .section-tag {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.3em;
      color: var(--accent);
      font-weight: 600;
      display: inline-block;
      margin-bottom: 12px;
    }

    .section-heading {
      font-family: var(--font-serif);
      font-size: clamp(36px, 7vw, 56px);
      font-weight: 400;
      line-height: 1.1;
      color: var(--text-main);
    }

    .section-subtitle {
      color: var(--muted);
      font-size: 14px;
      max-width: 580px;
      margin: 15px auto 0;
      line-height: 1.8;
    }

    /* Hero / Opening */
    .hero-section {
      min-height: 85vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding-top: 60px;
    }

    .hero-ornament {
      width: 60px;
      height: 1px;
      background: var(--accent);
      margin: 24px auto;
      position: relative;
    }

    .hero-ornament::after {
      content: "✦";
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      background: var(--bg-main);
      padding: 0 8px;
      font-size: 10px;
      color: var(--accent);
    }

    /* Quote Box */
    .quote-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      padding: 40px 30px;
      border-radius: 20px;
      text-align: center;
      backdrop-filter: blur(8px);
      box-shadow: 0 10px 35px rgba(0, 0, 0, 0.02);
      position: relative;
    }

    .quote-text {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: clamp(20px, 4vw, 28px);
      line-height: 1.5;
      color: var(--text-main);
      margin-bottom: 15px;
    }

    .quote-source {
      font-size: 13px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      font-weight: 600;
    }

    /* Couple Cards */
    .couple-wrapper {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
      margin-top: 20px;
    }

    .couple-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      padding: 36px 24px;
      text-align: center;
      backdrop-filter: blur(8px);
      transition: transform 0.4s ease, box-shadow 0.4s ease;
      position: relative;
    }

    .couple-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04);
    }

    .couple-avatar {
      width: min(200px, 50vw);
      aspect-ratio: 1;
      margin: 0 auto 24px;
      border-radius: 50%;
      padding: 6px;
      border: 1px dashed var(--accent);
      position: relative;
    }

    .couple-avatar-inner {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      overflow: hidden;
      background: #eee8e0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .couple-avatar-inner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }

    .couple-card:hover .couple-avatar-inner img {
      transform: scale(1.06);
    }

    .couple-nickname {
      font-family: var(--font-serif);
      font-size: clamp(28px, 5vw, 40px);
      font-weight: 500;
      color: var(--text-main);
      margin-bottom: 6px;
    }

    .couple-fullname {
      font-size: 14px;
      font-weight: 600;
      color: var(--accent);
      margin-bottom: 12px;
      letter-spacing: 0.03em;
    }

    .couple-parents {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.6;
    }

    .couple-social {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 15px;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(var(--accent-rgb), 0.08);
      color: var(--accent);
      text-decoration: none;
      font-size: 12px;
      font-weight: 500;
      transition: background 0.3s;
    }

    .couple-social:hover {
      background: rgba(var(--accent-rgb), 0.16);
    }

    .couple-divider {
      grid-column: 1 / -1;
      text-align: center;
      font-family: var(--font-serif);
      font-size: 40px;
      font-style: italic;
      color: var(--accent);
      margin: -15px 0;
    }

    /* Countdown Section */
    .countdown-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      max-width: 580px;
      margin: 30px auto 0;
    }

    .countdown-item {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 20px 10px;
      text-align: center;
      backdrop-filter: blur(8px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.02);
    }

    .countdown-num {
      display: block;
      font-family: var(--font-serif);
      font-size: clamp(32px, 7vw, 48px);
      font-weight: 600;
      color: var(--text-main);
      line-height: 1;
    }

    .countdown-label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--muted);
      margin-top: 6px;
      display: block;
      font-weight: 600;
    }

    /* Events Cards */
    .events-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .event-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 36px 24px;
      text-align: center;
      backdrop-filter: blur(8px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 10px 30px rgba(0,0,0,0.02);
    }

    .event-title {
      font-family: var(--font-serif);
      font-size: clamp(26px, 5vw, 36px);
      font-weight: 500;
      color: var(--text-main);
      margin-bottom: 20px;
    }

    .event-meta {
      display: flex;
      flex-direction: column;
      gap: 12px;
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 24px;
    }

    .event-meta-item {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .event-meta-item i {
      color: var(--accent);
      font-size: 15px;
    }

    .event-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 11px 20px;
      border: 1px solid var(--accent);
      color: var(--accent);
      background: transparent;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn-outline:hover {
      background: var(--accent);
      color: #ffffff;
    }

    /* Story Timeline */
    .timeline {
      position: relative;
      max-width: 650px;
      margin: 40px auto 0;
      padding-left: 30px;
    }

    .timeline::before {
      content: "";
      position: absolute;
      left: 7px;
      top: 10px;
      bottom: 10px;
      width: 1px;
      background: repeating-linear-gradient(to bottom, var(--accent) 0, var(--accent) 4px, transparent 4px, transparent 8px);
      opacity: 0.4;
    }

    .timeline-item {
      position: relative;
      margin-bottom: 40px;
    }

    .timeline-item:last-child {
      margin-bottom: 0;
    }

    .timeline-dot {
      position: absolute;
      left: -30px;
      top: 6px;
      width: 15px;
      height: 15px;
      border-radius: 50%;
      background: var(--bg-main);
      border: 2px solid var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .timeline-dot::after {
      content: "";
      width: 5px;
      height: 5px;
      background: var(--accent);
      border-radius: 50%;
    }

    .timeline-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 24px;
      backdrop-filter: blur(8px);
    }

    .timeline-date {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      color: var(--accent);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 6px;
    }

    .timeline-title {
      font-family: var(--font-serif);
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .timeline-text {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.7;
    }

    /* Gallery Grid */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-top: 30px;
    }

    .gallery-item {
      aspect-ratio: 1;
      border-radius: 16px;
      overflow: hidden;
      cursor: pointer;
      position: relative;
      background: #e8e2d8;
      border: 1px solid var(--card-border);
    }

    .gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .gallery-item::after {
      content: "\f00e";
      font-family: "Font Awesome 6 Free";
      font-weight: 900;
      position: absolute;
      inset: 0;
      background: rgba(var(--accent-rgb), 0.35);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .gallery-item:hover img {
      transform: scale(1.08);
    }

    .gallery-item:hover::after {
      opacity: 1;
    }

    /* Gift & Bank Details */
    .gift-container {
      max-width: 580px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .gift-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 32px 24px;
      text-align: center;
      backdrop-filter: blur(8px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.02);
    }

    .bank-badge {
      display: inline-block;
      font-family: var(--font-serif);
      font-size: 28px;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 10px;
    }

    .account-num {
      font-family: monospace;
      font-size: 22px;
      letter-spacing: 0.1em;
      color: var(--text-main);
      margin: 8px 0;
      font-weight: 600;
    }

    .account-name {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 20px;
    }

    /* RSVP Form */
    .rsvp-container {
      max-width: 580px;
      margin: 0 auto;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      padding: 36px 28px;
      backdrop-filter: blur(8px);
      box-shadow: 0 15px 40px rgba(0,0,0,0.03);
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    .form-control {
      width: 100%;
      padding: 14px 16px;
      border: 1px solid rgba(var(--accent-rgb), 0.25);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.7);
      color: var(--text-main);
      font-family: inherit;
      font-size: 14px;
      outline: none;
      transition: border-color 0.3s, box-shadow 0.3s;
    }

    .form-control:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.15);
      background: #ffffff;
    }

    .btn-submit {
      width: 100%;
      padding: 16px;
      background: var(--accent);
      color: #fff;
      border: 0;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 10px 25px rgba(var(--accent-rgb), 0.3);
      transition: all 0.3s;
    }

    .btn-submit:hover {
      background: var(--accent-hover);
      transform: translateY(-2px);
    }

    .rsvp-status-alert {
      padding: 14px;
      border-radius: 12px;
      font-size: 13px;
      margin-top: 15px;
      display: none;
      text-align: center;
    }

    /* Floating Navigation */
    .bottom-nav {
      position: fixed;
      left: 50%;
      bottom: max(16px, env(safe-area-inset-bottom));
      transform: translateX(-50%);
      width: min(calc(100% - 28px), 560px);
      background: var(--glass-bg);
      border: 1px solid var(--card-border);
      border-radius: 999px;
      padding: 6px 10px;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      z-index: 900;
      backdrop-filter: blur(18px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
    }

    .nav-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      color: var(--muted);
      padding: 8px 0;
      border-radius: 999px;
      font-size: 9px;
      font-weight: 600;
      gap: 3px;
      transition: all 0.3s ease;
    }

    .nav-link i {
      font-size: 15px;
    }

    .nav-link.active, .nav-link:hover {
      color: var(--accent);
      background: rgba(var(--accent-rgb), 0.12);
    }

    /* Floating Music Toggle */
    .music-player-btn {
      position: fixed;
      top: 20px;
      right: 20px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--glass-bg);
      border: 1px solid var(--card-border);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 990;
      backdrop-filter: blur(12px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
      transition: transform 0.3s ease;
    }

    .music-player-btn.playing {
      animation: spinSlow 8s linear infinite;
    }

    /* Toast Notification */
    .toast-box {
      position: fixed;
      bottom: 90px;
      left: 50%;
      transform: translateX(-50%) translateY(30px);
      background: #2b2623;
      color: #ffffff;
      padding: 12px 24px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 500;
      z-index: 99999;
      opacity: 0;
      visibility: hidden;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    .toast-box.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
      visibility: visible;
    }

    /* Lightbox Modal */
    .lightbox-modal {
      position: fixed;
      inset: 0;
      z-index: 100000;
      background: rgba(18, 14, 11, 0.95);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      backdrop-filter: blur(12px);
    }

    .lightbox-modal.active {
      display: flex;
    }

    .lightbox-modal img {
      max-width: 92vw;
      max-height: 85vh;
      object-fit: contain;
      border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }

    .lightbox-close {
      position: absolute;
      top: 24px;
      right: 24px;
      background: transparent;
      border: 0;
      color: #ffffff;
      font-size: 32px;
      cursor: pointer;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Animations */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes spinSlow {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* Responsive Queries */
    @media (max-width: 768px) {
      .couple-wrapper, .events-grid {
        grid-template-columns: 1fr;
        gap: 24px;
      }
      .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      section {
        padding: 65px 0;
      }
    }

    @media (max-width: 480px) {
      .app-container {
        padding: 0 16px 130px;
      }
      .cover-card {
        padding: 30px 16px;
      }
      .countdown-grid {
        gap: 8px;
      }
      .countdown-item {
        padding: 14px 6px;
      }
      .countdown-num {
        font-size: 28px;
      }
      .countdown-label {
        font-size: 9px;
      }
      .bottom-nav {
        width: calc(100% - 20px);
      }
    }
  </style>
</head>
<body class="locked">

  <!-- Cover / Entrance Screen -->
  <div id="coverOverlay" class="cover-overlay">
    <div class="cover-card">
      <div class="badge-eyebrow"><%= wedding.title || 'THE WEDDING OF' %></div>
      <h1 class="cover-title">
        <%= wedding.bride?.name || 'Bride' %>
        <span>&</span>
        <%= wedding.groom?.name || 'Groom' %>
      </h1>
      <p class="section-subtitle" style="margin-bottom: 20px;"><%= wedding.opening?.text || 'Tanpa mengurangi rasa hormat, kami bermaksud mengundang Bapak/Ibu/Saudara/i untuk hadir pada acara pernikahan kami.' %></p>
      
      <div class="cover-guest-box">
        <small>Kepada Yth. Bapak/Ibu/Saudara/i:</small>
        <strong><%= guestName || 'Tamu Undangan' %></strong>
      </div>

      <button id="btnOpenInvitation" class="btn-open" type="button">
        <i class="fa-regular fa-envelope-open"></i>
        <span><%= wedding.opening?.button || 'BUKA UNDANGAN' %></span>
      </button>
    </div>
  </div>

  <!-- Audio Element & Floating Music Button -->
  <% if (wedding.music && wedding.music.url) { %>
    <audio id="audioPlayer" preload="auto" loop>
      <source src="<%= wedding.music.url %>" type="audio/mpeg">
    </audio>
    <button id="btnMusicToggle" class="music-player-btn" type="button" aria-label="Toggle Music">
      <i class="fa-solid fa-music"></i>
    </button>
  <% } %>

  <!-- Main Content App -->
  <div class="app-container">

    <!-- Hero / Opening Section -->
    <section id="home" class="hero-section reveal">
      <div class="badge-eyebrow"><%= wedding.opening?.eyebrow || "ASSALAMU'ALAIKUM WARAHMATULLAHI WABARAKATUH" %></div>
      <h2 class="section-heading"><%= wedding.opening?.title || "Dengan Penuh Rasa Syukur & Bahagia" %></h2>
      <div class="hero-ornament"></div>
      <p class="section-subtitle"><%= wedding.opening?.text || "Merupakan suatu kehormatan dan kebahagiaan bagi kami sekeluarga apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu pada hari pernikahan kami." %></p>
    </section>

    <!-- Quote / Holy Scripture Section -->
    <% if (wedding.quote && wedding.quote.text) { %>
      <section id="quote" class="reveal">
        <div class="quote-card">
          <div style="font-size:24px;color:var(--accent);margin-bottom:12px;">“</div>
          <p class="quote-text"><%= wedding.quote.text %></p>
          <div class="quote-source">— <%= wedding.quote.source || 'QS. Ar-Rum: 21' %></div>
        </div>
      </section>
    <% } %>

    <!-- The Couple Section -->
    <section id="couple" class="reveal">
      <div class="section-header">
        <span class="section-tag">THE HAPPY COUPLE</span>
        <h2 class="section-heading">Mempelai</h2>
        <p class="section-subtitle">Dua jiwa yang dipersatukan dalam sebuah ikatan suci pernikahan</p>
      </div>

      <div class="couple-wrapper">
        <!-- Groom -->
        <article class="couple-card">
          <div class="couple-avatar">
            <div class="couple-avatar-inner">
              <% if (wedding.groom?.photo?.url) { %>
                <img src="<%= wedding.groom.photo.url %>" alt="<%= wedding.groom.name %>" loading="lazy">
              <% } else { %>
                <span class="font-serif" style="font-size:54px;color:var(--accent);"><%= wedding.groom?.name?.charAt(0) || 'G' %></span>
              <% } %>
            </div>
          </div>
          <h3 class="couple-nickname"><%= wedding.groom?.name || 'Groom' %></h3>
          <div class="couple-fullname"><%= wedding.groom?.fullName || '' %></div>
          <% if (wedding.groom?.parents) { %>
            <p class="couple-parents">Putra dari Pasangan:<br><strong><%= wedding.groom.parents %></strong></p>
          <% } %>
          <% if (wedding.groom?.instagram) { %>
            <a href="https://instagram.com/<%= wedding.groom.instagram.replace('@', '') %>" target="_blank" rel="noopener" class="couple-social">
              <i class="fa-brands fa-instagram"></i>
              <span>@<%= wedding.groom.instagram.replace('@', '') %></span>
            </a>
          <% } %>
        </article>

        <div class="couple-divider">&</div>

        <!-- Bride -->
        <article class="couple-card">
          <div class="couple-avatar">
            <div class="couple-avatar-inner">
              <% if (wedding.bride?.photo?.url) { %>
                <img src="<%= wedding.bride.photo.url %>" alt="<%= wedding.bride.name %>" loading="lazy">
              <% } else { %>
                <span class="font-serif" style="font-size:54px;color:var(--accent);"><%= wedding.bride?.name?.charAt(0) || 'B' %></span>
              <% } %>
            </div>
          </div>
          <h3 class="couple-nickname"><%= wedding.bride?.name || 'Bride' %></h3>
          <div class="couple-fullname"><%= wedding.bride?.fullName || '' %></div>
          <% if (wedding.bride?.parents) { %>
            <p class="couple-parents">Putri dari Pasangan:<br><strong><%= wedding.bride.parents %></strong></p>
          <% } %>
          <% if (wedding.bride?.instagram) { %>
            <a href="https://instagram.com/<%= wedding.bride.instagram.replace('@', '') %>" target="_blank" rel="noopener" class="couple-social">
              <i class="fa-brands fa-instagram"></i>
              <span>@<%= wedding.bride.instagram.replace('@', '') %></span>
            </a>
          <% } %>
        </article>
      </div>
    </section>

    <!-- Countdown Section -->
    <% if (wedding.settings?.showCountdown !== false && wedding.date) { %>
      <section id="countdownSection" class="reveal">
        <div class="section-header">
          <span class="section-tag">SAVE THE DATE</span>
          <h2 class="section-heading">Menghitung Hari</h2>
          <p class="section-subtitle">Waktu yang dinanti menuju hari sakral ikatan janji suci kami</p>
        </div>

        <div class="countdown-grid">
          <div class="countdown-item">
            <span id="countDays" class="countdown-num">00</span>
            <span class="countdown-label">Hari</span>
          </div>
          <div class="countdown-item">
            <span id="countHours" class="countdown-num">00</span>
            <span class="countdown-label">Jam</span>
          </div>
          <div class="countdown-item">
            <span id="countMinutes" class="countdown-num">00</span>
            <span class="countdown-label">Menit</span>
          </div>
          <div class="countdown-item">
            <span id="countSeconds" class="countdown-num">00</span>
            <span class="countdown-label">Detik</span>
          </div>
        </div>
      </section>
    <% } %>

    <!-- Love Story Timeline Section -->
    <% if (wedding.settings?.showStory !== false && wedding.story && wedding.story.length) { %>
      <section id="story" class="reveal">
        <div class="section-header">
          <span class="section-tag">JOURNEY OF LOVE</span>
          <h2 class="section-heading">Kisah Kami</h2>
          <p class="section-subtitle">Untaian cerita perjalanan cinta hingga bermuara ke pelaminan</p>
        </div>

        <div class="timeline">
          <% wedding.story.forEach(function(item) { %>
            <div class="timeline-item">
              <div class="timeline-dot"></div>
              <div class="timeline-card">
                <span class="timeline-date"><%= item.year || item.date || '' %></span>
                <h3 class="timeline-title"><%= item.title || '' %></h3>
                <p class="timeline-text"><%= item.text || item.description || '' %></p>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

    <!-- Wedding Event / Agenda Section -->
    <section id="event" class="reveal">
      <div class="section-header">
        <span class="section-tag">WEDDING AGENDA</span>
        <h2 class="section-heading">Rangkaian Acara</h2>
        <p class="section-subtitle">Insya Allah acara pernikahan kami akan diselenggarakan pada:</p>
      </div>

      <div class="events-grid">
        <% (wedding.events || []).forEach(function(event) { %>
          <article class="event-card">
            <div>
              <h3 class="event-title"><%= event.title || 'Akad / Resepsi' %></h3>
              <div class="event-meta">
                <% if (event.date) { %>
                  <div class="event-meta-item">
                    <i class="fa-regular fa-calendar-check"></i>
                    <span><%= event.date %></span>
                  </div>
                <% } %>
                <% if (event.time) { %>
                  <div class="event-meta-item">
                    <i class="fa-regular fa-clock"></i>
                    <span><%= event.time %></span>
                  </div>
                <% } %>
                <% if (event.venue) { %>
                  <div class="event-meta-item" style="font-weight: 600; color: var(--text-main);">
                    <i class="fa-solid fa-hotel"></i>
                    <span><%= event.venue %></span>
                  </div>
                <% } %>
                <% if (event.address) { %>
                  <div class="event-meta-item">
                    <i class="fa-solid fa-location-dot"></i>
                    <span style="font-size: 13px;"><%= event.address %></span>
                  </div>
