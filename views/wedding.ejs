        <div class="rsvp-container">
          <form id="rsvpForm">
            <div class="form-group">
              <label class="form-label" for="rsvpName">Nama Lengkap</label>
              <input type="text" id="rsvpName" name="name" class="form-control" value="<%= guestName || '' %>" required maxlength="150" placeholder="Masukkan nama Anda">
            </div>

            <div class="form-group">
              <label class="form-label" for="rsvpAttendance">Status Kehadiran</label>
              <select id="rsvpAttendance" name="attendance" class="form-control" required>
