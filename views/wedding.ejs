<!DOCTYPE html>
<html lang="id">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    <%= wedding.groom.name %>
    &
    <%= wedding.bride.name %>
    — LOVEFOREVER
  </title>


  <meta
    name="description"
    content="<%= wedding.groom.name %> & <%= wedding.bride.name %> — Wedding Invitation"
  >


  <meta
    property="og:title"
    content="<%= wedding.groom.name %> & <%= wedding.bride.name %>"
  >


  <meta
    property="og:description"
    content="Wedding Invitation — LOVEFOREVER"
  >


  <link
    rel="stylesheet"
    href="/css/style.css"
  >

</head>


<body class="wedding-page">


<!-- =====================================================
     OPENING
     ===================================================== -->

<section
  class="wedding-opening"
  id="opening"
>

  <div class="opening-content">

    <p class="eyebrow">
      THE WEDDING OF
    </p>


    <h1>

      <%= wedding.groom.name %>

      <span>
        &
      </span>

      <%= wedding.bride.name %>

    </h1>


    <% if (guestName) { %>

      <p class="guest-opening">

        Kepada Yth.

        <strong>
          <%= guestName %>
        </strong>

      </p>

    <% } else { %>

      <p class="guest-opening">
        Dengan penuh kebahagiaan,
        kami mengundang Anda.
      </p>

    <% } %>


    <button
      type="button"
      class="button"
      id="openInvitation"
    >
      Buka Undangan
    </button>

  </div>

</section>


<!-- =====================================================
     MAIN INVITATION
     ===================================================== -->

<main
  id="invitation"
  class="invitation-main"
>


  <!-- ===================================================
       HERO
       =================================================== -->

  <section class="wedding-hero">

    <div class="wedding-hero-overlay">

      <p class="eyebrow">
        WEDDING INVITATION
      </p>


      <h1>

        <%= wedding.groom.name %>

        <span>
          &
        </span>

        <%= wedding.bride.name %>

      </h1>


      <% if (guestName) { %>

        <p class="guest-name">

          Dear

          <strong>
            <%= guestName %>
          </strong>

        </p>

      <% } %>


      <% if (wedding.date) { %>

        <p class="wedding-date">
          <%= wedding.date %>
        </p>

      <% } %>

    </div>

  </section>


  <!-- ===================================================
       COUPLE
       =================================================== -->

  <section class="invitation-section couple-section">

    <p class="eyebrow">
      THE COUPLE
    </p>


    <h2>
      Bride & Groom
    </h2>


    <div class="couple-grid">


      <article class="person-card">

        <% if (wedding.groom.photo) { %>

          <img
            src="<%= wedding.groom.photo %>"
            alt="<%= wedding.groom.fullName || wedding.groom.name %>"
            loading="lazy"
          >

        <% } %>


        <h3>
          <%= wedding.groom.name %>
        </h3>


        <p>
          <%= wedding.groom.fullName || wedding.groom.name %>
        </p>

      </article>


      <div class="couple-ampersand">
        &
      </div>


      <article class="person-card">

        <% if (wedding.bride.photo) { %>

          <img
            src="<%= wedding.bride.photo %>"
            alt="<%= wedding.bride.fullName || wedding.bride.name %>"
            loading="lazy"
          >

        <% } %>


        <h3>
          <%= wedding.bride.name %>
        </h3>


        <p>
          <%= wedding.bride.fullName || wedding.bride.name %>
        </p>

      </article>


    </div>

  </section>


  <!-- ===================================================
       QUOTE
       =================================================== -->

  <% if (wedding.quote) { %>

    <section class="quote-section">

      <div class="quote-content">

        <span class="quote-mark">
          “
        </span>

        <p>
          <%= wedding.quote %>
        </p>

      </div>

    </section>

  <% } %>


  <!-- ===================================================
       COUNTDOWN
       =================================================== -->

  <% if (wedding.date) { %>

    <section class="invitation-section countdown-section">

      <p class="eyebrow">
        COUNTDOWN
      </p>


      <h2>
        Menuju Hari Bahagia
      </h2>


      <div
        class="countdown"
        id="countdown"
        data-date="<%= wedding.date %>"
      >

        <div class="countdown-item">

          <strong id="days">
            0
          </strong>

          <span>
            Hari
          </span>

        </div>


        <div class="countdown-item">

          <strong id="hours">
            0
          </strong>

          <span>
            Jam
          </span>

        </div>


        <div class="countdown-item">

          <strong id="minutes">
            0
          </strong>

          <span>
            Menit
          </span>

        </div>


        <div class="countdown-item">

          <strong id="seconds">
            0
          </strong>

          <span>
            Detik
          </span>

        </div>

      </div>

    </section>

  <% } %>


  <!-- ===================================================
       DESCRIPTION
       =================================================== -->

  <% if (wedding.description) { %>

    <section class="invitation-section">

      <p class="eyebrow">
        OUR STORY
      </p>


      <h2>
        Sebuah Cerita
      </h2>


      <div class="text-content">

        <p>
          <%= wedding.description %>
        </p>

      </div>

    </section>

  <% } %>


  <!-- ===================================================
       STORY
       =================================================== -->

  <% if (wedding.story && wedding.story.length) { %>

    <section class="invitation-section">

      <p class="eyebrow">
        OUR JOURNEY
      </p>


      <h2>
        Perjalanan Kami
      </h2>


      <div class="timeline">

        <% wedding.story.forEach(function(item) { %>

          <article class="timeline-item">

            <span class="timeline-date">
              <%= item.date || item.year || "" %>
            </span>


            <h3>
              <%= item.title %>
            </h3>


            <p>
              <%= item.description %>
            </p>


            <% if (item.photo) { %>

              <img
                src="<%= item.photo %>"
                alt="<%= item.title %>"
                loading="lazy"
              >

            <% } %>

          </article>

        <% }); %>

      </div>

    </section>

  <% } %>


  <!-- ===================================================
       EVENTS
       =================================================== -->

  <% if (wedding.events && wedding.events.length) { %>

    <section class="invitation-section events-section">

      <p class="eyebrow">
        SAVE THE DATE
      </p>


      <h2>
        Acara Pernikahan
      </h2>


      <div class="event-grid">

        <% wedding.events.forEach(function(event) { %>

          <article class="event-card">

            <span class="event-type">
              <%= event.type || "" %>
            </span>


            <h3>
              <%= event.title %>
            </h3>


            <% if (event.date) { %>

              <p>
                <strong>
                  <%= event.date %>
                </strong>
              </p>

            <% } %>


            <% if (event.startTime) { %>

              <p>

                <%= event.startTime %>

                <% if (event.endTime) { %>

                  —
                  <%= event.endTime %>

                <% } %>

              </p>

            <% } %>


            <% if (event.venue) { %>

              <p>
                <%= event.venue %>
              </p>

            <% } %>


            <% if (event.address) { %>

              <p>
                <%= event.address %>
              </p>

            <% } %>


            <% if (event.description) { %>

              <p class="event-description">
                <%= event.description %>
              </p>

            <% } %>


            <% if (event.mapsUrl) { %>

              <a
                href="<%= event.mapsUrl %>"
                target="_blank"
                rel="noopener noreferrer"
                class="button button-small"
              >
                Lihat Lokasi
              </a>

            <% } %>

          </article>

        <% }); %>

      </div>

    </section>

  <% } %>


  <!-- ===================================================
       GALLERY
       =================================================== -->

  <% if (wedding.gallery && wedding.gallery.length) { %>

    <section class="invitation-section">

      <p class="eyebrow">
        OUR MOMENTS
      </p>


      <h2>
        Gallery
      </h2>


      <div class="gallery-grid">

        <% wedding.gallery.forEach(function(image, index) { %>

          <figure class="gallery-item">

            <img
              src="<%= image.base64 || image %>"
              alt="<%= image.caption || 'Wedding photo ' + (index + 1) %>"
              loading="lazy"
              class="gallery-image"
            >


            <% if (image.caption) { %>

              <figcaption>
                <%= image.caption %>
              </figcaption>

            <% } %>

          </figure>

        <% }); %>

      </div>

    </section>

  <% } %>


  <!-- ===================================================
       WEDDING GIFT
       =================================================== -->

  <% if (wedding.gift && wedding.gift.length) { %>

    <section class="invitation-section gift-section">

      <p class="eyebrow">
        WEDDING GIFT
      </p>


      <h2>
        Tanda Kasih
      </h2>


      <div class="gift-grid">

        <% wedding.gift.forEach(function(gift) { %>

          <article class="gift-card">

            <% if (gift.bank) { %>

              <p class="gift-bank">
                <%= gift.bank %>
              </p>

            <% } %>


            <% if (gift.accountName) { %>

              <p>
                <%= gift.accountName %>
              </p>

            <% } %>


            <% if (gift.accountNumber) { %>

              <strong>
                <%= gift.accountNumber %>
              </strong>


              <button
                type="button"
                class="button button-small"
                onclick="copyText('<%= gift.accountNumber %>')"
              >
                Salin Nomor
              </button>

            <% } %>


          </article>

        <% }); %>

      </div>

    </section>

  <% } %>


  <!-- ===================================================
       RSVP
       =================================================== -->

  <section
    class="invitation-section rsvp-section"
    id="rsvp"
  >

    <p class="eyebrow">
      RSVP
    </p>


    <h2>
      Konfirmasi Kehadiran
    </h2>


    <p>
      Mohon konfirmasi kehadiran Anda
      melalui form berikut.
    </p>


    <form
      id="rsvpForm"
      class="form rsvp-form"
    >


      <div class="form-group">

        <label>
          Nama
        </label>

        <input
          type="text"
          name="name"
          maxlength="100"
          required
        >

      </div>


      <div class="form-group">

        <label>
          Kehadiran
        </label>

        <select
          name="attendance"
          required
        >

          <option value="">
            Pilih Kehadiran
          </option>

          <option value="hadir">
            Hadir
          </option>

          <option value="tidak_hadir">
            Tidak Hadir
          </option>

          <option value="masih_menentukan">
            Masih Menentukan
          </option>

        </select>

      </div>


      <div class="form-group">

        <label>
          Jumlah Tamu
        </label>

        <input
          type="number"
          name="guestCount"
          min="1"
          max="20"
          value="1"
          required
        >

      </div>


      <div class="form-group">

        <label>
          Pesan
        </label>

        <textarea
          name="message"
          maxlength="500"
          rows="5"
          placeholder="Tuliskan ucapan..."
        ></textarea>

      </div>


      <button
        type="submit"
        class="button button-full"
      >
        Kirim RSVP
      </button>


      <div
        id="rsvpMessage"
        class="rsvp-message"
      ></div>


    </form>

  </section>


  <!-- ===================================================
       CLOSING
       =================================================== -->

  <section class="closing-section">

    <p class="eyebrow">
      WITH LOVE
    </p>


    <h2>

      <%= wedding.groom.name %>

      &

      <%= wedding.bride.name %>

    </h2>


    <p>
      Terima kasih telah menjadi bagian
      dari hari bahagia kami.
    </p>


    <p class="closing-brand">
      LOVEFOREVER
    </p>

  </section>


</main>


<!-- =====================================================
     MUSIC
     ===================================================== -->

<% if (wedding.music && wedding.music.url) { %>

  <audio
    id="weddingMusic"
    src="<%= wedding.music.url %>"
    loop
    preload="none"
  ></audio>


  <button
    type="button"
    id="musicButton"
    class="music-button"
    aria-label="Toggle music"
  >
    ♪
  </button>

<% } %>


<script>

/*
|--------------------------------------------------------------------------
| OPEN INVITATION
|--------------------------------------------------------------------------
*/

const opening =
  document.getElementById("opening");

const invitation =
  document.getElementById("invitation");

const openButton =
  document.getElementById("openInvitation");


if (openButton) {

  openButton.addEventListener(
    "click",
    function () {

      opening.classList.add(
        "opening-hidden"
      );

      invitation.classList.add(
        "invitation-visible"
      );

      document.body.classList.add(
        "invitation-opened"
      );


      const music =
        document.getElementById(
          "weddingMusic"
        );

      if (music) {

        music.play()
          .catch(function () {
            // Browser may block autoplay.
          });

      }

    }
  );

}


/*
|--------------------------------------------------------------------------
| COUNTDOWN
|--------------------------------------------------------------------------
*/

const countdown =
  document.getElementById("countdown");


if (countdown) {

  const targetDate =
    new Date(
      countdown.dataset.date
    ).getTime();


  function updateCountdown() {

    const now =
      new Date().getTime();


    const distance =
      targetDate - now;


    if (distance <= 0) {

      document.getElementById(
        "days"
      ).textContent = "0";

      document.getElementById(
        "hours"
      ).textContent = "0";

      document.getElementById(
        "minutes"
      ).textContent = "0";

      document.getElementById(
        "seconds"
      ).textContent = "0";

      return;

    }


    const days =
      Math.floor(
        distance /
        (1000 * 60 * 60 * 24)
      );


    const hours =
      Math.floor(
        (distance %
          (1000 * 60 * 60 * 24)) /
        (1000 * 60 * 60)
      );


    const minutes =
      Math.floor(
        (distance %
          (1000 * 60 * 60)) /
        (1000 * 60)
      );


    const seconds =
      Math.floor(
        (distance %
          (1000 * 60)) /
        1000
      );


    document.getElementById(
      "days"
    ).textContent = days;


    document.getElementById(
      "hours"
    ).textContent = hours;


    document.getElementById(
      "minutes"
    ).textContent = minutes;


    document.getElementById(
      "seconds"
    ).textContent = seconds;

  }


  updateCountdown();

  setInterval(
    updateCountdown,
    1000
  );

}


/*
|--------------------------------------------------------------------------
| MUSIC
|--------------------------------------------------------------------------
*/

const music =
  document.getElementById(
    "weddingMusic"
  );

const musicButton =
  document.getElementById(
    "musicButton"
  );


if (music && musicButton) {

  musicButton.addEventListener(
    "click",
    function () {

      if (music.paused) {

        music.play();

        musicButton.classList.add(
          "music-playing"
        );

      } else {

        music.pause();

        musicButton.classList.remove(
          "music-playing"
        );

      }

    }
  );

}


/*
|--------------------------------------------------------------------------
| RSVP
|--------------------------------------------------------------------------
*/

const rsvpForm =
  document.getElementById(
    "rsvpForm"
  );

const rsvpMessage =
  document.getElementById(
    "rsvpMessage"
  );


if (rsvpForm) {

  rsvpForm.addEventListener(
    "submit",
    async function (event) {

      event.preventDefault();


      const submitButton =
        rsvpForm.querySelector(
          "button[type='submit']"
        );


      submitButton.disabled = true;

      submitButton.textContent =
        "Mengirim...";


      const formData =
        new FormData(rsvpForm);


      const data =
        Object.fromEntries(
          formData.entries()
        );


      try {

        const response =
          await fetch(
            window.location.pathname +
            "/rsvp",
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json"
              },

              body:
                JSON.stringify(data)
            }
          );


        const result =
          await response.json();


        if (!response.ok) {
          throw new Error(
            result.message ||
            "Gagal mengirim RSVP."
          );
        }


        rsvpMessage.textContent =
          result.message;


        rsvpMessage.className =
          "rsvp-message success";


        rsvpForm.reset();


      } catch (error) {

        rsvpMessage.textContent =
          error.message;


        rsvpMessage.className =
          "rsvp-message error";

      } finally {

        submitButton.disabled =
          false;

        submitButton.textContent =
          "Kirim RSVP";

      }

    }
  );

}


/*
|--------------------------------------------------------------------------
| COPY ACCOUNT NUMBER
|--------------------------------------------------------------------------
*/

function copyText(text) {

  navigator.clipboard
    .writeText(text)
    .then(function () {

      alert(
        "Nomor berhasil disalin."
      );

    })
    .catch(function () {

      alert(
        "Gagal menyalin nomor."
      );

    });

}

</script>


</body>
</html>