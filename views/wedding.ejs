            <div class="form-group">
              <label class="form-label" for="rsvpMessage">Ucapan & Doa Restu</label>
              <textarea id="rsvpMessage" name="message" class="form-control" rows="4" maxlength="1000" placeholder="Tuliskan ucapan dan doa terbaik untuk kedua mempelai..."></textarea>
