          <!-- Physical Gift Address -->
          <% if (wedding.gift.address) { %>
            <div class="gift-card">
              <i class="fa-solid fa-box-open" style="font-size:32px;color:var(--accent);margin-bottom:12px;"></i>
              <h3 style="font-family:var(--font-serif);font-size:24px;margin-bottom:8px;">Kirim Kado Fisik</h3>
              <p class="account-name" style="margin-bottom:15px;"><%= wedding.gift.address %></p>
              <button type="button" class="btn-outline" onclick="copyToClipboard('<%= wedding.gift.address %>')">
                <i class="fa-regular fa-copy"></i>
