            </div>

            <div class="event-actions">
              <% if (event.mapsUrl) { %>
                <a class="btn-outline" href="<%= event.mapsUrl %>" target="_blank" rel="noopener">
                  <i class="fa-solid fa-map-location-dot"></i>
