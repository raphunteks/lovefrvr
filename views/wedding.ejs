<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="<%= wedding.theme?.background || '#FDFBF7' %>">
  <title><%= wedding.bride?.name || 'Bride' %> & <%= wedding.groom?.name || 'Groom' %> — The Wedding</title>
  <meta name="description" content="<%= wedding.opening?.text || 'Undangan Pernikahan Online Eksklusif' %>">

  <!-- Open Graph / Meta -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= wedding.bride?.name || '' %> & <%= wedding.groom?.name || '' %> Wedding Invitation">
  <meta property="og:description" content="<%= wedding.opening?.text || 'Kami mengundang Anda untuk hadir di hari bahagia kami.' %>">
  <% if (wedding.gallery && wedding.gallery[0]?.url) { %>
    <meta property="og:image" content="<%= wedding.gallery[0].url %>">
  <% } %>

  <!-- Google Fonts: Luxury Editorial Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    :root {
      --bg-main: <%= wedding.theme?.background || '#FDFBF7' %>;
      --text-main: <%= wedding.theme?.text || '#3A332E' %>;
      --accent: <%= wedding.theme?.accent || '#9A826B' %>;
      --accent-rgb: 154, 130, 107;
      --muted: <%= wedding.theme?.muted || '#7D746D' %>;
      --surface: #FFFFFF;
      
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: var(--font-sans);
      overflow-x: hidden;
      line-height: 1.6;
      text-align: center;
    }

    body.locked {
      overflow: hidden;
      height: 100vh;
    }

    .font-serif { font-family: var(--font-serif); }

    /* =========================================
       COVER / ENTRANCE OVERLAY
    ========================================= */
    .cover-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100svh;
      padding: 24px;
      background: var(--bg-main);
      transition: transform 1s cubic-bezier(0.77, 0, 0.175, 1), opacity 0.8s ease, visibility 0.8s ease;
    }

    .cover-overlay.opened {
      transform: translateY(-100%);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .cover-card {
      position: relative;
      width: min(100%, 500px);
      padding: 20px;
      z-index: 2;
      animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .badge-pill {
      display: inline-block;
      padding: 6px 18px;
      background-color: rgba(var(--accent-rgb), 0.08);
      color: var(--accent);
      border-radius: 50px;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      margin-bottom: 24px;
    }

    .cover-title {
      font-family: var(--font-serif);
      font-size: clamp(52px, 12vw, 84px);
      font-weight: 400;
      line-height: 1;
      color: var(--text-main);
      margin-bottom: 24px;
    }

    .cover-title span.name {
      display: block;
    }

    .cover-title span.amp {
      display: block;
      font-family: var(--font-serif);
      font-style: italic;
      font-size: 0.45em;
      color: var(--accent);
      margin: 8px 0;
    }

    .subtitle-text {
      font-size: 13px;
      color: var(--muted);
      max-width: 480px;
      margin: 0 auto 32px;
      line-height: 1.8;
    }

    .guest-box {
      background: var(--surface);
      border-radius: 16px;
      padding: 24px 20px;
      margin: 0 auto 35px;
      max-width: 400px;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.04);
      border: 1px solid rgba(0, 0, 0, 0.02);
    }

    .guest-box small {
      display: block;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 10px;
    }

    .guest-box strong {
      display: block;
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 600;
      color: var(--text-main);
    }

    .btn-primary {
      background-color: var(--accent);
      color: #FFFFFF;
      border: none;
      padding: 15px 36px;
      border-radius: 50px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 10px 25px rgba(var(--accent-rgb), 0.25);
      transition: all 0.3s ease;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(var(--accent-rgb), 0.35);
    }

    /* =========================================
       MAIN CONTENT STYLES
    ========================================= */
    .app-container {
      max-width: 800px;
      margin: 0 auto;
      min-height: 100vh;
      position: relative;
      padding: 0 20px 140px;
    }

    section {
      padding: 100px 0;
      position: relative;
    }

    .section-title {
      font-family: var(--font-serif);
      font-size: clamp(38px, 8vw, 56px);
      font-weight: 400;
      line-height: 1.1;
      color: var(--text-main);
      margin-bottom: 12px;
    }

    .divider {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
      margin: 24px 0;
      color: var(--accent);
      font-size: 10px;
    }

    .divider::before, .divider::after {
      content: "";
      width: 40px;
      height: 1px;
      background-color: var(--accent);
      opacity: 0.4;
    }

    /* =========================================
       COMPONENTS
    ========================================= */
    /* Hero Section */
    .hero-section {
      min-height: 80vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding-top: 80px;
    }

    .cover-img-wrapper {
      width: 100%;
      max-width: 400px;
      border-radius: 20px 20px 0 0;
      overflow: hidden;
      margin: 30px auto 0;
      box-shadow: 0 20px 50px rgba(0,0,0,0.05);
    }
    .cover-img-wrapper img {
      width: 100%;
      height: auto;
      object-fit: cover;
      display: block;
    }

    /* Cards */
    .card {
      background: var(--surface);
      border-radius: 24px;
      padding: 40px 30px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.03);
      border: 1px solid rgba(0,0,0,0.02);
      margin-bottom: 24px;
    }

    .quote-text {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: clamp(20px, 4vw, 26px);
      line-height: 1.6;
      color: var(--text-main);
      margin-bottom: 15px;
    }

    /* Couple */
    .couple-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-top: 40px;
    }
    
    .couple-item {
      padding: 30px 20px;
    }

    .couple-avatar {
      width: min(160px, 40vw);
      aspect-ratio: 1;
      margin: 0 auto 20px;
      border-radius: 50%;
      overflow: hidden;
      background: rgba(var(--accent-rgb), 0.05);
      border: 1px solid rgba(var(--accent-rgb), 0.2);
      padding: 5px;
    }

    .couple-avatar img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
    }

    .couple-name {
      font-family: var(--font-serif);
      font-size: 32px;
      font-weight: 500;
      color: var(--text-main);
      margin-bottom: 4px;
    }

    .couple-fullname {
      font-size: 13px;
      font-weight: 600;
      color: var(--accent);
      margin-bottom: 12px;
    }

    .couple-social {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 600;
      color: var(--accent);
      text-decoration: none;
      padding: 6px 14px;
      background: rgba(var(--accent-rgb), 0.05);
      border-radius: 50px;
      margin-top: 10px;
    }

    /* Countdown */
    .countdown-wrap {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-top: 30px;
    }

    .countdown-box {
      padding: 20px 10px;
    }

    .countdown-box strong {
      display: block;
      font-family: var(--font-serif);
      font-size: clamp(32px, 7vw, 44px);
      font-weight: 400;
      color: var(--text-main);
      line-height: 1;
    }

    .countdown-box span {
      display: block;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--muted);
      margin-top: 8px;
      font-weight: 600;
    }

    /* Events */
    .event-meta {
      margin: 20px 0;
    }
    .event-meta p {
      margin: 8px 0;
      font-size: 14px;
      color: var(--muted);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }
    .event-meta i {
      color: var(--accent);
    }
    .btn-outline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 24px;
      border: 1px solid var(--accent);
      color: var(--accent);
      background: transparent;
      border-radius: 50px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.3s ease;
      margin-top: 10px;
    }

    /* Story */
    .story-item {
      text-align: left;
      padding-left: 20px;
      border-left: 1px solid rgba(var(--accent-rgb), 0.3);
      position: relative;
      margin-bottom: 30px;
    }
    .story-item::before {
      content: "";
      position: absolute;
      left: -5px;
      top: 5px;
      width: 9px;
      height: 9px;
      background: var(--accent);
      border-radius: 50%;
    }
    .story-date {
      font-size: 11px;
      font-weight: 700;
      color: var(--accent);
      letter-spacing: 0.15em;
    }
    .story-title {
      font-family: var(--font-serif);
      font-size: 24px;
      margin: 4px 0 8px;
    }

    /* Gallery */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 30px;
    }
    .gallery-item {
      aspect-ratio: 1;
      border-radius: 12px;
      overflow: hidden;
      cursor: pointer;
    }
    .gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* RSVP Form */
    .form-group {
      margin-bottom: 20px;
      text-align: left;
    }
    .form-group label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-main);
      margin-bottom: 8px;
    }
    .form-control {
      width: 100%;
      padding: 15px;
      border: 1px solid rgba(0,0,0,0.1);
      border-radius: 12px;
      background: #FAFAFA;
      font-family: inherit;
      font-size: 14px;
      outline: none;
    }
    .form-control:focus {
      border-color: var(--accent);
      background: #FFFFFF;
    }
    .btn-submit {
      width: 100%;
      padding: 16px;
      background: var(--text-main);
      color: #FFF;
      border: none;
      border-radius: 50px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      margin-top: 10px;
    }

    /* Floating Navigation */
    .bottom-nav {
      position: fixed;
      left: 50%;
      bottom: max(20px, env(safe-area-inset-bottom));
      transform: translateX(-50%);
      width: min(calc(100% - 32px), 500px);
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(0,0,0,0.05);
      border-radius: 50px;
      padding: 8px 12px;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      z-index: 900;
      backdrop-filter: blur(15px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
    }
    .nav-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      color: var(--muted);
      text-decoration: none;
      padding: 8px 0;
      border-radius: 50px;
      font-size: 9px;
      font-weight: 600;
      gap: 4px;
      transition: all 0.3s ease;
    }
    .nav-link i { font-size: 16px; }
    .nav-link.active {
      color: var(--accent);
      background: rgba(var(--accent-rgb), 0.1);
    }

    /* Music Toggle */
    .music-btn {
      position: fixed;
      top: 20px;
      right: 20px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(0,0,0,0.05);
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 990;
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }
    .music-btn.playing i { animation: spinSlow 5s linear infinite; }

    /* Utilities */
    .toast-box {
      position: fixed; bottom: 100px; left: 50%; transform: translateX(-50%) translateY(20px);
      background: var(--text-main); color: #FFF; padding: 12px 24px; border-radius: 50px; font-size: 12px;
      z-index: 99999; opacity: 0; visibility: hidden; transition: all 0.3s;
    }
    .toast-box.show { transform: translateX(-50%) translateY(0); opacity: 1; visibility: visible; }
    .lightbox-modal { position: fixed; inset: 0; z-index: 100000; background: rgba(0,0,0,0.9); display: none; align-items: center; justify-content: center; padding: 20px; }
    .lightbox-modal.active { display: flex; }
    .lightbox-modal img { max-width: 100%; max-height: 90vh; border-radius: 12px; }
    .lightbox-close { position: absolute; top: 20px; right: 20px; background: none; border: none; color: #FFF; font-size: 30px; cursor: pointer; }

    @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes spinSlow { to { transform: rotate(360deg); } }
    .reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease, transform 0.8s ease; }
    .reveal.active { opacity: 1; transform: translateY(0); }

    @media (max-width: 600px) {
      .couple-grid { grid-template-columns: 1fr; gap: 0; }
      .gallery-grid { grid-template-columns: repeat(2, 1fr); }
      .bottom-nav { width: calc(100% - 20px); }
    }
  </style>
</head>
<body class="locked">

  <!-- Cover Overlay -->
  <div id="coverOverlay" class="cover-overlay">
    <div class="cover-card">
      <div class="badge-pill"><%= wedding.title || 'THE WEDDING OF' %></div>
      <h1 class="cover-title">
        <span class="name"><%= wedding.groom?.name || 'Groom' %></span>
        <span class="amp">&</span>
        <span class="name"><%= wedding.bride?.name || 'Bride' %></span>
      </h1>
      <p class="subtitle-text"><%= wedding.opening?.text || 'Merupakan suatu kehormatan dan kebahagiaan bagi kami sekeluarga apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu pada hari pernikahan kami.' %></p>
      
      <div class="guest-box">
        <small>Kepada Yth. Bapak/Ibu/Saudara/i:</small>
        <strong><%= guestName || 'Tamu Undangan' %></strong>
      </div>

      <button id="btnOpenInvitation" class="btn-primary" type="button">
        <i class="fa-regular fa-envelope-open"></i>
        <span><%= wedding.opening?.button || 'BUKA UNDANGAN' %></span>
      </button>
    </div>
  </div>

  <% if (wedding.music && wedding.music.url) { %>
    <audio id="audioPlayer" preload="auto" loop><source src="<%= wedding.music.url %>" type="audio/mpeg"></audio>
    <button id="btnMusicToggle" class="music-btn" type="button"><i class="fa-solid fa-compact-disc"></i></button>
  <% } %>

  <div class="app-container">
    
    <!-- Hero Section -->
    <section id="home" class="hero-section reveal">
      <div class="badge-pill"><%= wedding.opening?.eyebrow || "ASSALAMU'ALAIKUM WARAHMATULLAHI WABARAKATUH" %></div>
      <h2 class="section-title"><%= wedding.opening?.title || "The Wedding Of" %></h2>
      <div class="divider">✦</div>
      <p class="subtitle-text" style="max-width: 600px;"><%= wedding.opening?.text %></p>

      <% if (wedding.coverImage?.url) { %>
        <div class="cover-img-wrapper">
          <img src="<%= wedding.coverImage.url %>" alt="Cover Image">
        </div>
      <% } %>
    </section>

    <!-- Quote -->
    <% if (wedding.quote && wedding.quote.text) { %>
      <section id="quote" class="reveal" style="padding: 40px 0;">
        <div class="card" style="background: transparent; border: none; box-shadow: none;">
          <p class="quote-text">"<%= wedding.quote.text %>"</p>
          <div class="badge-pill" style="margin-top: 15px;"><%= wedding.quote.source || 'QS. Ar-Rum: 21' %></div>
        </div>
      </section>
    <% } %>

    <!-- Couple -->
    <section id="couple" class="reveal">
      <div class="badge-pill">THE HAPPY COUPLE</div>
      <h2 class="section-title">Mempelai</h2>
      <div class="divider">✦</div>

      <div class="couple-grid">
        <div class="card couple-item">
          <div class="couple-avatar">
            <% if (wedding.groom?.photo?.url) { %>
              <img src="<%= wedding.groom.photo.url %>" alt="<%= wedding.groom.name %>" loading="lazy">
            <% } else { %>
              <div style="display:grid;place-items:center;height:100%;font-size:40px;color:var(--accent);font-family:var(--font-serif)"><%= wedding.groom?.name?.charAt(0) || 'G' %></div>
            <% } %>
          </div>
          <h3 class="couple-name"><%= wedding.groom?.name || 'Groom' %></h3>
          <p class="couple-fullname"><%= wedding.groom?.fullName || '' %></p>
          <% if (wedding.groom?.parents) { %>
            <p class="subtitle-text" style="font-size: 12px; margin-bottom: 10px;">Putra dari Pasangan:<br><%= wedding.groom.parents %></p>
          <% } %>
          <% if (wedding.groom?.instagram) { %>
            <a href="https://instagram.com/<%= wedding.groom.instagram.replace('@', '') %>" target="_blank" class="couple-social"><i class="fa-brands fa-instagram"></i> @<%= wedding.groom.instagram.replace('@', '') %></a>
          <% } %>
        </div>

        <div class="card couple-item">
          <div class="couple-avatar">
            <% if (wedding.bride?.photo?.url) { %>
              <img src="<%= wedding.bride.photo.url %>" alt="<%= wedding.bride.name %>" loading="lazy">
            <% } else { %>
              <div style="display:grid;place-items:center;height:100%;font-size:40px;color:var(--accent);font-family:var(--font-serif)"><%= wedding.bride?.name?.charAt(0) || 'B' %></div>
            <% } %>
          </div>
          <h3 class="couple-name"><%= wedding.bride?.name || 'Bride' %></h3>
          <p class="couple-fullname"><%= wedding.bride?.fullName || '' %></p>
          <% if (wedding.bride?.parents) { %>
            <p class="subtitle-text" style="font-size: 12px; margin-bottom: 10px;">Putri dari Pasangan:<br><%= wedding.bride.parents %></p>
          <% } %>
          <% if (wedding.bride?.instagram) { %>
            <a href="https://instagram.com/<%= wedding.bride.instagram.replace('@', '') %>" target="_blank" class="couple-social"><i class="fa-brands fa-instagram"></i> @<%= wedding.bride.instagram.replace('@', '') %></a>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Countdown -->
    <% if (wedding.settings?.showCountdown !== false && wedding.date) { %>
      <section id="countdownSection" class="reveal">
        <div class="card">
          <div class="badge-pill">SAVE THE DATE</div>
          <h2 class="section-title" style="font-size: 32px;">Menghitung Hari</h2>
          <div class="countdown-wrap">
            <div class="countdown-box"><strong id="countDays">00</strong><span>Hari</span></div>
            <div class="countdown-box"><strong id="countHours">00</strong><span>Jam</span></div>
            <div class="countdown-box"><strong id="countMinutes">00</strong><span>Menit</span></div>
            <div class="countdown-box"><strong id="countSeconds">00</strong><span>Detik</span></div>
          </div>
        </div>
      </section>
    <% } %>

    <!-- Events -->
    <section id="event" class="reveal">
      <div class="badge-pill">WEDDING AGENDA</div>
      <h2 class="section-title">Rangkaian Acara</h2>
      <div class="divider">✦</div>

      <div class="events-grid">
        <% (wedding.events || []).forEach(function(event) { %>
          <div class="card" style="padding: 40px 20px;">
            <h3 class="cover-title" style="font-size: 32px; margin-bottom: 10px;"><%= event.title %></h3>
            <div class="event-meta">
              <% if (event.date) { %><p><i class="fa-regular fa-calendar"></i> <%= event.date %></p><% } %>
              <% if (event.time) { %><p><i class="fa-regular fa-clock"></i> <%= event.time %></p><% } %>
              <% if (event.venue) { %><p style="margin-top: 20px; font-weight: 600; color: var(--text-main);"><%= event.venue %></p><% } %>
              <% if (event.address) { %><p style="font-size: 12px;"><%= event.address %></p><% } %>
            </div>
            <% if (event.mapsUrl) { %>
              <a href="<%= event.mapsUrl %>" target="_blank" class="btn-outline"><i class="fa-solid fa-map-pin"></i> Petunjuk Lokasi</a>
            <% } %>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- Story -->
    <% if (wedding.settings?.showStory !== false && wedding.story && wedding.story.length) { %>
      <section id="story" class="reveal">
        <div class="badge-pill">OUR JOURNEY</div>
        <h2 class="section-title">Kisah Kami</h2>
        <div class="divider">✦</div>
        <div class="timeline card" style="text-align: left; padding: 40px 30px;">
          <% wedding.story.forEach(function(item) { %>
            <div class="story-item">
              <div class="story-date"><%= item.year || item.date %></div>
              <h3 class="story-title"><%= item.title %></h3>
              <p class="subtitle-text" style="margin:0; text-align: left;"><%= item.text || item.description %></p>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

    <!-- Gallery -->
    <% if (wedding.settings?.showGallery !== false && wedding.gallery && wedding.gallery.length) { %>
      <section id="gallery" class="reveal">
        <div class="badge-pill">OUR MEMORIES</div>
        <h2 class="section-title">Galeri Foto</h2>
        <div class="divider">✦</div>
        <div class="gallery-grid">
          <% wedding.gallery.forEach(function(item) { %>
            <% const imgUrl = (typeof item === 'string') ? item : item.url; %>
            <% if (imgUrl) { %>
              <div class="gallery-item" onclick="openLightbox('<%= imgUrl %>')">
                <img src="<%= imgUrl %>" alt="Gallery" loading="lazy">
              </div>
            <% } %>
          <% }) %>
        </div>
      </section>
    <% } %>

    <!-- Gift -->
    <% if (wedding.settings?.showGift !== false && wedding.gift) { %>
      <section id="gift" class="reveal">
        <div class="badge-pill">WEDDING GIFT</div>
        <h2 class="section-title">Tanda Kasih</h2>
        <div class="divider">✦</div>
        <p class="subtitle-text"><%= wedding.gift.text || 'Doa restu Anda merupakan karunia terindah.' %></p>
        
        <div class="gift-container">
          <% if (wedding.gift.bankName && wedding.gift.accountNumber) { %>
            <div class="card">
              <div class="badge-pill" style="margin-bottom: 15px;"><%= wedding.gift.bankName %></div>
              <div style="font-family: monospace; font-size: 24px; font-weight: 600; margin-bottom: 5px;"><%= wedding.gift.accountNumber %></div>
              <div class="subtitle-text" style="margin-bottom: 20px;">a.n. <%= wedding.gift.accountName %></div>
              <button type="button" class="btn-outline" onclick="copyToClipboard('<%= wedding.gift.accountNumber %>')">Salin Rekening</button>
            </div>
          <% } %>
          <% if (wedding.gift.address) { %>
            <div class="card">
              <h3 style="font-family: var(--font-serif); font-size: 24px; margin-bottom: 10px;">Kirim Kado Fisik</h3>
              <p class="subtitle-text" style="margin-bottom: 20px;"><%= wedding.gift.address %></p>
              <button type="button" class="btn-outline" onclick="copyToClipboard('<%= wedding.gift.address %>')">Salin Alamat</button>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>

    <!-- RSVP -->
    <% if (wedding.settings?.showRSVP !== false) { %>
      <section id="rsvp" class="reveal">
        <div class="badge-pill">RSVP</div>
        <h2 class="section-title">Konfirmasi Kehadiran</h2>
        <div class="divider">✦</div>
        
        <div class="card" style="max-width: 500px; margin: 0 auto;">
          <form id="rsvpForm">
            <div class="form-group">
              <label>Nama Lengkap</label>
              <input type="text" name="name" class="form-control" value="<%= guestName || '' %>" required>
            </div>
            <div class="form-group">
              <label>Kehadiran</label>
              <select name="attendance" class="form-control" required>
                <option value="">-- Pilih --</option>
                <option value="hadir">Hadir</option>
                <option value="tidak_hadir">Tidak Hadir</option>
                <option value="ragu">Masih Ragu</option>
              </select>
            </div>
            <div class="form-group">
              <label>Jumlah Tamu</label>
              <input type="number" name="guestCount" class="form-control" min="1" max="10" value="1" required>
            </div>
            <div class="form-group">
              <label>Ucapan & Doa</label>
              <textarea name="message" class="form-control" rows="3" required></textarea>
            </div>
            <button type="submit" id="btnSubmitRSVP" class="btn-primary" style="width: 100%; justify-content: center; margin-top: 10px;">Kirim Konfirmasi</button>
            <div id="rsvpStatusAlert" style="margin-top: 15px; font-size: 12px; font-weight: 600;"></div>
          </form>
        </div>
      </section>
    <% } %>

    <section id="closing" class="reveal" style="padding-bottom: 50px;">
      <div class="badge-pill">WITH LOVE</div>
      <h2 class="cover-title" style="margin: 30px 0;">
        <span class="name"><%= wedding.groom?.name || '' %></span>
        <span class="amp">&</span>
        <span class="name"><%= wedding.bride?.name || '' %></span>
      </h2>
      <p class="subtitle-text">Terima kasih atas doa dan restu yang diberikan.</p>
    </section>

  </div>

  <% if (wedding.settings?.bottomNavigation !== false) { %>
    <nav class="bottom-nav">
      <a href="#home" class="nav-link active"><i class="fa-solid fa-house"></i><span>Home</span></a>
      <a href="#couple" class="nav-link"><i class="fa-regular fa-heart"></i><span>Couple</span></a>
      <a href="#event" class="nav-link"><i class="fa-regular fa-calendar"></i><span>Event</span></a>
      <a href="#gallery" class="nav-link"><i class="fa-regular fa-image"></i><span>Gallery</span></a>
      <a href="#gift" class="nav-link"><i class="fa-solid fa-gift"></i><span>Gift</span></a>
      <a href="#rsvp" class="nav-link"><i class="fa-regular fa-envelope"></i><span>RSVP</span></a>
    </nav>
  <% } %>

  <div id="toastBox" class="toast-box">Disalin!</div>

  <div id="lightboxModal" class="lightbox-modal" onclick="closeLightbox()">
    <button type="button" class="lightbox-close" onclick="closeLightbox()">&times;</button>
    <img id="lightboxImg" src="" alt="Zoom" onclick="event.stopPropagation()">
  </div>

  <script>
    const targetDate = "<%= wedding.date %>" ? new Date("<%= wedding.date %>") : null;
    const coverOverlay = document.getElementById("coverOverlay");
    const btnOpen = document.getElementById("btnOpenInvitation");
    const audio = document.getElementById("audioPlayer");
    const btnMusic = document.getElementById("btnMusicToggle");

    btnOpen.addEventListener("click", () => {
      coverOverlay.classList.add("opened");
      document.body.classList.remove("locked");
      if (audio) {
        audio.volume = 0.5;
        audio.play().then(() => btnMusic?.classList.add("playing")).catch(()=>{});
      }
      setTimeout(() => document.getElementById("home")?.scrollIntoView({ behavior: "smooth" }), 500);
    });

    if (audio && btnMusic) {
      btnMusic.addEventListener("click", () => {
        if (audio.paused) { audio.play(); btnMusic.classList.add("playing"); }
        else { audio.pause(); btnMusic.classList.remove("playing"); }
      });
    }

    if (targetDate) {
      function updateCD() {
        const diff = targetDate.getTime() - new Date().getTime();
        if (diff <= 0) return;
        document.getElementById("countDays").textContent = String(Math.floor(diff / (1000 * 60 * 60 * 24))).padStart(2,"0");
        document.getElementById("countHours").textContent = String(Math.floor((diff / (1000 * 60 * 60)) % 24)).padStart(2,"0");
        document.getElementById("countMinutes").textContent = String(Math.floor((diff / 1000 / 60) % 60)).padStart(2,"0");
        document.getElementById("countSeconds").textContent = String(Math.floor((diff / 1000) % 60)).padStart(2,"0");
      }
      updateCD(); setInterval(updateCD, 1000);
    }

    const reveals = document.querySelectorAll(".reveal");
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add("active"); });
    }, { threshold: 0.15 });
    reveals.forEach(el => obs.observe(el));

    const navLinks = document.querySelectorAll(".bottom-nav .nav-link");
    const navObs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          navLinks.forEach(l => {
            l.classList.remove("active");
            if (l.getAttribute("href") === `#${e.target.id}`) l.classList.add("active");
          });
        }
      });
    }, { threshold: 0.4 });
    document.querySelectorAll("section").forEach(s => navObs.observe(s));

    function copyToClipboard(text) {
      navigator.clipboard.writeText(text).then(() => {
        const t = document.getElementById("toastBox");
        t.classList.add("show");
        setTimeout(() => t.classList.remove("show"), 2500);
      });
    }

    function openLightbox(src) {
      document.getElementById("lightboxImg").src = src;
      document.getElementById("lightboxModal").classList.add("active");
    }
    function closeLightbox() { document.getElementById("lightboxModal").classList.remove("active"); }

    const rsvpForm = document.getElementById("rsvpForm");
    if (rsvpForm) {
      rsvpForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitRSVP");
        const alertBox = document.getElementById("rsvpStatusAlert");
        btn.innerHTML = 'Mengirim...'; btn.disabled = true;
        try {
          const payload = Object.fromEntries(new FormData(rsvpForm).entries());
          const res = await fetch(`/api/weddings/<%= encodeURIComponent(wedding.slug) %>/rsvp`, {
            method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.message);
          alertBox.textContent = "RSVP Berhasil Terkirim!";
          alertBox.style.color = "var(--success)";
          rsvpForm.reset();
        } catch (err) {
          alertBox.textContent = err.message;
          alertBox.style.color = "var(--danger)";
        } finally {
          btn.innerHTML = 'Kirim Konfirmasi'; btn.disabled = false;
        }
      });
    }
  </script>
</body>
</html>
