<!DOCTYPE html>
<html lang="id">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <% if (notFound) { %>

    <title>
      Undangan Tidak Ditemukan — LOVEFOREVER
    </title>

  <% } else { %>

    <title>
      <%= wedding.bride?.name || "" %>
      &
      <%= wedding.groom?.name || "" %>
      — LOVEFOREVER
    </title>

    <meta
      name="description"
      content="<%= wedding.description || 'Wedding Invitation' %>"
    >

  <% } %>


  <link
    rel="stylesheet"
    href="/css/style.css"
  >


  <style>

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: #f8f5f1;
      color: #292522;
      font-family:
        Georgia,
        "Times New Roman",
        serif;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    .wedding-page {
      min-height: 100vh;
      overflow: hidden;
    }

    .section {
      width: min(1000px, 100%);
      margin: auto;
      padding: 90px 20px;
    }

    .center {
      text-align: center;
    }

    .eyebrow {
      font-size: 11px;
      letter-spacing: 4px;
      text-transform: uppercase;
      opacity: .6;
    }

    .hero {
      min-height: 100svh;
      position: relative;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 30px;
      text-align: center;
      color: white;
      background:
        linear-gradient(
          rgba(0,0,0,.25),
          rgba(0,0,0,.55)
        );
      background-size: cover;
      background-position: center;
    }

    .hero-content {
      width: min(800px, 100%);
      padding: 50px 10px;
      animation:
        fadeUp 1.2s ease;
    }

    .hero-title {
      font-size:
        clamp(
          45px,
          10vw,
          100px
        );
      line-height: .95;
      margin: 20px 0;
      font-weight: 400;
    }

    .hero-subtitle {
      font-size: 18px;
      opacity: .9;
    }

    .guest-box {
      margin: 30px auto 0;
      padding: 18px;
      width: min(480px, 100%);
      border-top: 1px solid rgba(255,255,255,.4);
      border-bottom: 1px solid rgba(255,255,255,.4);
    }

    .guest-name {
      display: block;
      font-size: 24px;
      margin-top: 8px;
    }

    .opening {
      padding: 80px 20px;
      text-align: center;
    }

    .couple-grid {
      display: grid;
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
      gap: 35px;
      align-items: center;
    }

    .person {
      text-align: center;
    }

    .person-photo {
      width: min(300px, 80vw);
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 50%;
      display: block;
      margin: 0 auto 20px;
      box-shadow:
        0 15px 45px
        rgba(0,0,0,.12);
    }

    .person-placeholder {
      width: min(300px, 80vw);
      aspect-ratio: 1;
      border-radius: 50%;
      background: #e7ded5;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 70px;
      margin: 0 auto 20px;
    }

    .person h3 {
      font-size: 34px;
      font-weight: 400;
      margin: 10px 0;
    }

    .quote {
      max-width: 700px;
      margin: auto;
      text-align: center;
      font-size: clamp(24px, 4vw, 38px);
      line-height: 1.5;
      font-style: italic;
    }

    .countdown {
      display: grid;
      grid-template-columns:
        repeat(
          4,
          1fr
        );
      gap: 10px;
      width: min(650px, 100%);
      margin: 35px auto 0;
    }

    .count-box {
      background: white;
      padding: 20px 10px;
      border-radius: 15px;
      box-shadow:
        0 10px 35px
        rgba(0,0,0,.05);
    }

    .count-number {
      display: block;
      font-size: 30px;
    }

    .count-label {
      display: block;
      font-size: 11px;
      letter-spacing: 2px;
      opacity: .6;
      margin-top: 5px;
    }

    .timeline {
      max-width: 750px;
      margin: auto;
    }

    .timeline-item {
      position: relative;
      padding: 0 0 40px 30px;
      border-left: 1px solid #cfc4bb;
      margin-left: 15px;
    }

    .timeline-item:last-child {
      border-left: 0;
    }

    .timeline-dot {
      position: absolute;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #6d5a4c;
      left: -6px;
      top: 5px;
    }

    .timeline-date {
      font-size: 12px;
      letter-spacing: 2px;
      opacity: .6;
      text-transform: uppercase;
    }

    .timeline-title {
      font-size: 25px;
      margin: 8px 0;
    }

    .events-grid {
      display: grid;
      grid-template-columns:
        repeat(
          auto-fit,
          minmax(280px, 1fr)
        );
      gap: 20px;
    }

    .event-card {
      background: white;
      border-radius: 18px;
      padding: 25px;
      box-shadow:
        0 10px 35px
        rgba(0,0,0,.05);
    }

    .event-card h3 {
      font-size: 28px;
      font-weight: 400;
      margin-top: 5px;
    }

    .event-line {
      line-height: 1.7;
      margin: 6px 0;
    }

    .maps-button {
      display: inline-flex;
      margin-top: 15px;
      padding: 10px 15px;
      border-radius: 999px;
      border: 1px solid #6d5a4c;
      color: inherit;
      text-decoration: none;
    }

    .gallery {
      display: grid;
      grid-template-columns:
        repeat(
          2,
          1fr
        );
      gap: 10px;
    }

    .gallery img {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 12px;
      cursor: pointer;
      transition:
        transform .3s ease;
    }

    .gallery img:hover {
      transform: scale(1.02);
    }

    .gift-grid {
      display: grid;
      grid-template-columns:
        repeat(
          auto-fit,
          minmax(260px, 1fr)
        );
      gap: 20px;
    }

    .gift-card {
      background: white;
      border-radius: 18px;
      padding: 25px;
      text-align: center;
    }

    .account-number {
      font-size: 22px;
      letter-spacing: 1px;
      margin: 15px 0;
    }

    .copy-button {
      border: 0;
      background: #292522;
      color: white;
      padding: 10px 15px;
      border-radius: 999px;
      cursor: pointer;
    }

    .rsvp-card {
      width: min(600px, 100%);
      margin: auto;
      background: white;
      padding: 30px;
      border-radius: 20px;
      box-shadow:
        0 15px 45px
        rgba(0,0,0,.06);
    }

    .form-group {
      margin-bottom: 15px;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%;
      border: 1px solid #ddd2c8;
      border-radius: 10px;
      padding: 12px;
      background: white;
    }

    .form-group textarea {
      min-height: 120px;
      resize: vertical;
    }

    .submit-button {
      width: 100%;
      border: 0;
      background: #292522;
      color: white;
      padding: 14px;
      border-radius: 999px;
      cursor: pointer;
    }

    .rsvp-message {
      margin-top: 15px;
      padding: 12px;
      border-radius: 10px;
      display: none;
    }

    .rsvp-message.show {
      display: block;
    }

    .music-button {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 100;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 1px solid rgba(0,0,0,.1);
      background: white;
      cursor: pointer;
      box-shadow:
        0 10px 30px
        rgba(0,0,0,.15);
    }

    .closing {
      min-height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .closing h2 {
      font-size:
        clamp(
          40px,
          8vw,
          80px
        );
      font-weight: 400;
    }

    .not-found {
      min-height: 100svh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 30px;
    }

    .not-found a {
      display: inline-block;
      margin-top: 20px;
    }

    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(0,0,0,.92);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .lightbox.open {
      display: flex;
    }

    .lightbox img {
      max-width: 95vw;
      max-height: 90vh;
      object-fit: contain;
    }

    .lightbox-close {
      position: absolute;
      top: 20px;
      right: 20px;
      color: white;
      background: transparent;
      border: 0;
      font-size: 30px;
      cursor: pointer;
    }

    @keyframes fadeUp {

      from {
        opacity: 0;
        transform:
          translateY(30px);
      }

      to {
        opacity: 1;
        transform:
          translateY(0);
      }

    }

    @media (max-width: 700px) {

      .couple-grid {
        grid-template-columns: 1fr;
      }

      .countdown {
        grid-template-columns:
          repeat(
            2,
            1fr
          );
      }

      .section {
        padding: 70px 18px;
      }

    }

  </style>

</head>


<body>


<% if (notFound) { %>


  <main class="not-found">

    <div>

      <p class="eyebrow">
        LOVEFOREVER
      </p>

      <h1>
        Undangan Tidak Ditemukan
      </h1>

      <p>
        Link wedding invitation yang Anda buka
        tidak tersedia atau belum dipublish.
      </p>

      <a href="/">
        ← Kembali ke LOVEFOREVER
      </a>

    </div>

  </main>


<% } else { %>


<div class="wedding-page">


  <!-- =====================================================
       HERO
  ====================================================== -->

  <section
    class="hero"
    <% if (
      wedding.coverImage &&
      wedding.coverImage.data
    ) { %>

      style="background-image:
        linear-gradient(
          rgba(0,0,0,.25),
          rgba(0,0,0,.55)
        ),
        url('<%= wedding.coverImage.data %>')"

    <% } %>
  >

    <div class="hero-content">

      <p class="eyebrow">
        The Wedding Of
      </p>

      <h1 class="hero-title">

        <%= wedding.bride?.name || "" %>

        <br>

        &

        <br>

        <%= wedding.groom?.name || "" %>

      </h1>


      <% if (wedding.date) { %>

        <p class="hero-subtitle">
          <%= wedding.date %>
        </p>

      <% } %>


      <% if (guestName) { %>

        <div class="guest-box">

          <span>
            Kepada Yth.
          </span>

          <strong class="guest-name">
            <%= guestName %>
          </strong>

        </div>

      <% } %>

    </div>

  </section>


  <!-- =====================================================
       OPENING
  ====================================================== -->

  <section class="opening">

    <p class="eyebrow">
      Assalamu'alaikum Warahmatullahi Wabarakatuh
    </p>

    <h2>
      Dengan penuh kebahagiaan,
    </h2>

    <p style="max-width:650px;margin:auto;line-height:2">

      Kami mengundang Bapak/Ibu/Saudara/i
      untuk hadir dan memberikan doa restu
      pada hari bahagia kami.

    </p>

  </section>


  <!-- =====================================================
       COUPLE
  ====================================================== -->

  <section class="section">

    <div class="center">

      <p class="eyebrow">
        The Couple
      </p>

      <h2>
        Mempelai
      </h2>

    </div>


    <div class="couple-grid">


      <article class="person">

        <% if (
          wedding.bride?.photo &&
          wedding.bride.photo.data
        ) { %>

          <img
            class="person-photo"
            src="<%= wedding.bride.photo.data %>"
            alt="<%= wedding.bride.name %>"
            loading="lazy"
          >

        <% } else { %>

          <div class="person-placeholder">
            ♡
          </div>

        <% } %>


        <p class="eyebrow">
          Bride
        </p>

        <h3>
          <%= wedding.bride?.name || "" %>
        </h3>

        <p>
          <%= wedding.bride?.fullName || "" %>
        </p>

      </article>


      <article class="person">

        <% if (
          wedding.groom?.photo &&
          wedding.groom.photo.data
        ) { %>

          <img
            class="person-photo"
            src="<%= wedding.groom.photo.data %>"
            alt="<%= wedding.groom.name %>"
            loading="lazy"
          >

        <% } else { %>

          <div class="person-placeholder">
            ♡
          </div>

        <% } %>


        <p class="eyebrow">
          Groom
        </p>

        <h3>
          <%= wedding.groom?.name || "" %>
        </h3>

        <p>
          <%= wedding.groom?.fullName || "" %>
        </p>

      </article>


    </div>

  </section>


  <!-- =====================================================
       QUOTE
  ====================================================== -->

  <% if (wedding.quote) { %>

    <section class="section">

      <blockquote class="quote">

        “<%= wedding.quote %>”

      </blockquote>

    </section>

  <% } %>


  <!-- =====================================================
       COUNTDOWN
  ====================================================== -->

  <% if (wedding.date) { %>

    <section class="section center">

      <p class="eyebrow">
        Counting Down
      </p>

      <h2>
        Menuju Hari Bahagia
      </h2>


      <div
        class="countdown"
        id="countdown"
        data-date="<%= wedding.date %>"
      >

        <div class="count-box">

          <span
            id="days"
            class="count-number"
          >
            0
          </span>

          <span class="count-label">
            HARI
          </span>

        </div>


        <div class="count-box">

          <span
            id="hours"
            class="count-number"
          >
            0
          </span>

          <span class="count-label">
            JAM
          </span>

        </div>


        <div class="count-box">

          <span
            id="minutes"
            class="count-number"
          >
            0
          </span>

          <span class="count-label">
            MENIT
          </span>

        </div>


        <div class="count-box">

          <span
            id="seconds"
            class="count-number"
          >
            0
          </span>

          <span class="count-label">
            DETIK
          </span>

        </div>

      </div>

    </section>

  <% } %>


  <!-- =====================================================
       STORY
  ====================================================== -->

  <% if (
    wedding.story &&
    wedding.story.length
  ) { %>

    <section class="section">

      <div class="center">

        <p class="eyebrow">
          Our Journey
        </p>

        <h2>
          Kisah Kami
        </h2>

      </div>


      <div class="timeline">

        <% wedding.story.forEach(function(item) { %>

          <article
            class="timeline-item"
          >

            <span class="timeline-dot">
            </span>

            <div class="timeline-date">
              <%= item.date || "" %>
            </div>

            <div class="timeline-title">
              <%= item.title || "" %>
            </div>

            <p style="line-height:1.8">
              <%= item.description || "" %>
            </p>

            <% if (
              item.photo &&
              item.photo.data
            ) { %>

              <img
                src="<%= item.photo.data %>"
                alt="<%= item.title || 'Story' %>"
                loading="lazy"
                style="
                  width:100%;
                  max-width:400px;
                  border-radius:15px;
                  margin-top:10px;
                "
              >

            <% } %>

          </article>

        <% }); %>

      </div>

    </section>

  <% } %>


  <!-- =====================================================
       EVENTS
  ====================================================== -->

  <% if (
    wedding.events &&
    wedding.events.length
  ) { %>

    <section class="section">

      <div class="center">

        <p class="eyebrow">
          Save The Date
        </p>

        <h2>
          Detail Acara
        </h2>

      </div>


      <div class="events-grid">

        <% wedding.events.forEach(function(event) { %>

          <article class="event-card">

            <p class="eyebrow">
              <%= event.type || "Event" %>
            </p>

            <h3>
              <%= event.title || "" %>
            </h3>


            <% if (event.date) { %>

              <p class="event-line">
                📅
                <strong>
                  <%= event.date %>
                </strong>
              </p>

            <% } %>


            <% if (
              event.startTime ||
              event.endTime
            ) { %>

              <p class="event-line">

                🕐

                <%= event.startTime || "" %>

                <% if (event.endTime) { %>

                  -
                  <%= event.endTime %>

                <% } %>

              </p>

            <% } %>


            <% if (event.venue) { %>

              <p class="event-line">
                📍
                <strong>
                  <%= event.venue %>
                </strong>
              </p>

            <% } %>


            <% if (event.address) { %>

              <p class="event-line">
                <%= event.address %>
              </p>

            <% } %>


            <% if (event.description) { %>

              <p
                class="event-line"
                style="opacity:.7"
              >
                <%= event.description %>
              </p>

            <% } %>


            <% if (event.mapsUrl) { %>

              <a
                class="maps-button"
                href="<%= event.mapsUrl %>"
                target="_blank"
                rel="noopener noreferrer"
              >
                Buka Google Maps
              </a>

            <% } %>

          </article>

        <% }); %>

      </div>

    </section>

  <% } %>


  <!-- =====================================================
       GALLERY
  ====================================================== -->

  <% if (
    wedding.gallery &&
    wedding.gallery.length
  ) { %>

    <section class="section">

      <div class="center">

        <p class="eyebrow">
          Memories
        </p>

        <h2>
          Gallery
        </h2>

      </div>


      <div class="gallery">

        <% wedding.gallery.forEach(function(image, index) { %>

          <% if (image && image.data) { %>

            <img
              src="<%= image.data %>"
              alt="<%= image.caption || 'Wedding Gallery ' + (index + 1) %>"
              loading="lazy"
              onclick="openLightbox(this.src)"
            >

          <% } %>

        <% }); %>

      </div>

    </section>

  <% } %>


  <!-- =====================================================
       GIFT
  ====================================================== -->

  <% if (
    wedding.gift &&
    wedding.gift.length
  ) { %>

    <section class="section">

      <div class="center">

        <p class="eyebrow">
          Wedding Gift
        </p>

        <h2>
          Tanda Kasih
        </h2>

        <p style="opacity:.7">
          Doa dan kehadiran Anda merupakan
          hadiah terindah bagi kami.
        </p>

      </div>


      <div class="gift-grid">

        <% wedding.gift.forEach(function(gift) { %>

          <article class="gift-card">

            <p class="eyebrow">
              <%= gift.type || "Gift" %>
            </p>


            <% if (gift.bank) { %>

              <h3>
                <%= gift.bank %>
              </h3>

            <% } %>


            <% if (gift.accountName) { %>

              <p>
                a.n.
                <strong>
                  <%= gift.accountName %>
                </strong>
              </p>

            <% } %>


            <% if (gift.accountNumber) { %>

              <div
                class="account-number"
              >
                <%= gift.accountNumber %>
              </div>


              <button
                type="button"
                class="copy-button"
                onclick="copyAccount('<%= gift.accountNumber %>')"
              >
                Copy Nomor
              </button>

            <% } %>


            <% if (gift.description) { %>

              <p
                style="
                  margin-top:15px;
                  opacity:.7;
                  line-height:1.7
                "
              >
                <%= gift.description %>
              </p>

            <% } %>

          </article>

        <% }); %>

      </div>

    </section>

  <% } %>


  <!-- =====================================================
       RSVP
  ====================================================== -->

  <section class="section">

    <div class="center">

      <p class="eyebrow">
        RSVP
      </p>

      <h2>
        Konfirmasi Kehadiran
      </h2>

      <p>
        Mohon konfirmasi kehadiran Anda.
      </p>

    </div>


    <div class="rsvp-card">

      <form id="rsvpForm">


        <div class="form-group">

          <label>
            Nama
          </label>

          <input
            type="text"
            name="name"
            maxlength="100"
            required
            placeholder="Nama Anda"
          >

        </div>


        <div class="form-group">

          <label>
            Kehadiran
          </label>

          <select
            name="attendance"
            required
          >

            <option value="">
              Pilih Kehadiran
            </option>

            <option value="hadir">
              Hadir
            </option>

            <option value="tidak_hadir">
              Tidak Hadir
            </option>

            <option value="masih_menentukan">
              Masih Menentukan
            </option>

          </select>

        </div>


        <div class="form-group">

          <label>
            Jumlah Tamu
          </label>

          <input
            type="number"
            name="guestCount"
            min="1"
            max="10"
            value="1"
            required
          >

        </div>


        <div class="form-group">

          <label>
            Pesan / Ucapan
          </label>

          <textarea
            name="message"
            maxlength="500"
            placeholder="Tuliskan doa dan ucapan..."
          ></textarea>

        </div>


        <button
          type="submit"
          class="submit-button"
        >
          Kirim RSVP
        </button>


        <div
          id="rsvpMessage"
          class="rsvp-message"
        ></div>


      </form>

    </div>

  </section>


  <!-- =====================================================
       CLOSING
  ====================================================== -->

  <section class="closing section">

    <div>

      <p class="eyebrow">
        Thank You
      </p>

      <h2>
        <%= wedding.bride?.name || "" %>
        &
        <%= wedding.groom?.name || "" %>
      </h2>

      <p style="line-height:2">
        Terima kasih atas doa,
        cinta dan kehadiran Anda.
      </p>

      <p class="eyebrow">
        LOVEFOREVER
      </p>

    </div>

  </section>


</div>


<!-- =======================================================
     MUSIC
======================================================== -->

<% if (
  wedding.music &&
  wedding.music.url
) { %>

  <audio
    id="weddingMusic"
    loop
    preload="none"
  >

    <source
      src="<%= wedding.music.url %>"
    >

  </audio>


  <button
    type="button"
    id="musicButton"
    class="music-button"
    aria-label="Toggle music"
  >
    ♪
  </button>

<% } %>


<!-- =======================================================
     LIGHTBOX
======================================================== -->

<div
  id="lightbox"
  class="lightbox"
  onclick="closeLightbox()"
>

  <button
    type="button"
    class="lightbox-close"
    onclick="closeLightbox()"
  >
    ×
  </button>

  <img
    id="lightboxImage"
    src=""
    alt="Gallery"
    onclick="event.stopPropagation()"
  >

</div>


<script>

/* =========================================================
   COUNTDOWN
========================================================= */

const countdown =
  document.getElementById(
    "countdown"
  );

if (countdown) {

  const targetDate =
    new Date(
      countdown.dataset.date
    ).getTime();


  function updateCountdown() {

    const now =
      Date.now();

    const distance =
      targetDate -
      now;


    if (
      distance <= 0
    ) {

      document.getElementById(
        "days"
      ).textContent =
        "0";

      document.getElementById(
        "hours"
      ).textContent =
        "0";

      document.getElementById(
        "minutes"
      ).textContent =
        "0";

      document.getElementById(
        "seconds"
      ).textContent =
        "0";

      return;

    }


    const days =
      Math.floor(
        distance /
        (
          1000 *
          60 *
          60 *
          24
        )
      );


    const hours =
      Math.floor(
        (
          distance %
          (
            1000 *
            60 *
            60 *
            24
          )
        ) /
        (
          1000 *
          60 *
          60
        )
      );


    const minutes =
      Math.floor(
        (
          distance %
          (
            1000 *
            60 *
            60
          )
        ) /
        (
          1000 *
          60
        )
      );


    const seconds =
      Math.floor(
        (
          distance %
          (
            1000 *
            60
          )
        ) /
        1000
      );


    document.getElementById(
      "days"
    ).textContent =
      days;


    document.getElementById(
      "hours"
    ).textContent =
      String(
        hours
      ).padStart(
        2,
        "0"
      );


    document.getElementById(
      "minutes"
    ).textContent =
      String(
        minutes
      ).padStart(
        2,
        "0"
      );


    document.getElementById(
      "seconds"
    ).textContent =
      String(
        seconds
      ).padStart(
        2,
        "0"
      );

  }


  updateCountdown();

  setInterval(
    updateCountdown,
    1000
  );

}


/* =========================================================
   RSVP
========================================================= */

const rsvpForm =
  document.getElementById(
    "rsvpForm"
  );

const rsvpMessage =
  document.getElementById(
    "rsvpMessage"
  );


if (rsvpForm) {

  rsvpForm.addEventListener(
    "submit",
    async event => {

      event.preventDefault();


      const formData =
        new FormData(
          rsvpForm
        );


      const payload = {

        name:
          formData.get(
            "name"
          ),

        attendance:
          formData.get(
            "attendance"
          ),

        guestCount:
          formData.get(
            "guestCount"
          ),

        message:
          formData.get(
            "message"
          )

      };


      rsvpMessage.className =
        "rsvp-message show";

      rsvpMessage.textContent =
        "Mengirim RSVP...";


      try {

        const response =
          await fetch(
            "<%= wedding.slug %>/rsvp",
            {
              method:
                "POST",

              headers: {
                "Content-Type":
                  "application/json"
              },

              body:
                JSON.stringify(
                  payload
                )
            }
          );


        const result =
          await response.json();


        if (
          !response.ok ||
          !result.success
        ) {

          throw new Error(
            result.message ||
            "RSVP gagal."
          );

        }


        rsvpMessage.textContent =
          result.message;

        rsvpMessage.style.background =
          "#e6f5e9";


        rsvpForm.reset();


      } catch (error) {

        rsvpMessage.textContent =
          error.message;

        rsvpMessage.style.background =
          "#f8dddd";

      }

    }
  );

}


/* =========================================================
   COPY ACCOUNT
========================================================= */

async function copyAccount(
  account
) {

  try {

    await navigator.clipboard.writeText(
      account
    );

    alert(
      "Nomor rekening berhasil disalin."
    );

  } catch {

    alert(
      "Nomor rekening: " +
      account
    );

  }

}


/* =========================================================
   LIGHTBOX
========================================================= */

function openLightbox(
  src
) {

  const lightbox =
    document.getElementById(
      "lightbox"
    );

  const image =
    document.getElementById(
      "lightboxImage"
    );

  image.src =
    src;

  lightbox.classList.add(
    "open"
  );

}


function closeLightbox() {

  const lightbox =
    document.getElementById(
      "lightbox"
    );

  lightbox.classList.remove(
    "open"
  );

}


/* =========================================================
   MUSIC
========================================================= */

const music =
  document.getElementById(
    "weddingMusic"
  );

const musicButton =
  document.getElementById(
    "musicButton"
  );


if (
  music &&
  musicButton
) {

  let playing =
    false;


  musicButton.addEventListener(
    "click",
    async () => {

      try {

        if (
          playing
        ) {

          music.pause();

          playing =
            false;

          musicButton.textContent =
            "♪";

        } else {

          await music.play();

          playing =
            true;

          musicButton.textContent =
            "Ⅱ";

        }

      } catch {

        alert(
          "Browser membutuhkan interaksi user untuk memutar musik."
        );

      }

    }
  );

}

</script>


<% } %>

</body>
</html>
