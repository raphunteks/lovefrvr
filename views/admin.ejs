/* =========================================================
   RSVP
========================================================= */

async function showRsvp(
  slug
) {

  const modal =
    document.getElementById(
      "rsvpModal"
    );

  const content =
    document.getElementById(
      "rsvpContent"
    );


  modal.classList.add(
    "open"
  );


  content.innerHTML =
    "<p>Loading...</p>";


  try {

    const response =
      await fetch(
        `/admin/wedding/${encodeURIComponent(slug)}/rsvp`
      );


    const result =
      await response.json();


    if (
      !response.ok ||
      !result.success
    ) {

      throw new Error(
        result.message ||
        "Gagal mengambil RSVP."
      );

    }


    if (
      !result.rsvps.length
    ) {

      content.innerHTML = `
        <div class="notice">
          Belum ada RSVP.
        </div>
      `;

      return;

    }


    const rows =
      result.rsvps
        .map(
          item => `
            <tr>

              <td>
                ${escapeHtml(item.name)}
              </td>

              <td>
                ${escapeHtml(item.attendance)}
              </td>

              <td>
                ${escapeHtml(item.guestCount)}
              </td>

              <td style="white-space:normal">
                ${escapeHtml(item.message || "-")}
              </td>

              <td>
                ${escapeHtml(item.createdAt)}
              </td>

            </tr>
          `
        )
        .join("");


    content.innerHTML = `

      <div class="summary-grid">

        <div class="summary-card">

          <small>
            Total
          </small>

          <strong>
            ${result.total}
          </strong>

        </div>

      </div>


      <div class="rsvp-table-wrapper">

        <table>

          <thead>

            <tr>

              <th>
                Nama
              </th>

              <th>
                Kehadiran
              </th>

              <th>
                Tamu
              </th>

              <th>
                Pesan
              </th>

              <th>
                Waktu
              </th>

            </tr>

          </thead>

          <tbody>
            ${rows}
          </tbody>

        </table>

      </div>

    `;


  } catch (error) {

    content.innerHTML = `
      <div class="notice warning">
        ${escapeHtml(
          error.message
        )}
      </div>
    `;

  }

}


function closeRsvpModal() {

  document
    .getElementById(
      "rsvpModal"
    )
    .classList.remove(
      "open"
    );

}


