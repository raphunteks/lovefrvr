<!DOCTYPE html>
<html lang="id">
<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Admin Dashboard — LOVEFOREVER
  </title>

  <style>

    * {
      box-sizing: border-box;
    }

    :root {
      --bg: #f5f3f0;
      --surface: #ffffff;
      --surface-soft: #faf8f5;
      --border: #e3ded8;
      --text: #292624;
      --muted: #77716c;
      --accent: #76685d;
      --danger: #a94442;
      --success: #55745d;
      --radius: 18px;
      --shadow:
        0 10px 35px rgba(45, 38, 33, .06);
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family:
        Inter,
        Arial,
        sans-serif;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 100;
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      background: rgba(255,255,255,.95);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(12px);
    }

    .brand {
      font-weight: 800;
      letter-spacing: .16em;
    }

    .logout {
      border: 0;
      border-radius: 12px;
      padding: 12px 18px;
      background: #ece7e2;
      color: var(--text);
    }

    .container {
      width: min(1500px, calc(100% - 32px));
      margin: 0 auto;
      padding: 45px 0 100px;
    }

    h1,
    h2,
    h3 {
      margin-top: 0;
    }

    .hero {
      margin-bottom: 30px;
    }

    .hero h1 {
      font-size: clamp(36px, 5vw, 64px);
      margin-bottom: 10px;
    }

    .hero p {
      color: var(--muted);
      font-size: 18px;
    }

    .alert {
      display: none;
      padding: 15px 18px;
      margin-bottom: 20px;
      border-radius: 12px;
      background: #fff2d6;
      color: #73521b;
    }

    .stats {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 30px;
    }

    .stat {
      padding: 28px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .stat span {
      display: block;
      color: var(--muted);
      margin-bottom: 14px;
    }

    .stat strong {
      display: block;
      font-size: 38px;
    }

    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      margin-bottom: 25px;
      overflow: hidden;
    }

    .panel-header {
      padding: 25px 28px;
      border-bottom: 1px solid var(--border);
    }

    .panel-body {
      padding: 28px;
    }

    .toolbar {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: center;
    }

    .toolbar select {
      min-width: 280px;
    }

    input,
    textarea,
    select {
      width: 100%;
      border: 1px solid #d8d2cb;
      background: #fff;
      border-radius: 12px;
      padding: 13px 14px;
      color: var(--text);
      outline: none;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: var(--accent);
      box-shadow:
        0 0 0 3px rgba(118,104,93,.10);
    }

    textarea {
      min-height: 140px;
      resize: vertical;
      line-height: 1.6;
    }

    label {
      display: block;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .field {
      margin-bottom: 20px;
    }

    .grid {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .grid-3 {
      display: grid;
      grid-template-columns:
        repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    .section {
      padding: 25px 0;
      border-bottom: 1px solid var(--border);
    }

    .section:last-child {
      border-bottom: 0;
    }

    .section-title {
      margin-bottom: 20px;
    }

    .section-title h3 {
      margin-bottom: 5px;
    }

    .section-title p {
      color: var(--muted);
      margin: 0;
    }

    .button {
      border: 0;
      border-radius: 12px;
      padding: 12px 18px;
      background: var(--accent);
      color: white;
      font-weight: 700;
    }

    .button.secondary {
      background: #ece7e2;
      color: var(--text);
    }

    .button.danger {
      background: var(--danger);
    }

    .button.success {
      background: var(--success);
    }

    .button:disabled {
      opacity: .5;
      cursor: not-allowed;
    }

    .media-grid {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 15px;
    }

    .media-card {
      border: 1px solid var(--border);
      border-radius: 15px;
      overflow: hidden;
      background: var(--surface-soft);
    }

    .media-preview {
      aspect-ratio: 1 / 1;
      background: #eee9e4;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .media-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .media-info {
      padding: 12px;
    }

    .media-info strong {
      display: block;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .media-info small {
      color: var(--muted);
    }

    .media-actions {
      margin-top: 10px;
      display: flex;
      gap: 8px;
    }

    .media-actions button {
      flex: 1;
    }

    .rsvp-table {
      width: 100%;
      border-collapse: collapse;
    }

    .rsvp-table th,
    .rsvp-table td {
      text-align: left;
      padding: 13px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }

    .empty {
      text-align: center;
      padding: 35px;
      color: var(--muted);
    }

    .status {
      display: inline-flex;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
    }

    .status.published {
      background: #e6f2e8;
      color: #416548;
    }

    .status.draft {
      background: #eeeae6;
      color: #766e67;
    }

    .hint {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.6;
    }

    .upload-box {
      padding: 20px;
      border: 1px dashed #cfc7bf;
      border-radius: 15px;
      background: var(--surface-soft);
    }

    .sticky-actions {
      position: sticky;
      bottom: 15px;
      z-index: 50;
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      padding: 15px;
      background: rgba(255,255,255,.94);
      border: 1px solid var(--border);
      border-radius: 18px;
      backdrop-filter: blur(12px);
      box-shadow: var(--shadow);
    }

    @media (max-width: 900px) {

      .stats {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .grid,
      .grid-3 {
        grid-template-columns: 1fr;
      }

      .media-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .topbar {
        padding: 0 18px;
      }

    }

    @media (max-width: 600px) {

      .container {
        width: min(
          100% - 20px,
          1500px
        );
        padding-top: 25px;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .media-grid {
        grid-template-columns: 1fr;
      }

      .panel-body,
      .panel-header {
        padding: 20px;
      }

      .toolbar select {
        min-width: 100%;
      }

      .sticky-actions {
        flex-direction: column;
      }

      .sticky-actions button {
        width: 100%;
      }

    }

  </style>

</head>

<body>

<header class="topbar">

  <div class="brand">
    LOVEFOREVER
  </div>

  <form
    method="POST"
    action="/admin/logout"
  >

    <button
      class="logout"
      type="submit"
    >
      Logout
    </button>

  </form>

</header>


<main class="container">

  <div
    id="alert"
    class="alert"
  ></div>


  <section class="hero">

    <h1>
      Admin Dashboard
    </h1>

    <p>
      Kelola wedding invitation,
      media, event, gallery,
      music, RSVP dan konten.
    </p>

  </section>


  <section class="stats">

    <div class="stat">
      <span>
        Total Wedding
      </span>

      <strong id="totalWedding">
        <%= totalWedding %>
      </strong>
    </div>


    <div class="stat">
      <span>
        Published
      </span>

      <strong id="publishedWedding">
        <%= published %>
      </strong>
    </div>


    <div class="stat">
      <span>
        Draft
      </span>

      <strong id="draftWedding">
        <%= draft %>
      </strong>
    </div>


    <div class="stat">
      <span>
        Total RSVP
      </span>

      <strong id="totalRSVP">
        <%= weddings.reduce(
          (sum, item) =>
            sum + (item.rsvpCount || 0),
          0
        ) %>
      </strong>
    </div>

  </section>


  <section class="panel">

    <div class="panel-header">

      <div class="toolbar">

        <select id="weddingSelector">

          <option value="">
            + Buat Wedding Baru
          </option>

          <% weddings.forEach(function(wedding) { %>

            <option
              value="<%= wedding.slug %>"
            >
              <%= wedding.slug %>
              —
              <%= wedding.status %>
            </option>

          <% }) %>

        </select>


        <button
          id="loadWeddingButton"
          class="button secondary"
          type="button"
        >
          Edit Wedding
        </button>

      </div>

    </div>

  </section>


  <section class="panel">

    <div class="panel-header">

      <h2>
        Wedding Editor
      </h2>

      <p class="hint">
        Editor ini dapat digunakan untuk
        wedding yang sudah Published maupun Draft.
      </p>

    </div>


    <div class="panel-body">

      <form
        id="weddingForm"
      >

        <!-- =====================================================
             GENERAL
        ====================================================== -->

        <div class="section">

          <div class="section-title">

            <h3>
              01. Informasi Dasar
            </h3>

            <p>
              Slug adalah URL wedding
              dan ditentukan manual oleh Admin.
            </p>

          </div>


          <div class="grid">

            <div class="field">

              <label>
                Slug
              </label>

              <input
                id="slug"
                name="slug"
                placeholder="contoh-aulia-rizky"
                required
              >

              <div class="hint">
                Contoh:
                /contoh-aulia-rizky
              </div>

            </div>


            <div class="field">

              <label>
                Status
              </label>

              <select
                id="status"
              >

                <option value="draft">
                  Draft
                </option>

                <option value="published">
                  Published
                </option>

              </select>

            </div>

          </div>


          <div class="field">

            <label>
              Judul
            </label>

            <input
              id="title"
              placeholder="The Wedding Of"
            >

          </div>


          <div class="grid">

            <div class="field">

              <label>
                Tanggal Pernikahan
              </label>

              <input
                id="date"
                type="datetime-local"
              >

            </div>


            <div class="field">

              <label>
                Timezone
              </label>

              <select id="timezone">

                <option value="Asia/Jakarta">
                  Asia/Jakarta — WIB
                </option>

                <option value="Asia/Makassar">
                  Asia/Makassar — WITA
                </option>

                <option value="Asia/Jayapura">
                  Asia/Jayapura — WIT
                </option>

              </select>

            </div>

          </div>

        </div>


        <!-- =====================================================
             OPENING
        ====================================================== -->

        <div class="section">

          <div class="section-title">

            <h3>
              02. Opening
            </h3>

            <p>
              Bagian yang muncul setelah
              user menekan BUKA UNDANGAN.
            </p>

          </div>


          <div class="field">

            <label>
              Eyebrow
            </label>

            <input id="openingEyebrow">

          </div>


          <div class="field">

            <label>
              Opening Title
            </label>

            <input id="openingTitle">

          </div>


          <div class="field">

            <label>
              Opening Text
            </label>

            <textarea
              id="openingText"
            ></textarea>

          </div>


          <div class="field">

            <label>
              Button
            </label>

            <input
              id="openingButton"
              value="BUKA UNDANGAN"
            >

          </div>

        </div>


        <!-- =====================================================
             COUPLE
        ====================================================== -->

        <div class="section">

          <div class="section-title">

            <h3>
              03. Mempelai
            </h3>

            <p>
              Data mempelai pria dan wanita.
            </p>

          </div>


          <div class="grid">

            <div>

              <h3>
                Mempelai Pria
              </h3>

              <div class="field">

                <label>
                  Nama
                </label>

                <input id="groomName">

              </div>

              <div class="field">

                <label>
                  Nama Lengkap
                </label>

                <input id="groomFullName">

              </div>

              <div class="field">

                <label>
                  Orang Tua
                </label>

                <input id="groomParents">

              </div>

              <div class="field">

                <label>
                  Instagram
                </label>

                <input id="groomInstagram">

              </div>

            </div>


            <div>

              <h3>
                Mempelai Wanita
              </h3>

              <div class="field">

                <label>
                  Nama
                </label>

                <input id="brideName">

              </div>

              <div class="field">

                <label>
                  Nama Lengkap
                </label>

                <input id="brideFullName">

              </div>

              <div class="field">

                <label>
                  Orang Tua
                </label>

                <input id="brideParents">

              </div>

              <div class="field">

                <label>
                  Instagram
                </label>

                <input id="brideInstagram">

              </div>

            </div>

          </div>

        </div>


        <!-- =====================================================
             QUOTE
        ====================================================== -->

        <div class="section">

          <div class="section-title">

            <h3>
              04. Quote
            </h3>

          </div>


          <div class="field">

            <label>
              Quote
            </label>

            <textarea
              id="quoteText"
            ></textarea>

          </div>


          <div class="field">

            <label>
              Source
            </label>

            <input
              id="quoteSource"
            >

          </div>

        </div>


        <!-- =====================================================
             STORY
        ====================================================== -->

        <div class="section">

          <div class="section-title">

            <h3>
              05. Story / Timeline
            </h3>

            <p>
              Gunakan format JSON.
            </p>

          </div>


          <div class="field">

            <textarea
              id="storyJSON"
              spellcheck="false"
            ></textarea>

          </div>

        </div>


        <!-- =====================================================
             EVENTS
        ====================================================== -->

        <div class="section">

          <div class="section-title">

            <h3>
              06. Events
            </h3>

            <p>
              Akad, resepsi atau event lainnya.
            </p>

          </div>


          <div class="field">

            <textarea
              id="eventsJSON"
              spellcheck="false"
            ></textarea>

          </div>

        </div>


        <!-- =====================================================
             GIFT
        ====================================================== -->

        <div class="section">

          <div class="section-title">

            <h3>
              07. Wedding Gift
            </h3>

          </div>


          <div class="grid">

            <div class="field">

              <label>
                Bank
              </label>

              <input id="bankName">

            </div>


            <div class="field">

              <label>
                Nomor Rekening
              </label>

              <input id="accountNumber">

            </div>


            <div class="field">

              <label>
                Nama Pemilik
              </label>

              <input id="accountName">

            </div>


            <div class="field">

              <label>
                Alamat
              </label>

              <input id="giftAddress">

            </div>

          </div>


          <div class="field">

            <label>
              Pesan Gift
            </label>

            <textarea
              id="giftText"
            ></textarea>

          </div>

        </div>


        <!-- =====================================================
             MEDIA
        ====================================================== -->

        <div class="section">

          <div class="section-title">

            <h3>
              08. Media
            </h3>

            <p>
              Semua file disimpan sebagai Base64
              di Upstash Redis.
            </p>

          </div>


          <div class="grid">

            <div class="upload-box">

              <label>
                Cover / Opening Image
              </label>

              <input
                id="coverUpload"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/gif"
              >

              <p class="hint">
                Maksimal ±1.2 MB.
              </p>

              <button
                class="button"
                type="button"
                onclick="uploadSingle('coverUpload','cover')"
              >
                Upload Cover
              </button>

            </div>


            <div class="upload-box">

              <label>
                Foto Mempelai Pria
              </label>

              <input
                id="groomUpload"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/gif"
              >

              <p class="hint">
                Maksimal ±1.2 MB.
              </p>

              <button
                class="button"
                type="button"
                onclick="uploadSingle('groomUpload','groom')"
              >
                Upload Foto Pria
              </button>

            </div>


            <div class="upload-box">

              <label>
                Foto Mempelai Wanita
              </label>

              <input
                id="brideUpload"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/gif"
              >

              <p class="hint">
                Maksimal ±1.2 MB.
              </p>

              <button
                class="button"
                type="button"
                onclick="uploadSingle('brideUpload','bride')"
              >
                Upload Foto Wanita
              </button>

            </div>


            <div class="upload-box">

              <label>
                MP3 / Music
              </label>

              <input
                id="musicUpload"
                type="file"
                accept="audio/mpeg,audio/mp3,audio/wav,audio/ogg"
              >

              <p class="hint">
                Maksimal ±3 MB karena batas
                request Vercel.
              </p>

              <button
                class="button"
                type="button"
                onclick="uploadSingle('musicUpload','music')"
              >
                Upload Music
              </button>

            </div>

          </div>


          <div
            class="upload-box"
            style="margin-top:20px;"
          >

            <label>
              Gallery
            </label>

            <input
              id="galleryUpload"
              type="file"
              multiple
              accept="image/jpeg,image/png,image/webp,image/gif"
            >

            <p class="hint">
              Gallery akan diupload satu file per request
              agar tidak terkena batas payload Vercel.
            </p>

            <button
              class="button"
              type="button"
              onclick="uploadGallery()"
            >
              Upload Semua Gallery
            </button>

          </div>


          <div
            id="mediaGrid"
            class="media-grid"
            style="margin-top:20px;"
          ></div>

        </div>


        <!-- =====================================================
             THEME
        ====================================================== -->

        <div class="section">

          <div class="section-title">

            <h3>
              09. Theme
            </h3>

          </div>


          <div class="grid-3">

            <div class="field">

              <label>
                Background
              </label>

              <input
                id="themeBackground"
                type="color"
              >

            </div>


            <div class="field">

              <label>
                Surface
              </label>

              <input
                id="themeSurface"
                type="color"
              >

            </div>


            <div class="field">

              <label>
                Text
              </label>

              <input
                id="themeText"
                type="color"
              >

            </div>


            <div class="field">

              <label>
                Muted
              </label>

              <input
                id="themeMuted"
                type="color"
              >

            </div>


            <div class="field">

              <label>
                Accent
              </label>

              <input
                id="themeAccent"
                type="color"
              >

            </div>

          </div>

        </div>


        <!-- =====================================================
             SETTINGS
        ====================================================== -->

        <div class="section">

          <div class="section-title">

            <h3>
              10. Section Settings
            </h3>

          </div>


          <div class="grid-3">

            <label>
              <input
                id="showCountdown"
                type="checkbox"
              >
              Countdown
            </label>


            <label>
              <input
                id="showStory"
                type="checkbox"
              >
              Story
            </label>


            <label>
              <input
                id="showGallery"
                type="checkbox"
              >
              Gallery
            </label>


            <label>
              <input
                id="showGift"
                type="checkbox"
              >
              Gift
            </label>


            <label>
              <input
                id="showRSVP"
                type="checkbox"
              >
              RSVP
            </label>


            <label>
              <input
                id="showMusic"
                type="checkbox"
              >
              Music
            </label>

          </div>

        </div>


        <!-- =====================================================
             SAVE
        ====================================================== -->

        <div class="sticky-actions">

          <button
            type="button"
            class="button secondary"
            onclick="newWedding()"
          >
            Wedding Baru
          </button>


          <button
            type="button"
            class="button secondary"
            id="previewButton"
            onclick="previewWedding()"
          >
            Preview
          </button>


          <button
            type="button"
            class="button success"
            onclick="saveWedding()"
          >
            Simpan Wedding
          </button>


          <button
            type="button"
            class="button danger"
            onclick="deleteCurrentWedding()"
          >
            Hapus Wedding
          </button>

        </div>

      </form>

    </div>

  </section>


  <!-- =========================================================
       RSVP
  ========================================================== -->

  <section class="panel">

    <div class="panel-header">

      <h2>
        RSVP
      </h2>

      <p class="hint">
        Data RSVP dari wedding yang sedang dipilih.
      </p>

    </div>

    <div class="panel-body">

      <div
        id="rsvpContainer"
      ></div>

    </div>

  </section>

</main>


<script>

  const state = {
    currentWedding: null,
    currentSlug: null
  };


  const selector =
    document.getElementById(
      "weddingSelector"
    );


  function showAlert(
    message,
    type = "warning"
  ) {

    const alert =
      document.getElementById(
        "alert"
      );

    alert.style.display =
      "block";

    alert.textContent =
      message;

    if (type === "success") {
      alert.style.background =
        "#e8f3e9";

      alert.style.color =
        "#416548";
    } else {
      alert.style.background =
        "#fff2d6";

      alert.style.color =
        "#73521b";
    }

    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });

  }


  async function api(
    url,
    options = {}
  ) {

    const response =
      await fetch(
        url,
        {
          credentials: "same-origin",
          ...options
        }
      );

    /*
     * FIX untuk error:
     *
     * Unexpected token '<'
     *
     * Jangan langsung response.json().
     * Kita cek content-type dahulu.
     */

    const contentType =
      response.headers.get(
        "content-type"
      ) || "";

    if (
      !contentType.includes(
        "application/json"
      )
    ) {

      const text =
        await response.text();

      throw new Error(
        `Server mengembalikan HTML/non-JSON (${response.status}). ` +
        text.slice(0, 200)
      );

    }

    const data =
      await response.json();

    if (!response.ok ||
        data.success === false) {

      throw new Error(
        data.error ||
        "Request gagal."
      );

    }

    return data;

  }


  function value(id) {

    const element =
      document.getElementById(
        id
      );

    return element
      ? element.value
      : "";

  }


  function setValue(
    id,
    value
  ) {

    const element =
      document.getElementById(
        id
      );

    if (element) {
      element.value =
        value ?? "";
    }

  }


  function checked(id) {

    const element =
      document.getElementById(
        id
      );

    return element
      ? element.checked
      : false;

  }


  function setChecked(
    id,
    value
  ) {

    const element =
      document.getElementById(
        id
      );

    if (element) {
      element.checked =
        Boolean(value);
    }

  }


  function prettyJSON(
    value
  ) {

    return JSON.stringify(
      value || [],
      null,
      2
    );

  }


  function fillWedding(
    wedding
  ) {

    state.currentWedding =
      wedding;

    state.currentSlug =
      wedding.slug;

    setValue(
      "slug",
      wedding.slug
    );

    setValue(
      "status",
      wedding.status
    );

    setValue(
      "title",
      wedding.title
    );

    setValue(
      "date",
      wedding.date
    );

    setValue(
      "timezone",
      wedding.timezone
    );


    const opening =
      wedding.opening ||
      {};

    setValue(
      "openingEyebrow",
      opening.eyebrow
    );

    setValue(
      "openingTitle",
      opening.title
    );

    setValue(
      "openingText",
      opening.text
    );

    setValue(
      "openingButton",
      opening.button
    );


    const groom =
      wedding.groom ||
      {};

    setValue(
      "groomName",
      groom.name
    );

    setValue(
      "groomFullName",
      groom.fullName
    );

    setValue(
      "groomParents",
      groom.parents
    );

    setValue(
      "groomInstagram",
      groom.instagram
    );


    const bride =
      wedding.bride ||
      {};

    setValue(
      "brideName",
      bride.name
    );

    setValue(
      "brideFullName",
      bride.fullName
    );

    setValue(
      "brideParents",
      bride.parents
    );

    setValue(
      "brideInstagram",
      bride.instagram
    );


    const quote =
      wedding.quote ||
      {};

    setValue(
      "quoteText",
      quote.text
    );

    setValue(
      "quoteSource",
      quote.source
    );


    setValue(
      "storyJSON",
      prettyJSON(
        wedding.story
      )
    );

    setValue(
      "eventsJSON",
      prettyJSON(
        wedding.events
      )
    );


    const gift =
      wedding.gift ||
      {};

    setValue(
      "bankName",
      gift.bankName
    );

    setValue(
      "accountNumber",
      gift.accountNumber
    );

    setValue(
      "accountName",
      gift.accountName
    );

    setValue(
      "giftAddress",
      gift.address
    );

    setValue(
      "giftText",
      gift.text
    );


    const theme =
      wedding.theme ||
      {};

    setValue(
      "themeBackground",
      theme.background ||
      "#f7f2eb"
    );

    setValue(
      "themeSurface",
      theme.surface ||
      "#fffdf9"
    );

    setValue(
      "themeText",
      theme.text ||
      "#2e2925"
    );

    setValue(
      "themeMuted",
      theme.muted ||
      "#8c837b"
    );

    setValue(
      "themeAccent",
      theme.accent ||
      "#7c6b5d"
    );


    const settings =
      wedding.settings ||
      {};

    setChecked(
      "showCountdown",
      settings.showCountdown
    );

    setChecked(
      "showStory",
      settings.showStory
    );

    setChecked(
      "showGallery",
      settings.showGallery
    );

    setChecked(
      "showGift",
      settings.showGift
    );

    setChecked(
      "showRSVP",
      settings.showRSVP
    );

    setChecked(
      "showMusic",
      settings.showMusic
    );


    renderMedia(
      wedding
    );

  }


  function parseJSONField(
    id,
    fallback
  ) {

    try {

      const parsed =
        JSON.parse(
          value(id)
        );

      return parsed;

    } catch {

      throw new Error(
        `JSON pada ${id} tidak valid.`
      );

    }

  }


  function buildWeddingPayload() {

    if (
      !state.currentWedding
    ) {

      return {
        slug:
          value("slug"),
        status:
          value("status")
      };

    }


    const wedding =
      JSON.parse(
        JSON.stringify(
          state.currentWedding
        )
      );


    wedding.slug =
      value("slug")
        .trim()
        .toLowerCase();

    wedding.status =
      value("status");

    wedding.title =
      value("title");

    wedding.date =
      value("date");

    wedding.timezone =
      value("timezone");


    wedding.opening = {
      ...(wedding.opening || {}),
      eyebrow:
        value(
          "openingEyebrow"
        ),
      title:
        value(
          "openingTitle"
        ),
      text:
        value(
          "openingText"
        ),
      button:
        value(
          "openingButton"
        )
    };


    wedding.groom = {
      ...(wedding.groom || {}),
      name:
        value("groomName"),
      fullName:
        value("groomFullName"),
      parents:
        value("groomParents"),
      instagram:
        value("groomInstagram")
    };


    wedding.bride = {
      ...(wedding.bride || {}),
      name:
        value("brideName"),
      fullName:
        value("brideFullName"),
      parents:
        value("brideParents"),
      instagram:
        value("brideInstagram")
    };


    wedding.quote = {
      ...(wedding.quote || {}),
      text:
        value("quoteText"),
      source:
        value("quoteSource")
    };


    wedding.story =
      parseJSONField(
        "storyJSON",
        []
      );


    wedding.events =
      parseJSONField(
        "eventsJSON",
        []
      );


    wedding.gift = {
      ...(wedding.gift || {}),
      bankName:
        value("bankName"),
      accountNumber:
        value("accountNumber"),
      accountName:
        value("accountName"),
      address:
        value("giftAddress"),
      text:
        value("giftText")
    };


    wedding.theme = {
      ...(wedding.theme || {}),
      background:
        value(
          "themeBackground"
        ),
      surface:
        value(
          "themeSurface"
        ),
      text:
        value(
          "themeText"
        ),
      muted:
        value(
          "themeMuted"
        ),
      accent:
        value(
          "themeAccent"
        )
    };


    wedding.settings = {
      ...(wedding.settings || {}),
      showCountdown:
        checked(
          "showCountdown"
        ),
      showStory:
        checked(
          "showStory"
        ),
      showGallery:
        checked(
          "showGallery"
        ),
      showGift:
        checked(
          "showGift"
        ),
      showRSVP:
        checked(
          "showRSVP"
        ),
      showMusic:
        checked(
          "showMusic"
        ),
      bottomNavigation:
        true
    };


    return wedding;

  }


  async function loadWedding(
    slug
  ) {

    if (!slug) {
      newWedding();
      return;
    }

    try {

      const data =
        await api(
          `/api/weddings/${encodeURIComponent(
            slug
          )}`
        );

      fillWedding(
        data.wedding
      );

      renderRSVP(
        data.rsvps
      );

      selector.value =
        slug;

      showAlert(
        "Wedding berhasil dimuat.",
        "success"
      );

    } catch (error) {

      showAlert(
        error.message
      );

    }

  }


  function newWedding() {

    state.currentWedding =
      null;

    state.currentSlug =
      null;

    document
      .getElementById(
        "weddingForm"
      )
      .reset();

    setValue(
      "status",
      "draft"
    );

    setValue(
      "title",
      "The Wedding Of"
    );

    setValue(
      "timezone",
      "Asia/Jakarta"
    );

    setValue(
      "openingButton",
      "BUKA UNDANGAN"
    );

    setValue(
      "storyJSON",
      "[]"
    );

    setValue(
      "eventsJSON",
      prettyJSON([
        {
          title: "Akad Nikah",
          date: "",
          time: "",
          venue: "",
          address: "",
          mapsUrl: ""
        },
        {
          title: "Resepsi",
          date: "",
          time: "",
          venue: "",
          address: "",
          mapsUrl: ""
        }
      ])
    );

    setValue(
      "quoteText",
      "Dan di antara tanda-tanda kekuasaan-Nya ialah Dia menciptakan untukmu pasangan hidup dari jenismu sendiri supaya kamu mendapatkan ketenangan hati dan dijadikan-Nya kasih sayang di antara kamu."
    );

    setValue(
      "quoteSource",
      "QS. Ar-Rum: 21"
    );

    setValue(
      "themeBackground",
      "#f7f2eb"
    );

    setValue(
      "themeSurface",
      "#fffdf9"
    );

    setValue(
      "themeText",
      "#2e2925"
    );

    setValue(
      "themeMuted",
      "#8c837b"
    );

    setValue(
      "themeAccent",
      "#7c6b5d"
    );

    setChecked(
      "showCountdown",
      true
    );

    setChecked(
      "showStory",
      true
    );

    setChecked(
      "showGallery",
      true
    );

    setChecked(
      "showGift",
      true
    );

    setChecked(
      "showRSVP",
      true
    );

    setChecked(
      "showMusic",
      true
    );

    document
      .getElementById(
        "mediaGrid"
      )
      .innerHTML = "";

    document
      .getElementById(
        "rsvpContainer"
      )
      .innerHTML =
      '<div class="empty">Belum ada RSVP.</div>';

    selector.value = "";

    showAlert(
      "Mode Wedding Baru aktif."
    );

  }


  async function saveWedding() {

    try {

      const payload =
        buildWeddingPayload();

      if (!payload.slug) {
        throw new Error(
          "Slug wajib diisi."
        );
      }


      const isNew =
        !state.currentSlug;


      const url =
        isNew
          ? "/api/weddings"
          : `/api/weddings/${encodeURIComponent(
              state.currentSlug
            )}`;


      const method =
        isNew
          ? "POST"
          : "PUT";


      const data =
        await api(
          url,
          {
            method,
            headers: {
              "Content-Type":
                "application/json"
            },
            body:
              JSON.stringify(
                payload
              )
          }
        );


      state.currentWedding =
        data.wedding;

      state.currentSlug =
        data.wedding.slug;


      await refreshSelector();

      selector.value =
        data.wedding.slug;


      fillWedding(
        data.wedding
      );


      showAlert(
        "Wedding berhasil disimpan.",
        "success"
      );

    } catch (error) {

      showAlert(
        error.message
      );

    }

  }


  async function refreshSelector() {

    try {

      const data =
        await api(
          "/api/weddings"
        );

      selector.innerHTML =
        '<option value="">+ Buat Wedding Baru</option>';

      data.weddings.forEach(
        wedding => {

          const option =
            document.createElement(
              "option"
            );

          option.value =
            wedding.slug;

          option.textContent =
            `${wedding.slug} — ${wedding.status}`;

          selector.appendChild(
            option
          );

        }
      );


      document
        .getElementById(
          "totalWedding"
        )
        .textContent =
        data.weddings.length;


      document
        .getElementById(
          "publishedWedding"
        )
        .textContent =
        data.weddings.filter(
          item =>
            item.status ===
            "published"
        ).length;


      document
        .getElementById(
          "draftWedding"
        )
        .textContent =
        data.weddings.filter(
          item =>
            item.status ===
            "draft"
        ).length;


      document
        .getElementById(
          "totalRSVP"
        )
        .textContent =
        data.weddings.reduce(
          (
            total,
            item
          ) =>
            total +
            (
              item.rsvpCount ||
              0
            ),
          0
        );

    } catch (error) {

      console.error(
        error
      );

    }

  }


  async function uploadSingle(
    inputId,
    type
  ) {

    if (!state.currentSlug) {

      showAlert(
        "Simpan wedding terlebih dahulu sebelum upload media."
      );

      return;

    }


    const input =
      document.getElementById(
        inputId
      );

    if (
      !input.files ||
      !input.files[0]
    ) {

      showAlert(
        "Pilih file terlebih dahulu."
      );

      return;

    }


    const file =
      input.files[0];


    const formData =
      new FormData();

    formData.append(
      "file",
      file
    );


    try {

      const data =
        await api(
          `/api/weddings/${encodeURIComponent(
            state.currentSlug
          )}/assets`,
          {
            method: "POST",
            body:
              formData
          }
        );


      const asset =
        data.asset;


      const wedding =
        state.currentWedding;


      if (type === "cover") {

        wedding.cover = {
          assetId:
            asset.assetId,
          filename:
            asset.filename,
          mime:
            asset.mime,
          url:
            asset.url
        };

      }


      if (type === "groom") {

        wedding.groom =
          wedding.groom ||
          {};

        wedding.groom.photo = {
          assetId:
            asset.assetId,
          filename:
            asset.filename,
          mime:
            asset.mime,
          url:
            asset.url
        };

      }


      if (type === "bride") {

        wedding.bride =
          wedding.bride ||
          {};

        wedding.bride.photo = {
          assetId:
            asset.assetId,
          filename:
            asset.filename,
          mime:
            asset.mime,
          url:
            asset.url
        };

      }


      if (type === "music") {

        wedding.music =
          wedding.music ||
          {};

        wedding.music.assetId =
          asset.assetId;

        wedding.music.title =
          asset.filename;

        wedding.music.url =
          asset.url;

      }


      await saveWedding();

      input.value = "";

      showAlert(
        `${asset.filename} berhasil diupload.`,
        "success"
      );

    } catch (error) {

      showAlert(
        error.message
      );

    }

  }


  async function uploadGallery() {

    if (!state.currentSlug) {

      showAlert(
        "Simpan wedding terlebih dahulu."
      );

      return;

    }


    const input =
      document.getElementById(
        "galleryUpload"
      );


    if (
      !input.files ||
      !input.files.length
    ) {

      showAlert(
        "Pilih foto gallery."
      );

      return;

    }


    const files =
      Array.from(
        input.files
      );


    for (
      const file of files
    ) {

      try {

        const formData =
          new FormData();

        formData.append(
          "file",
          file
        );


        const data =
          await api(
            `/api/weddings/${encodeURIComponent(
              state.currentSlug
            )}/assets`,
            {
              method: "POST",
              body:
                formData
            }
          );


        const asset =
          data.asset;


        state.currentWedding.gallery =
          state.currentWedding.gallery ||
          [];


        state.currentWedding.gallery.push({
          assetId:
            asset.assetId,
          filename:
            asset.filename,
          mime:
            asset.mime,
          url:
            asset.url,
          caption:
            asset.filename
        });


        renderMedia(
          state.currentWedding
        );


      } catch (error) {

        showAlert(
          `${file.name}: ${error.message}`
        );

      }

    }


    await saveWedding();

    input.value = "";

    showAlert(
      "Gallery berhasil diupload.",
      "success"
    );

  }


  function renderMedia(
    wedding
  ) {

    const container =
      document.getElementById(
        "mediaGrid"
      );


    const items = [];


    if (
      wedding.cover &&
      wedding.cover.assetId
    ) {

      items.push({
        ...wedding.cover,
        label:
          "Cover"
      });

    }


    if (
      wedding.groom &&
      wedding.groom.photo &&
      wedding.groom.photo.assetId
    ) {

      items.push({
        ...wedding.groom.photo,
        label:
          "Mempelai Pria"
      });

    }


    if (
      wedding.bride &&
      wedding.bride.photo &&
      wedding.bride.photo.assetId
    ) {

      items.push({
        ...wedding.bride.photo,
        label:
          "Mempelai Wanita"
      });

    }


    if (
      wedding.music &&
      wedding.music.assetId
    ) {

      items.push({
        assetId:
          wedding.music.assetId,
        filename:
          wedding.music.title,
        mime:
          "audio/mpeg",
        url:
          wedding.music.url,
        label:
          "Music"
      });

    }


    if (
      Array.isArray(
        wedding.gallery
      )
    ) {

      wedding.gallery.forEach(
        item => {

          items.push({
            ...item,
            label:
              "Gallery"
          });

        }
      );

    }


    if (!items.length) {

      container.innerHTML =
        '<div class="empty">Belum ada media.</div>';

      return;

    }


    container.innerHTML =
      items
        .map(
          item => {

            const isAudio =
              item.mime &&
              item.mime.startsWith(
                "audio/"
              );


            return `
              <article class="media-card">

                <div class="media-preview">

                  ${
                    isAudio
                      ? `
                        <audio
                          controls
                          style="width:90%;"
                          src="${escapeHTML(
                            item.url || ""
                          )}"
                        ></audio>
                      `
                      : `
                        <img
                          src="${escapeHTML(
                            item.url || ""
                          )}"
                          alt="${escapeHTML(
                            item.label || ""
                          )}"
                        >
                      `
                  }

                </div>


                <div class="media-info">

                  <strong>
                    ${escapeHTML(
                      item.label || ""
                    )}
                  </strong>

                  <small>
                    ${escapeHTML(
                      item.filename || ""
                    )}
                  </small>


                  <div class="media-actions">

                    <button
                      class="button danger"
                      type="button"
                      onclick="deleteMedia('${escapeHTML(
                        item.assetId
                      )}')"
                    >
                      Hapus
                    </button>

                  </div>

                </div>

              </article>
            `;

          }
        )
        .join("");

  }


  function escapeHTML(
    value
  ) {

    return String(
      value || ""
    )
      .replace(
        /&/g,
        "&amp;"
      )
      .replace(
        /</g,
        "&lt;"
      )
      .replace(
        />/g,
        "&gt;"
      )
      .replace(
        /"/g,
        "&quot;"
      )
      .replace(
        /'/g,
        "&#039;"
      );

  }


  async function deleteMedia(
    assetId
  ) {

    if (
      !confirm(
        "Hapus media ini?"
      )
    ) {
      return;
    }


    try {

      await api(
        `/api/assets/${encodeURIComponent(
          assetId
        )}`,
        {
          method:
            "DELETE"
        }
      );


      const wedding =
        state.currentWedding;


      if (
        wedding.cover &&
        wedding.cover.assetId ===
          assetId
      ) {

        wedding.cover =
          null;

      }


      if (
        wedding.groom &&
        wedding.groom.photo &&
        wedding.groom.photo.assetId ===
          assetId
      ) {

        wedding.groom.photo =
          null;

      }


      if (
        wedding.bride &&
        wedding.bride.photo &&
        wedding.bride.photo.assetId ===
          assetId
      ) {

        wedding.bride.photo =
          null;

      }


      if (
        wedding.music &&
        wedding.music.assetId ===
          assetId
      ) {

        wedding.music.assetId =
          null;

        wedding.music.url =
          null;

      }


      wedding.gallery =
        (
          wedding.gallery ||
          []
        ).filter(
          item =>
            item.assetId !==
            assetId
        );


      await saveWedding();

      renderMedia(
        wedding
      );

      showAlert(
        "Media berhasil dihapus.",
        "success"
      );

    } catch (error) {

      showAlert(
        error.message
      );

    }

  }


  function renderRSVP(
    rsvps
  ) {

    const container =
      document.getElementById(
        "rsvpContainer"
      );


    if (
      !rsvps ||
      !rsvps.length
    ) {

      container.innerHTML =
        '<div class="empty">Belum ada RSVP.</div>';

      return;

    }


    container.innerHTML = `

      <div style="overflow:auto;">

        <table class="rsvp-table">

          <thead>

            <tr>

              <th>
                Nama
              </th>

              <th>
                Kehadiran
              </th>

              <th>
                Jumlah Tamu
              </th>

              <th>
                Pesan
              </th>

              <th>
                Waktu
              </th>

            </tr>

          </thead>

          <tbody>

            ${rsvps.map(
              item => `

                <tr>

                  <td>
                    ${escapeHTML(
                      item.name
                    )}
                  </td>

                  <td>
                    ${escapeHTML(
                      item.attendance
                    )}
                  </td>

                  <td>
                    ${escapeHTML(
                      item.guestCount
                    )}
                  </td>

                  <td>
                    ${escapeHTML(
                      item.message
                    )}
                  </td>

                  <td>
                    ${escapeHTML(
                      item.createdAt
                    )}
                  </td>

                </tr>

              `
            ).join("")}

          </tbody>

        </table>

      </div>

    `;

  }


  async function deleteCurrentWedding() {

    if (
      !state.currentSlug
    ) {

      showAlert(
        "Belum ada wedding yang dipilih."
      );

      return;

    }


    if (
      !confirm(
        `Hapus wedding "${state.currentSlug}" beserta RSVP dan media?`
      )
    ) {

      return;

    }


    try {

      await api(
        `/api/weddings/${encodeURIComponent(
          state.currentSlug
        )}`,
        {
          method:
            "DELETE"
        }
      );


      newWedding();

      await refreshSelector();

      showAlert(
        "Wedding berhasil dihapus.",
        "success"
      );

    } catch (error) {

      showAlert(
        error.message
      );

    }

  }


  function previewWedding() {

    if (
      !state.currentSlug
    ) {

      showAlert(
        "Simpan wedding terlebih dahulu."
      );

      return;

    }


    window.open(
      `/${encodeURIComponent(
        state.currentSlug
      )}`,
      "_blank"
    );

  }


  selector.addEventListener(
    "change",
    () => {

      if (
        selector.value
      ) {

        loadWedding(
          selector.value
        );

      } else {

        newWedding();

      }

    }
  );


  document
    .getElementById(
      "loadWeddingButton"
    )
    .addEventListener(
      "click",
      () => {

        if (
          selector.value
        ) {

          loadWedding(
            selector.value
          );

        } else {

          newWedding();

        }

      }
    );


  /*
   * Initial state:
   * jika wedding pertama tersedia,
   * otomatis load wedding tersebut.
   */

  <% if (weddings.length) { %>

    loadWedding(
      "<%= weddings[0].slug %>"
    );

  <% } else { %>

    newWedding();

  <% } %>

</script>

</body>
</html>
