                <label>

                  <input
                    type="checkbox"
                    name="showStory"
                    style="width:auto"
                    <%= wedding.settings?.showStory !== false
                      ? "checked"
                      : "" %>
                  >

                  Story

                </label>


                <label>

                  <input
                    type="checkbox"
                    name="showGallery"
                    style="width:auto"
                    <%= wedding.settings?.showGallery !== false
                      ? "checked"
                      : "" %>
                  >

