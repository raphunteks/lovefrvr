<!DOCTYPE html>
<html lang="id">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Admin Dashboard — LOVEFOREVER
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

</head>


<body>

  <main class="admin-container">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="admin-header">

      <div>

        <p class="eyebrow">
          LOVEFOREVER
        </p>

        <h1>
          Admin Dashboard
        </h1>

        <p>
          Kelola seluruh wedding invitation
          dari satu dashboard.
        </p>

      </div>


      <div>

        <span>
          Login sebagai:
          <strong>
            <%= admin.username %>
          </strong>
        </span>


        <form
          method="POST"
          action="/admin/logout"
          style="display:inline;"
        >

          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >

          <button
            type="submit"
            class="button"
          >
            Logout
          </button>

        </form>

      </div>

    </header>


    <!-- =====================================================
         ALERT
    ====================================================== -->

    <% if (message) { %>

      <div class="alert alert-success">
        <%= message %>
      </div>

    <% } %>


    <% if (error) { %>

      <div class="alert alert-error">
        <%= error %>
      </div>

    <% } %>


    <!-- =====================================================
         DASHBOARD SUMMARY
    ====================================================== -->

    <section class="dashboard-stats">


      <div class="stat-card">

        <span>
          Total Wedding
        </span>

        <strong>
          <%= stats.totalWeddings %>
        </strong>

      </div>


      <div class="stat-card">

        <span>
          Published
        </span>

        <strong>
          <%= stats.publishedWeddings %>
        </strong>

      </div>


      <div class="stat-card">

        <span>
          Draft
        </span>

        <strong>
          <%= stats.draftWeddings %>
        </strong>

      </div>


      <div class="stat-card">

        <span>
          Total RSVP
        </span>

        <strong>
          <%= stats.totalRsvp %>
        </strong>

      </div>


    </section>


    <!-- =====================================================
         CREATE WEDDING
    ====================================================== -->

    <section class="admin-card">

      <div class="card-header">

        <div>

          <p class="eyebrow">
            NEW INVITATION
          </p>

          <h2>
            Buat Wedding Baru
          </h2>

        </div>

      </div>


      <form
        method="POST"
        action="/admin/wedding/create"
        class="form"
      >

        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >


        <!-- SLUG -->

        <div class="form-group">

          <label for="create-slug">
            Slug
          </label>

          <input
            id="create-slug"
            name="slug"
            type="text"
            placeholder="contoh: aulia-rizky"
            pattern="[a-z0-9-]+"
            minlength="3"
            maxlength="100"
            required
          >

          <small>
            Slug menentukan URL invitation.
          </small>

          <div
            id="create-url"
            class="url-preview"
          >
            https://loveforever.vercel.app/
          </div>

        </div>


        <!-- BRIDE -->

        <div class="form-group">

          <label>
            Nama Mempelai Wanita
          </label>

          <input
            name="brideName"
            type="text"
            placeholder="Aulia"
          >

        </div>


        <div class="form-group">

          <label>
            Nama Lengkap Mempelai Wanita
          </label>

          <input
            name="brideFullName"
            type="text"
            placeholder="Aulia Putri..."
          >

        </div>


        <div class="form-group">

          <label>
            Nama Ayah Mempelai Wanita
          </label>

          <input
            name="brideFather"
            type="text"
          >

        </div>


        <div class="form-group">

          <label>
            Nama Ibu Mempelai Wanita
          </label>

          <input
            name="brideMother"
            type="text"
          >

        </div>


        <!-- GROOM -->

        <div class="form-group">

          <label>
            Nama Mempelai Pria
          </label>

          <input
            name="groomName"
            type="text"
            placeholder="Rizky"
          >

        </div>


        <div class="form-group">

          <label>
            Nama Lengkap Mempelai Pria
          </label>

          <input
            name="groomFullName"
            type="text"
            placeholder="Rizky Ahmad..."
          >

        </div>


        <div class="form-group">

          <label>
            Nama Ayah Mempelai Pria
          </label>

          <input
            name="groomFather"
            type="text"
          >

        </div>


        <div class="form-group">

          <label>
            Nama Ibu Mempelai Pria
          </label>

          <input
            name="groomMother"
            type="text"
          >

        </div>


        <!-- QUOTE -->

        <div class="form-group">

          <label>
            Quote Pernikahan
          </label>

          <textarea
            name="quote"
            rows="3"
            placeholder="Quote / ayat / kalimat pembuka..."
          ></textarea>

        </div>


        <!-- DATE -->

        <div class="form-group">

          <label>
            Tanggal Pernikahan
          </label>

          <input
            name="weddingDate"
            type="date"
          >

        </div>


        <!-- TIME -->

        <div class="form-group">

          <label>
            Waktu Acara
          </label>

          <input
            name="weddingTime"
            type="text"
            placeholder="10.00 WITA - selesai"
          >

        </div>


        <!-- VENUE -->

        <div class="form-group">

          <label>
            Venue
          </label>

          <input
            name="venue"
            type="text"
            placeholder="Gedung / Hotel / Rumah"
          >

        </div>


        <!-- ADDRESS -->

        <div class="form-group">

          <label>
            Alamat
          </label>

          <textarea
            name="address"
            rows="3"
          ></textarea>

        </div>


        <!-- MAP -->

        <div class="form-group">

          <label>
            Google Maps URL
          </label>

          <input
            name="mapsUrl"
            type="url"
            placeholder="https://maps.google.com/..."
          >

        </div>


        <!-- STORY -->

        <div class="form-group">

          <label>
            Story / Cerita Singkat
          </label>

          <textarea
            name="story"
            rows="5"
            placeholder="Cerita perjalanan pasangan..."
          ></textarea>

        </div>


        <!-- GIFT -->

        <h3>
          Wedding Gift
        </h3>


        <div class="form-group">

          <label>
            Nama Bank
          </label>

          <input
            name="bankName"
            type="text"
            placeholder="BCA"
          >

        </div>


        <div class="form-group">

          <label>
            Nomor Rekening
          </label>

          <input
            name="accountNumber"
            type="text"
          >

        </div>


        <div class="form-group">

          <label>
            Atas Nama
          </label>

          <input
            name="accountName"
            type="text"
          >

        </div>


        <!-- MUSIC -->

        <h3>
          Music
        </h3>


        <div class="form-group">

          <label>

            <input
              name="musicEnabled"
              type="checkbox"
            >

            Aktifkan musik

          </label>

        </div>


        <div class="form-group">

          <label>
            URL Musik
          </label>

          <input
            name="musicUrl"
            type="url"
            placeholder="URL file audio"
          >

        </div>


        <!-- STATUS -->

        <div class="form-group">

          <label>
            Status
          </label>

          <select
            name="status"
          >

            <option value="draft">
              Draft
            </option>

            <option value="published">
              Published
            </option>

          </select>

        </div>


        <button
          type="submit"
          class="button"
        >
          + Buat Wedding Invitation
        </button>

      </form>

    </section>


    <!-- =====================================================
         WEDDING LIST
    ====================================================== -->

    <section class="admin-card">

      <div class="card-header">

        <div>

          <p class="eyebrow">
            INVITATIONS
          </p>

          <h2>
            Daftar Wedding
          </h2>

        </div>

      </div>


      <% if (!weddings.length) { %>

        <div class="empty-state">

          <p>
            Belum ada wedding invitation.
          </p>

        </div>

      <% } %>


      <% weddings.forEach(function(wedding) { %>


        <article
          class="wedding-admin-item"
        >


          <!-- INFO -->

          <div>

            <span
              class="status status-<%= wedding.status %>"
            >
              <%= wedding.status %>
            </span>


            <h3>

              <%= wedding.bride.name || "Bride" %>

              &

              <%= wedding.groom.name || "Groom" %>

            </h3>


            <p>

              Slug:

              <strong>
                <%= wedding.slug %>
              </strong>

            </p>


            <p>

              <a
                href="/<%= encodeURIComponent(wedding.slug) %>"
                target="_blank"
                rel="noopener noreferrer"
              >
                Lihat Invitation →
              </a>

            </p>


            <p>

              Personalized link:

              <br>

              <code>
                https://loveforever.vercel.app/<%= wedding.slug %>?to=Nama%20Tamu
              </code>

            </p>


          </div>


          <!-- ACTION -->

          <div class="admin-actions">


            <!-- PUBLISH -->

            <form
              method="POST"
              action="/admin/wedding/status"
            >

              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >

              <input
                type="hidden"
                name="slug"
                value="<%= wedding.slug %>"
              >

              <button
                type="submit"
                class="button"
              >

                <% if (wedding.status === "published") { %>

                  Unpublish

                <% } else { %>

                  Publish

                <% } %>

              </button>

            </form>


            <!-- RSVP -->

            <button
              type="button"
              class="button"
              onclick="viewRSVP('<%= wedding.slug %>')"
            >
              Lihat RSVP
            </button>


            <!-- EDIT -->

            <button
              type="button"
              class="button"
              onclick="toggleEdit('<%= wedding.slug %>')"
            >
              Edit
            </button>


            <!-- DELETE -->

            <form
              method="POST"
              action="/admin/wedding/delete"
              onsubmit="return confirmDelete('<%= wedding.slug %>')"
            >

              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >

              <input
                type="hidden"
                name="slug"
                value="<%= wedding.slug %>"
              >

              <button
                type="submit"
                class="button button-danger"
              >
                Hapus
              </button>

            </form>


          </div>


          <!-- =================================================
               EDIT FORM
          ================================================== -->

          <div
            id="edit-<%= wedding.slug %>"
            class="edit-panel"
            hidden
          >

            <h3>
              Edit Wedding
            </h3>


            <form
              method="POST"
              action="/admin/wedding/update"
              class="form"
            >

              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >


              <input
                type="hidden"
                name="slug"
                value="<%= wedding.slug %>"
              >


              <div class="form-group">

                <label>
                  Slug
                </label>

                <input
                  type="text"
                  value="<%= wedding.slug %>"
                  disabled
                >

                <small>
                  Slug tidak dapat diubah dari form edit.
                  Jika perlu mengganti slug, buat invitation
                  baru.
                </small>

              </div>


              <div class="form-group">

                <label>
                  Nama Mempelai Wanita
                </label>

                <input
                  name="brideName"
                  value="<%= wedding.bride.name || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Nama Lengkap Mempelai Wanita
                </label>

                <input
                  name="brideFullName"
                  value="<%= wedding.bride.fullName || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Ayah Mempelai Wanita
                </label>

                <input
                  name="brideFather"
                  value="<%= wedding.bride.father || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Ibu Mempelai Wanita
                </label>

                <input
                  name="brideMother"
                  value="<%= wedding.bride.mother || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Nama Mempelai Pria
                </label>

                <input
                  name="groomName"
                  value="<%= wedding.groom.name || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Nama Lengkap Mempelai Pria
                </label>

                <input
                  name="groomFullName"
                  value="<%= wedding.groom.fullName || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Ayah Mempelai Pria
                </label>

                <input
                  name="groomFather"
                  value="<%= wedding.groom.father || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Ibu Mempelai Pria
                </label>

                <input
                  name="groomMother"
                  value="<%= wedding.groom.mother || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Quote
                </label>

                <textarea
                  name="quote"
                  rows="3"
                ><%= wedding.quote || '' %></textarea>

              </div>


              <div class="form-group">

                <label>
                  Tanggal Pernikahan
                </label>

                <input
                  name="weddingDate"
                  type="date"
                  value="<%= wedding.weddingDate || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Waktu
                </label>

                <input
                  name="weddingTime"
                  value="<%= wedding.weddingTime || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Venue
                </label>

                <input
                  name="venue"
                  value="<%= wedding.venue || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Alamat
                </label>

                <textarea
                  name="address"
                  rows="3"
                ><%= wedding.address || '' %></textarea>

              </div>


              <div class="form-group">

                <label>
                  Google Maps URL
                </label>

                <input
                  name="mapsUrl"
                  type="url"
                  value="<%= wedding.mapsUrl || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Story
                </label>

                <textarea
                  name="story"
                  rows="5"
                ><%= wedding.story || '' %></textarea>

              </div>


              <div class="form-group">

                <label>
                  Nama Bank
                </label>

                <input
                  name="bankName"
                  value="<%= wedding.gift.bankName || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Nomor Rekening
                </label>

                <input
                  name="accountNumber"
                  value="<%= wedding.gift.accountNumber || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Atas Nama
                </label>

                <input
                  name="accountName"
                  value="<%= wedding.gift.accountName || '' %>"
                >

              </div>


              <div class="form-group">

                <label>

                  <input
                    name="musicEnabled"
                    type="checkbox"

                    <% if (
                      wedding.music &&
                      wedding.music.enabled
                    ) { %>

                      checked

                    <% } %>

                  >

                  Aktifkan Musik

                </label>

              </div>


              <div class="form-group">

                <label>
                  URL Musik
                </label>

                <input
                  name="musicUrl"
                  type="url"
                  value="<%= wedding.music.url || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Status
                </label>

                <select
                  name="status"
                >

                  <option
                    value="draft"
                    <%= wedding.status === "draft"
                      ? "selected"
                      : "" %>
                  >
                    Draft
                  </option>

                  <option
                    value="published"
                    <%= wedding.status === "published"
                      ? "selected"
                      : "" %>
                  >
                    Published
                  </option>

                </select>

              </div>


              <button
                type="submit"
                class="button"
              >
                Simpan Perubahan
              </button>

            </form>

          </div>


        </article>


      <% }); %>


    </section>


  </main>


  <!-- =======================================================
       RSVP MODAL
  ======================================================== -->

  <div
    id="rsvp-modal"
    class="modal"
    hidden
  >

    <div class="modal-content">

      <button
        type="button"
        class="modal-close"
        onclick="closeRSVP()"
      >
        ×
      </button>


      <h2>
        Data RSVP
      </h2>


      <div
        id="rsvp-content"
      >
        Memuat data...
      </div>

    </div>

  </div>


  <script>

    /*
     * =======================================================
     * SLUG PREVIEW
     * =======================================================
     */

    const createSlug =
      document.getElementById(
        "create-slug"
      );

    const createUrl =
      document.getElementById(
        "create-url"
      );


    if (
      createSlug &&
      createUrl
    ) {

      createSlug.addEventListener(
        "input",
        function () {

          let value =
            this.value
              .toLowerCase()
              .replace(
                /[^a-z0-9-]/g,
                "-"
              )
              .replace(
                /-+/g,
                "-"
              )
              .replace(
                /^-|-$/g,
                ""
              );

          this.value =
            value;

          createUrl.textContent =
            "https://loveforever.vercel.app/" +
            value;

        }
      );

    }


    /*
     * =======================================================
     * EDIT
     * =======================================================
     */

    function toggleEdit(
      slug
    ) {

      const panel =
        document.getElementById(
          "edit-" + slug
        );

      if (!panel) {
        return;
      }

      panel.hidden =
        !panel.hidden;

      if (!panel.hidden) {

        panel.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });

      }

    }


    /*
     * =======================================================
     * DELETE CONFIRM
     * =======================================================
     */

    function confirmDelete(
      slug
    ) {

      return confirm(
        "Yakin ingin menghapus wedding \"" +
        slug +
        "\"?\n\n" +
        "Semua data invitation dan RSVP " +
        "yang terkait akan dihapus."
      );

    }


    /*
     * =======================================================
     * RSVP
     * =======================================================
     */

    async function viewRSVP(
      slug
    ) {

      const modal =
        document.getElementById(
          "rsvp-modal"
        );

      const content =
        document.getElementById(
          "rsvp-content"
        );


      modal.hidden =
        false;

      content.innerHTML =
        "Memuat data RSVP...";


      try {

        const response =
          await fetch(
            "/admin/wedding/" +
            encodeURIComponent(
              slug
            ) +
            "/rsvp"
          );


        const data =
          await response.json();


        if (
          !data.success
        ) {

          content.innerHTML =
            "<p>Gagal mengambil data RSVP.</p>";

          return;

        }


        if (
          !data.rsvps.length
        ) {

          content.innerHTML =
            "<p>Belum ada RSVP.</p>";

          return;

        }


        let html = "";

        html +=
          "<p><strong>Total RSVP:</strong> " +
          data.total +
          "</p>";


        html +=
          "<div class='rsvp-list'>";


        data.rsvps.forEach(
          function (rsvp) {

            html +=
              "<article class='rsvp-item'>";


            html +=
              "<h3>" +
              escapeHtml(
                rsvp.name
              ) +
              "</h3>";


            html +=
              "<p><strong>Kehadiran:</strong> " +
              escapeHtml(
                rsvp.attendance
              ) +
              "</p>";


            html +=
              "<p><strong>Jumlah Tamu:</strong> " +
              escapeHtml(
                rsvp.guestCount
              ) +
              "</p>";


            html +=
              "<p><strong>Pesan:</strong> " +
              escapeHtml(
                rsvp.message ||
                "-"
              ) +
              "</p>";


            html +=
              "</article>";

          }
        );


        html +=
          "</div>";


        content.innerHTML =
          html;


      } catch (
        error
      ) {

        console.error(
          error
        );

        content.innerHTML =
          "<p>Terjadi kesalahan saat mengambil RSVP.</p>";

      }

    }


    /*
     * Escape text sebelum
     * dimasukkan ke innerHTML.
     */

    function escapeHtml(
      value
    ) {

      return String(
        value ?? ""
      )
        .replace(
          /&/g,
          "&amp;"
        )
        .replace(
          /</g,
          "&lt;"
        )
        .replace(
          />/g,
          "&gt;"
        )
        .replace(
          /"/g,
          "&quot;"
        )
        .replace(
          /'/g,
          "&#039;"
        );

    }


    function closeRSVP() {

      const modal =
        document.getElementById(
          "rsvp-modal"
        );

      modal.hidden =
        true;

    }


  </script>


</body>

</html>
