<!DOCTYPE html>
<html lang="id">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="theme-color"
    content="#111111"
  >

  <title>
    Admin Dashboard — LOVEFOREVER
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <style>

    /* =========================================================
       ADMIN SAFE LAYOUT
    ========================================================= */

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: #f7f5f2;
      color: #24211f;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    a {
      color: inherit;
    }

    [hidden] {
      display: none !important;
    }


    /* =========================================================
       HEADER
    ========================================================= */

    .admin-header {
      position: sticky;
      top: 0;
      z-index: 100;

      min-height: 76px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;

      padding:
        16px
        clamp(18px, 4vw, 42px);

      background: rgba(255, 255, 255, 0.94);

      border-bottom:
        1px solid
        rgba(0, 0, 0, 0.08);

      backdrop-filter: blur(16px);
    }

    .admin-brand {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 0.14em;
    }


    /* =========================================================
       MAIN
    ========================================================= */

    .admin-main {
      width: min(
        1500px,
        calc(100% - 32px)
      );

      margin: 0 auto;

      padding:
        42px
        0
        80px;
    }

    .dashboard-title {
      margin-bottom: 30px;
    }

    .dashboard-title h1 {
      margin:
        0
        0
        10px;

      font-size:
        clamp(
          32px,
          5vw,
          58px
        );

      line-height: 1.05;

      letter-spacing:
        -0.04em;
    }

    .dashboard-title p {
      margin: 0;

      color: #77716d;

      font-size:
        clamp(
          15px,
          2vw,
          18px
        );

      line-height: 1.7;
    }


    /* =========================================================
       MESSAGE
    ========================================================= */

    #globalMessage {
      margin-bottom: 24px;
    }

    .notice {
      padding: 15px 18px;

      border-radius: 14px;

      background: #ffffff;

      border:
        1px solid
        rgba(0, 0, 0, 0.08);

      line-height: 1.6;
    }

    .notice.success {
      border-color:
        rgba(35, 120, 65, 0.25);

      background:
        rgba(35, 120, 65, 0.06);
    }

    .notice.warning {
      border-color:
        rgba(180, 110, 20, 0.28);

      background:
        rgba(180, 110, 20, 0.07);
    }

    .notice.error {
      border-color:
        rgba(180, 45, 45, 0.28);

      background:
        rgba(180, 45, 45, 0.07);
    }


    /* =========================================================
       SUMMARY
    ========================================================= */

    .summary-grid {
      display: grid;

      grid-template-columns:
        repeat(
          4,
          minmax(0, 1fr)
        );

      gap: 18px;

      margin-bottom: 30px;
    }

    .summary-card {
      min-height: 150px;

      display: flex;

      flex-direction: column;

      justify-content: space-between;

      padding: 24px;

      background: #ffffff;

      border:
        1px solid
        rgba(0, 0, 0, 0.08);

      border-radius: 20px;

      box-shadow:
        0 8px 30px
        rgba(0, 0, 0, 0.035);
    }

    .summary-card small {
      color: #77716d;

      font-size: 14px;
    }

    .summary-card strong {
      font-size: 42px;

      line-height: 1;

      letter-spacing:
        -0.04em;
    }


    /* =========================================================
       PANEL
    ========================================================= */

    .panel {
      overflow: hidden;

      margin-bottom: 28px;

      background: #ffffff;

      border:
        1px solid
        rgba(0, 0, 0, 0.08);

      border-radius: 24px;

      box-shadow:
        0 12px 40px
        rgba(0, 0, 0, 0.035);
    }

    .panel-header {
      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      padding: 24px 28px;

      border-bottom:
        1px solid
        rgba(0, 0, 0, 0.08);
    }

    .panel-header strong {
      display: block;

      margin-bottom: 5px;

      font-size: 20px;
    }

    .panel-body {
      padding: 28px;
    }

    .muted {
      color: #77716d;
    }


    /* =========================================================
       FORM
    ========================================================= */

    .form {
      width: 100%;
    }

    .form h3 {
      margin:
        28px
        0
        18px;

      font-size: 20px;
    }

    .form h3:first-child {
      margin-top: 0;
    }

    .form-grid {
      display: grid;

      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );

      gap: 18px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-grid .form-group {
      margin-bottom: 0;
    }

    .form-group label {
      display: block;

      margin-bottom: 8px;

      font-weight: 650;

      font-size: 14px;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%;

      border:
        1px solid
        rgba(0, 0, 0, 0.14);

      border-radius: 12px;

      background: #fff;

      padding:
        13px
        14px;

      color: #24211f;

      outline: none;

      transition:
        border-color .2s ease,
        box-shadow .2s ease;
    }

    .form-group textarea {
      resize: vertical;

      min-height: 100px;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
      border-color: #24211f;

      box-shadow:
        0 0 0 3px
        rgba(36, 33, 31, 0.08);
    }

    .form-group small {
      display: block;

      margin-top: 7px;

      color: #817b76;

      line-height: 1.5;
    }


    /* =========================================================
       BUTTONS
    ========================================================= */

    .button,
    button.button,
    .secondary {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      min-height: 44px;

      padding:
        11px
        17px;

      border: 0;

      border-radius: 11px;

      background: #24211f;

      color: #ffffff;

      text-decoration: none;

      cursor: pointer;

      transition:
        transform .18s ease,
        opacity .18s ease,
        background .18s ease;
    }

    .button:hover,
    .secondary:hover {
      opacity: .88;
    }

    .button:active,
    .secondary:active {
      transform: scale(.98);
    }

    .button-outline {
      background: transparent;

      color: #24211f;

      border:
        1px solid
        rgba(0, 0, 0, 0.16);
    }

    .button-danger {
      background: #a92f2f;
    }

    .button-success {
      background: #286d45;
    }

    .form-actions {
      display: flex;

      flex-wrap: wrap;

      gap: 10px;

      margin-top: 24px;
    }


    /* =========================================================
       WEDDING LIST
    ========================================================= */

    .wedding-list {
      display: grid;

      gap: 16px;
    }

    .wedding-item {
      padding: 22px;

      border:
        1px solid
        rgba(0, 0, 0, 0.08);

      border-radius: 18px;

      background: #fcfbfa;
    }

    .wedding-item-header {
      display: flex;

      align-items: flex-start;

      justify-content: space-between;

      gap: 20px;
    }

    .wedding-item h3 {
      margin:
        12px
        0
        7px;

      font-size: 22px;
    }

    .wedding-item p {
      margin:
        5px
        0;

      color: #77716d;

      line-height: 1.6;
    }

    .wedding-item code {
      display: inline-block;

      max-width: 100%;

      margin-top: 5px;

      padding: 7px 9px;

      border-radius: 8px;

      background: #f0eeeb;

      overflow-wrap: anywhere;

      font-size: 12px;
    }

    .status {
      display: inline-flex;

      align-items: center;

      min-height: 28px;

      padding:
        5px
        10px;

      border-radius: 999px;

      font-size: 12px;

      font-weight: 700;

      text-transform: uppercase;

      letter-spacing: .05em;
    }

    .status-published {
      background:
        rgba(40, 109, 69, .11);

      color: #286d45;
    }

    .status-draft {
      background:
        rgba(120, 110, 100, .12);

      color: #68615c;
    }

    .wedding-actions {
      display: flex;

      flex-wrap: wrap;

      gap: 8px;

      margin-top: 18px;
    }


    /* =========================================================
       EDIT FORM
    ========================================================= */

    .edit-panel {
      margin-top: 20px;

      padding: 24px;

      border-radius: 18px;

      background: #f7f5f2;

      border:
        1px solid
        rgba(0, 0, 0, 0.08);
    }

    .edit-panel h3 {
      margin:
        0
        0
        20px;
    }


    /* =========================================================
       RSVP TABLE
    ========================================================= */

    .table-wrapper {
      width: 100%;

      overflow-x: auto;
    }

    .data-table {
      width: 100%;

      border-collapse: collapse;

      min-width: 720px;
    }

    .data-table th,
    .data-table td {
      padding:
        13px
        14px;

      text-align: left;

      border-bottom:
        1px solid
        rgba(0, 0, 0, 0.08);

      vertical-align: top;

      line-height: 1.5;
    }

    .data-table th {
      background: #faf9f7;

      font-size: 13px;
    }

    .empty-table {
      padding: 30px !important;

      text-align: center !important;

      color: #77716d;
    }


    /* =========================================================
       MODAL
    ========================================================= */

    .modal {
      position: fixed;

      inset: 0;

      z-index: 1000;

      display: flex;

      align-items: center;

      justify-content: center;

      padding: 20px;

      background:
        rgba(0, 0, 0, .55);

      backdrop-filter: blur(5px);
    }

    .modal-content {
      width: min(
        1000px,
        100%
      );

      max-height:
        min(
          85vh,
          800px
        );

      overflow-y: auto;

      padding: 26px;

      background: #ffffff;

      border-radius: 22px;

      box-shadow:
        0 30px 80px
        rgba(0, 0, 0, .25);
    }

    .modal-header {
      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 20px;

      margin-bottom: 20px;
    }

    .modal-header h2 {
      margin: 0;
    }

    .modal-close {
      width: 42px;

      height: 42px;

      display: inline-flex;

      align-items: center;

      justify-content: center;

      border: 0;

      border-radius: 50%;

      background: #efebe7;

      cursor: pointer;

      font-size: 22px;
    }

    .rsvp-summary {
      display: grid;

      grid-template-columns:
        repeat(
          3,
          minmax(0, 1fr)
        );

      gap: 12px;

      margin-bottom: 20px;
    }

    .rsvp-summary-card {
      padding: 16px;

      border:
        1px solid
        rgba(0, 0, 0, .08);

      border-radius: 14px;

      background: #faf9f7;
    }

    .rsvp-summary-card small {
      display: block;

      color: #77716d;

      margin-bottom: 6px;
    }

    .rsvp-summary-card strong {
      font-size: 24px;
    }


    /* =========================================================
       EMPTY
    ========================================================= */

    .empty-state {
      padding: 40px 20px;

      text-align: center;

      color: #77716d;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 1000px) {

      .summary-grid {
        grid-template-columns:
          repeat(
            2,
            minmax(0, 1fr)
          );
      }

    }


    @media (max-width: 760px) {

      .admin-header {
        min-height: 64px;

        padding:
          12px
          16px;
      }

      .admin-brand {
        font-size: 18px;
      }

      .admin-main {
        width:
          calc(100% - 24px);

        padding:
          28px
          0
          60px;
      }

      .summary-grid {
        grid-template-columns: 1fr;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .panel-header,
      .panel-body {
        padding: 20px;
      }

      .wedding-item-header {
        flex-direction: column;
      }

      .wedding-actions {
        flex-direction: column;
      }

      .wedding-actions .button,
      .wedding-actions form,
      .wedding-actions form button {
        width: 100%;
      }

      .rsvp-summary {
        grid-template-columns: 1fr;
      }

      .modal-content {
        padding: 18px;

        border-radius: 18px;
      }

    }


    @media (max-width: 420px) {

      .dashboard-title h1 {
        font-size: 32px;
      }

      .summary-card {
        min-height: 125px;
      }

      .summary-card strong {
        font-size: 34px;
      }

    }

  </style>

</head>


<body>

<div class="admin-layout">


  <!-- =======================================================
       HEADER
  ======================================================== -->

  <header class="admin-header">

    <div class="admin-brand">
      LOVEFOREVER
    </div>


    <form
      method="POST"
      action="/admin/logout"
    >

      <input
        type="hidden"
        name="_csrf"
        value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
      >

      <button
        type="submit"
        class="secondary"
      >
        Logout
      </button>

    </form>

  </header>


  <!-- =======================================================
       MAIN
  ======================================================== -->

  <main class="admin-main">


    <!-- =====================================================
         TITLE
    ====================================================== -->

    <div class="dashboard-title">

      <h1>
        Admin Dashboard
      </h1>

      <p>
        Kelola wedding invitation,
        gallery, event, RSVP dan konten
        dari satu dashboard.
      </p>

    </div>


    <!-- =====================================================
         SERVER MESSAGE
    ====================================================== -->

    <div id="globalMessage">

      <% if (
        typeof message !== 'undefined' &&
        message
      ) { %>

        <div class="notice success">
          <%= message %>
        </div>

      <% } %>


      <% if (
        typeof error !== 'undefined' &&
        error
      ) { %>

        <div class="notice error">
          <%= error %>
        </div>

      <% } %>

    </div>


    <!-- =====================================================
         SAFE DATA NORMALIZATION
    ====================================================== -->

    <%
      /*
       * Jangan menggunakan:
       *
       * totalWedding
       * totalWeddings
       *
       * secara langsung.
       *
       * Semua statistik dihitung dari weddings.
       */

      const safeWeddings =
        typeof weddings !== "undefined" &&
        Array.isArray(weddings)
          ? weddings
          : [];

      const safeStats =
        typeof stats !== "undefined" &&
        stats
          ? stats
          : {};

      const totalWeddingCount =
        safeWeddings.length;

      const publishedWeddingCount =
        safeWeddings.filter(
          function (wedding) {
            return wedding &&
              wedding.status === "published";
          }
        ).length;

      const draftWeddingCount =
        safeWeddings.filter(
          function (wedding) {
            return !wedding ||
              wedding.status !== "published";
          }
        ).length;

      /*
       * RSVP total bisa berasal dari server.
       * Jika server tidak menyediakan stats.totalRsvp,
       * fallback ke stats.total.
       *
       * Jika keduanya tidak ada,
       * gunakan 0.
       */

      const totalRsvpCount =
        Number(
          safeStats.totalRsvp ??
          safeStats.totalRSVP ??
          safeStats.total ??
          0
        ) || 0;
    %>


    <!-- =====================================================
         SUMMARY
    ====================================================== -->

    <section class="summary-grid">


      <div class="summary-card">

        <small>
          Total Wedding
        </small>

        <strong>
          <%= totalWeddingCount %>
        </strong>

      </div>


      <div class="summary-card">

        <small>
          Published
        </small>

        <strong>
          <%= publishedWeddingCount %>
        </strong>

      </div>


      <div class="summary-card">

        <small>
          Draft
        </small>

        <strong>
          <%= draftWeddingCount %>
        </strong>

      </div>


      <div class="summary-card">

        <small>
          Total RSVP
        </small>

        <strong>
          <%= totalRsvpCount %>
        </strong>

      </div>

    </section>


    <!-- =====================================================
         CREATE MODE
    ====================================================== -->

    <% if (
      typeof createMode !== "undefined" &&
      createMode
    ) { %>


      <section class="panel">

        <div class="panel-header">

          <div>

            <strong>
              Buat Wedding Invitation
            </strong>

            <div class="muted">
              Slug ditentukan manual oleh Admin.
            </div>

          </div>

        </div>


        <div class="panel-body">


          <form
            method="POST"
            action="/admin/wedding/new"
            class="form"
          >

            <input
              type="hidden"
              name="_csrf"
              value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
            >


            <h3>
              Informasi Dasar
            </h3>


            <div class="form-group">

              <label>
                Custom Slug
              </label>

              <input
                type="text"
                name="slug"
                placeholder="contoh: aulia-rizky"
                pattern="[a-z0-9-]+"
                minlength="3"
                maxlength="100"
                required
              >

              <small>
                Slug menentukan URL invitation.
                Contoh:
                /aulia-rizky
              </small>

            </div>


            <div class="form-grid">


              <div class="form-group">

                <label>
                  Nama Mempelai Pria
                </label>

                <input
                  type="text"
                  name="groomName"
                  maxlength="100"
                  required
                >

              </div>


              <div class="form-group">

                <label>
                  Nama Mempelai Wanita
                </label>

                <input
                  type="text"
                  name="brideName"
                  maxlength="100"
                  required
                >

              </div>


              <div class="form-group">

                <label>
                  Nama Lengkap Pria
                </label>

                <input
                  type="text"
                  name="groomFullName"
                  maxlength="150"
                >

              </div>


              <div class="form-group">

                <label>
                  Nama Lengkap Wanita
                </label>

                <input
                  type="text"
                  name="brideFullName"
                  maxlength="150"
                >

              </div>


            </div>


            <div class="form-group">

              <label>
                Tanggal Wedding
              </label>

              <input
                type="date"
                name="weddingDate"
              >

            </div>


            <div class="form-group">

              <label>
                Quote
              </label>

              <textarea
                name="quote"
                rows="4"
                maxlength="1000"
                placeholder="Quote pernikahan..."
              ></textarea>

            </div>


            <div class="form-actions">

              <button
                type="submit"
                class="button"
              >
                Buat Wedding
              </button>


              <a
                href="/admin"
                class="button button-outline"
              >
                Batal
              </a>

            </div>


          </form>


        </div>

      </section>


    <!-- =====================================================
         EDIT MODE
    ====================================================== -->

    <% } else if (
      typeof editWedding !== "undefined" &&
      editWedding
    ) { %>


      <section class="panel">

        <div class="panel-header">

          <div>

            <strong>
              Edit Wedding
            </strong>

            <div class="muted">
              Perbarui data wedding invitation.
            </div>

          </div>

        </div>


        <div class="panel-body">


          <form
            method="POST"
            action="/admin/wedding/<%= encodeURIComponent(editWedding.slug) %>/edit"
            class="form"
          >

            <input
              type="hidden"
              name="_csrf"
              value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
            >


            <h3>
              Informasi Dasar
            </h3>


            <div class="form-group">

              <label>
                Custom Slug
              </label>

              <input
                type="text"
                name="slug"
                value="<%= editWedding.slug || '' %>"
                pattern="[a-z0-9-]+"
                minlength="3"
                maxlength="100"
                required
              >

              <small>
                Mengubah slug akan mengubah URL
                invitation.
              </small>

            </div>


            <div class="form-grid">


              <div class="form-group">

                <label>
                  Nama Mempelai Pria
                </label>

                <input
                  type="text"
                  name="groomName"
                  value="<%= editWedding.groom ? (editWedding.groom.name || '') : '' %>"
                  maxlength="100"
                  required
                >

              </div>


              <div class="form-group">

                <label>
                  Nama Mempelai Wanita
                </label>

                <input
                  type="text"
                  name="brideName"
                  value="<%= editWedding.bride ? (editWedding.bride.name || '') : '' %>"
                  maxlength="100"
                  required
                >

              </div>


              <div class="form-group">

                <label>
                  Nama Lengkap Pria
                </label>

                <input
                  type="text"
                  name="groomFullName"
                  value="<%= editWedding.groom ? (editWedding.groom.fullName || '') : '' %>"
                  maxlength="150"
                >

              </div>


              <div class="form-group">

                <label>
                  Nama Lengkap Wanita
                </label>

                <input
                  type="text"
                  name="brideFullName"
                  value="<%= editWedding.bride ? (editWedding.bride.fullName || '') : '' %>"
                  maxlength="150"
                >

              </div>


            </div>


            <div class="form-group">

              <label>
                Tanggal Wedding
              </label>

              <input
                type="date"
                name="weddingDate"
                value="<%= editWedding.date || '' %>"
              >

            </div>


            <div class="form-group">

              <label>
                Quote
              </label>

              <textarea
                name="quote"
                rows="4"
                maxlength="1000"
              ><%= editWedding.quote || '' %></textarea>

            </div>


            <div class="form-group">

              <label>
                Deskripsi
              </label>

              <textarea
                name="description"
                rows="6"
                maxlength="2000"
              ><%= editWedding.description || '' %></textarea>

            </div>


            <div class="form-group">

              <label>
                Music URL
              </label>

              <input
                type="url"
                name="musicUrl"
                value="<%= editWedding.music ? (editWedding.music.url || '') : '' %>"
                placeholder="https://..."
              >

              <small>
                Field ini dipertahankan agar kompatibel
                dengan data lama.
              </small>

            </div>


            <div class="form-group">

              <label>
                Status
              </label>

              <select
                name="status"
              >

                <option
                  value="draft"
                  <%= editWedding.status === "draft"
                    ? "selected"
                    : "" %>
                >
                  Draft
                </option>

                <option
                  value="published"
                  <%= editWedding.status === "published"
                    ? "selected"
                    : "" %>
                  >
                  Published
                </option>

              </select>

            </div>


            <div class="form-actions">

              <button
                type="submit"
                class="button"
              >
                Simpan Perubahan
              </button>


              <a
                href="/admin"
                class="button button-outline"
              >
                Batal
              </a>

            </div>


          </form>


        </div>

      </section>


    <!-- =====================================================
         RSVP MODE
    ====================================================== -->

    <% } else if (
      typeof rsvpWedding !== "undefined" &&
      rsvpWedding
    ) { %>


      <section class="panel">

        <div class="panel-header">

          <div>

            <strong>
              Data RSVP
            </strong>

            <div class="muted">

              <%= rsvpWedding.groom
                ? (rsvpWedding.groom.name || "Groom")
                : "Groom" %>

              &

              <%= rsvpWedding.bride
                ? (rsvpWedding.bride.name || "Bride")
                : "Bride" %>

            </div>

          </div>


          <a
            href="/admin"
            class="button button-outline"
          >
            ← Kembali
          </a>

        </div>


        <div class="panel-body">


          <%
            const safeRsvps =
              typeof rsvps !== "undefined" &&
              Array.isArray(rsvps)
                ? rsvps
                : [];

            const hadirCount =
              safeRsvps.filter(
                function (item) {
                  return item &&
                    item.attendance === "hadir";
                }
              ).length;

            const tidakHadirCount =
              safeRsvps.filter(
                function (item) {
                  return item &&
                    item.attendance === "tidak_hadir";
                }
              ).length;

            const menentukanCount =
              safeRsvps.filter(
                function (item) {
                  return item &&
                    item.attendance === "masih_menentukan";
                }
              ).length;
          %>


          <div class="rsvp-summary">


            <div class="rsvp-summary-card">

              <small>
                Total RSVP
              </small>

              <strong>
                <%= safeRsvps.length %>
              </strong>

            </div>


            <div class="rsvp-summary-card">

              <small>
                Hadir
              </small>

              <strong>
                <%= hadirCount %>
              </strong>

            </div>


            <div class="rsvp-summary-card">

              <small>
                Belum Pasti
              </small>

              <strong>
                <%= menentukanCount %>
              </strong>

            </div>


          </div>


          <div class="table-wrapper">

            <table class="data-table">

              <thead>

                <tr>

                  <th>
                    Nama
                  </th>

                  <th>
                    Kehadiran
                  </th>

                  <th>
                    Jumlah Tamu
                  </th>

                  <th>
                    Pesan
                  </th>

                  <th>
                    Waktu
                  </th>

                </tr>

              </thead>


              <tbody>


                <% if (!safeRsvps.length) { %>

                  <tr>

                    <td
                      colspan="5"
                      class="empty-table"
                    >
                      Belum ada RSVP.
                    </td>

                  </tr>

                <% } else { %>


                  <% safeRsvps.forEach(
                    function (rsvp) {
                  { %>

                    <tr>

                      <td>
                        <%= rsvp.name || "-" %>
                      </td>

                      <td>
                        <%= rsvp.attendance || "-" %>
                      </td>

                      <td>
                        <%= rsvp.guestCount || 0 %>
                      </td>

                      <td>
                        <%= rsvp.message || "-" %>
                      </td>

                      <td>
                        <%= rsvp.createdAt || "-" %>
                      </td>

                    </tr>

                  <% }); %>


                <% } %>


              </tbody>

            </table>

          </div>


        </div>

      </section>


    <!-- =====================================================
         NORMAL DASHBOARD
    ====================================================== -->

    <% } else { %>


      <section class="panel">

        <div class="panel-header">

          <div>

            <strong>
              Daftar Wedding
            </strong>

            <div class="muted">
              Semua invitation yang tersimpan.
            </div>

          </div>


          <a
            href="/admin/wedding/new"
            class="button"
          >
            + Buat Wedding
          </a>

        </div>


        <div class="panel-body">


          <% if (!safeWeddings.length) { %>


            <div class="empty-state">

              <p>
                Belum ada wedding invitation.
              </p>


              <a
                href="/admin/wedding/new"
                class="button"
              >
                Buat Wedding Pertama
              </a>

            </div>


          <% } else { %>


            <div class="wedding-list">


              <% safeWeddings.forEach(
                function (wedding) {
              { %>


                <article
                  class="wedding-item"
                >


                  <div
                    class="wedding-item-header"
                  >


                    <div>


                      <span
                        class="status status-<%= wedding.status === 'published' ? 'published' : 'draft' %>"
                      >
                        <%= wedding.status || "draft" %>
                      </span>


                      <h3>

                        <%= wedding.groom
                          ? (wedding.groom.name || "Groom")
                          : "Groom" %>

                        &

                        <%= wedding.bride
                          ? (wedding.bride.name || "Bride")
                          : "Bride" %>

                      </h3>


                      <p>

                        Slug:

                        <strong>
                          <%= wedding.slug %>
                        </strong>

                      </p>


                      <p>

                        URL:

                        <br>

                        <code>
                          https://loveforever.vercel.app/<%= wedding.slug %>
                        </code>

                      </p>


                      <p>

                        Personalized:

                        <br>

                        <code>
                          https://loveforever.vercel.app/<%= wedding.slug %>?to=Nama%20Tamu
                        </code>

                      </p>


                    </div>


                  </div>


                  <div
                    class="wedding-actions"
                  >


                    <!-- VIEW -->

                    <a
                      href="/<%= encodeURIComponent(wedding.slug) %>"
                      class="button"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Lihat Invitation
                    </a>


                    <!-- EDIT -->

                    <a
                      href="/admin/wedding/<%= encodeURIComponent(wedding.slug) %>/edit"
                      class="button button-outline"
                    >
                      Edit
                    </a>


                    <!-- RSVP -->

                    <button
                      type="button"
                      class="button button-outline"
                      onclick="viewRSVP('<%= wedding.slug %>')"
                    >
                      Lihat RSVP
                    </button>


                    <!-- PUBLISH / UNPUBLISH -->

                    <% if (
                      wedding.status === "published"
                    ) { %>


                      <form
                        method="POST"
                        action="/admin/wedding/<%= encodeURIComponent(wedding.slug) %>/unpublish"
                        onsubmit="return confirmUnpublish('<%= wedding.slug %>')"
                      >

                        <input
                          type="hidden"
                          name="_csrf"
                          value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
                        >

                        <button
                          type="submit"
                          class="button button-outline"
                        >
                          Unpublish
                        </button>

                      </form>


                    <% } else { %>


                      <form
                        method="POST"
                        action="/admin/wedding/<%= encodeURIComponent(wedding.slug) %>/publish"
                        onsubmit="return confirmPublish('<%= wedding.slug %>')"
                      >

                        <input
                          type="hidden"
                          name="_csrf"
                          value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
                        >

                        <button
                          type="submit"
                          class="button button-success"
                        >
                          Publish
                        </button>

                      </form>


                    <% } %>


                    <!-- DELETE -->

                    <form
                      method="POST"
                      action="/admin/wedding/<%= encodeURIComponent(wedding.slug) %>/delete"
                      onsubmit="return confirmDelete('<%= wedding.slug %>')"
                    >

                      <input
                        type="hidden"
                        name="_csrf"
                        value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
                      >

                      <button
                        type="submit"
                        class="button button-danger"
                      >
                        Hapus
                      </button>

                    </form>


                  </div>


                </article>


              <% }); %>


            </div>


          <% } %>


        </div>

      </section>


    <% } %>


  </main>


  <!-- =======================================================
       RSVP MODAL
  ======================================================== -->

  <div
    id="rsvpModal"
    class="modal"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="rsvpModalTitle"
  >


    <div class="modal-content">


      <div class="modal-header">


        <h2
          id="rsvpModalTitle"
        >
          Data RSVP
        </h2>


        <button
          type="button"
          class="modal-close"
          onclick="closeRsvpModal()"
          aria-label="Tutup"
        >
          ×
        </button>


      </div>


      <div
        id="rsvpContent"
      >
        <p>
          Memuat data RSVP...
        </p>
      </div>


    </div>

  </div>


  <script>

    /* =========================================================
       GLOBAL CONFIG
    ========================================================= */

    const csrfToken =
      <%- JSON.stringify(
        typeof csrfToken !== "undefined"
          ? csrfToken
          : ""
      ) %>;


    /* =========================================================
       MESSAGE
    ========================================================= */

    function showMessage(
      message,
      type = "success"
    ) {

      const container =
        document.getElementById(
          "globalMessage"
        );

      if (!container) {
        return;
      }


      container.innerHTML =
        "";


      const notice =
        document.createElement(
          "div"
        );

      notice.className =
        "notice " +
        type;


      notice.textContent =
        String(
          message || ""
        );


      container.appendChild(
        notice
      );

    }


    /* =========================================================
       CONFIRM PUBLISH
    ========================================================= */

    function confirmPublish(
      slug
    ) {

      return window.confirm(
        "Publish wedding \"" +
        slug +
        "\"?"
      );

    }


    /* =========================================================
       CONFIRM UNPUBLISH
    ========================================================= */

    function confirmUnpublish(
      slug
    ) {

      return window.confirm(
        "Unpublish wedding \"" +
        slug +
        "\"?"
      );

    }


    /* =========================================================
       CONFIRM DELETE
    ========================================================= */

    function confirmDelete(
      slug
    ) {

      return window.confirm(
        "Yakin ingin menghapus wedding \"" +
        slug +
        "\"?\n\n" +
        "Data wedding akan dihapus dari Redis.\n" +
        "Data RSVP terkait juga sebaiknya " +
        "ditangani oleh server."
      );

    }


    /* =========================================================
       RSVP
    ========================================================= */

    async function viewRSVP(
      slug
    ) {

      const modal =
        document.getElementById(
          "rsvpModal"
        );

      const content =
        document.getElementById(
          "rsvpContent"
        );


      if (!modal || !content) {
        return;
      }


      modal.hidden =
        false;


      content.innerHTML =
        "<p>Memuat data RSVP...</p>";


      try {

        const response =
          await fetch(
            "/admin/wedding/" +
            encodeURIComponent(
              slug
            ) +
            "/rsvp",
            {
              method: "GET",
              headers: {
                "Accept":
                  "application/json"
              },
              credentials:
                "same-origin"
            }
          );


        const contentType =
          response.headers.get(
            "content-type"
          ) || "";


        /*
         * BUG PREVENTION:
         *
         * Jangan langsung response.json().
         *
         * Jika server mengembalikan
         * HTML login/error page,
         * response.json() akan menghasilkan:
         *
         * Unexpected token '<'
         */

        if (
          !contentType.includes(
            "application/json"
          )
        ) {

          if (
            response.status === 401 ||
            response.status === 403
          ) {

            throw new Error(
              "Sesi Admin sudah tidak valid. Silakan login kembali."
            );

          }

          throw new Error(
            "Server mengembalikan response bukan JSON."
          );

        }


        const result =
          await response.json();


        if (
          !response.ok ||
          !result.success
        ) {

          throw new Error(
            result.message ||
            "Gagal mengambil data RSVP."
          );

        }


        const safeRsvps =
          Array.isArray(
            result.rsvps
          )
            ? result.rsvps
            : [];


        if (!safeRsvps.length) {

          content.innerHTML = `
            <div class="notice">
              Belum ada RSVP.
            </div>
          `;

          return;

        }


        const total =
          Number(
            result.total ??
            safeRsvps.length
          ) || 0;


        const hadir =
          safeRsvps.filter(
            item =>
              item &&
              item.attendance === "hadir"
          ).length;


        const tidakHadir =
          safeRsvps.filter(
            item =>
              item &&
              item.attendance === "tidak_hadir"
          ).length;


        const masihMenentukan =
          safeRsvps.filter(
            item =>
              item &&
              item.attendance ===
                "masih_menentukan"
          ).length;


        const rows =
          safeRsvps
            .map(
              function (item) {

                return `

                  <tr>

                    <td>
                      ${escapeHtml(
                        item.name
                      )}
                    </td>

                    <td>
                      ${escapeHtml(
                        formatAttendance(
                          item.attendance
                        )
                      )}
                    </td>

                    <td>
                      ${escapeHtml(
                        item.guestCount
                      )}
                    </td>

                    <td>
                      ${escapeHtml(
                        item.message ||
                        "-"
                      )}
                    </td>

                    <td>
                      ${escapeHtml(
                        item.createdAt ||
                        "-"
                      )}
                    </td>

                  </tr>

                `;

              }
            )
            .join("");


        content.innerHTML = `

          <div class="rsvp-summary">

            <div class="rsvp-summary-card">

              <small>
                Total
              </small>

              <strong>
                ${total}
              </strong>

            </div>


            <div class="rsvp-summary-card">

              <small>
                Hadir
              </small>

              <strong>
                ${hadir}
              </strong>

            </div>


            <div class="rsvp-summary-card">

              <small>
                Tidak Hadir
              </small>

              <strong>
                ${tidakHadir}
              </strong>

            </div>

          </div>


          <div class="notice">

            Masih menentukan:
            <strong>
              ${masihMenentukan}
            </strong>

          </div>


          <br>


          <div class="table-wrapper">

            <table class="data-table">

              <thead>

                <tr>

                  <th>
                    Nama
                  </th>

                  <th>
                    Kehadiran
                  </th>

                  <th>
                    Tamu
                  </th>

                  <th>
                    Pesan
                  </th>

                  <th>
                    Waktu
                  </th>

                </tr>

              </thead>


              <tbody>
                ${rows}
              </tbody>

            </table>

          </div>

        `;


      } catch (error) {

        console.error(
          "RSVP error:",
          error
        );


        content.innerHTML = `

          <div class="notice error">

            ${escapeHtml(
              error.message ||
              "Terjadi kesalahan."
            )}

          </div>

        `;

      }

    }


    /* =========================================================
       ATTENDANCE FORMAT
    ========================================================= */

    function formatAttendance(
      value
    ) {

      switch (value) {

        case "hadir":
          return "Hadir";

        case "tidak_hadir":
          return "Tidak Hadir";

        case "masih_menentukan":
          return "Masih Menentukan";

        default:
          return value || "-";

      }

    }


    /* =========================================================
       ESCAPE HTML
    ========================================================= */

    function escapeHtml(
      value
    ) {

      return String(
        value ?? ""
      )

        .replace(
          /&/g,
          "&amp;"
        )

        .replace(
          /</g,
          "&lt;"
        )

        .replace(
          />/g,
          "&gt;"
        )

        .replace(
          /"/g,
          "&quot;"
        )

        .replace(
          /'/g,
          "&#039;"
        );

    }


    /* =========================================================
       CLOSE RSVP
    ========================================================= */

    function closeRsvpModal() {

      const modal =
        document.getElementById(
          "rsvpModal"
        );


      if (!modal) {
        return;
      }


      modal.hidden =
        true;

    }


    /* =========================================================
       BACKDROP CLICK
    ========================================================= */

    const rsvpModal =
      document.getElementById(
        "rsvpModal"
      );


    if (rsvpModal) {

      rsvpModal.addEventListener(
        "click",
        function (event) {

          if (
            event.target ===
            rsvpModal
          ) {

            closeRsvpModal();

          }

        }
      );

    }


    /* =========================================================
       ESC KEY
    ========================================================= */

    document.addEventListener(
      "keydown",
      function (event) {

        if (
          event.key === "Escape"
        ) {

          closeRsvpModal();

        }

      }
    );


  </script>


</div>

</body>

</html>
