}


/* =========================================================
   COLLECT DYNAMIC LIST
========================================================= */

function collectDynamicList(
  container,
  className
) {

  const result = [];

  container
    .querySelectorAll(
      "." +
      className
    )
    .forEach(
      function(item) {

        const object = {};

        item
          .querySelectorAll(
            "[data-field]"
          )
          .forEach(
            function(field) {

              object[
                field.dataset.field
              ] =
                field.value;

            }
          );

        result.push(
          object
        );

      }
    );

  return result;

}


