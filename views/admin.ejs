/* =========================================================
   CREATE
========================================================= */

document
  .getElementById(
    "createWeddingForm"
  )
  .addEventListener(
    "submit",
    async event => {

      event.preventDefault();

      const payload =
        collectForm();

      if (
        !payload.slug.trim()
      ) {

        showMessage(
          "Slug wajib diisi.",
          "warning"
        );

        return;

      }

      try {

        const response =
          await fetch(
            "/admin/wedding/new",
            {
              method:
                "POST",

              headers: {
                "Content-Type":
                  "application/json",

                "X-CSRF-Token":
                  CSRF_TOKEN
              },

              body:
                JSON.stringify(
                  payload
                )
            }
          );

        const result =
          await response.json();

        if (
          !response.ok ||
          !result.success
        ) {

          throw new Error(
            result.message ||
            "Gagal menyimpan."
          );

        }

        showMessage(
          result.message
        );

        setTimeout(
          () => {
            location.reload();
          },
          800
        );

      } catch (error) {

        showMessage(
          error.message,
          "warning"
        );

      }

    }
  );


/* =========================================================
   EDIT WEDDING
========================================================= */

async function editWedding(
  slug
) {

  try {

    const response =
      await fetch(
        `/admin/wedding/${encodeURIComponent(slug)}/rsvp`
      );

    /*
      Endpoint RSVP hanya digunakan
      sebagai pengecekan bahwa wedding
      ada.

      Untuk menjaga struktur sederhana,
      data wedding akan diambil dari
      server melalui endpoint khusus
      di bawah.
    */

    if (!response.ok) {
      throw new Error(
        "Wedding tidak ditemukan."
      );
    }

    const data =
      await fetchWeddingForEdit(
        slug
      );

    openEditForm(
      data
    );

  } catch (error) {

    showMessage(
      error.message,
      "warning"
    );

  }

}


/* =========================================================
   FETCH WEDDING FOR EDIT
========================================================= */

async function fetchWeddingForEdit(
  slug
) {

  const response =
    await fetch(
      `/admin/wedding/${encodeURIComponent(slug)}/data`
    );

  const result =
    await response.json();

  if (
    !response.ok ||
    !result.success
  ) {

    throw new Error(
      result.message ||
      "Gagal mengambil data."
    );

  }

  return result.wedding;

}


