<!DOCTYPE html>
<html lang="id">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Admin Dashboard — LOVEFOREVER
  </title>


  <link
    rel="stylesheet"
    href="/css/style.css"
  >

</head>


<body>


  <main class="admin-container">


    <!-- ==================================================
         HEADER
    =================================================== -->

    <header class="admin-header">


      <div>

        <p class="eyebrow">
          LOVEFOREVER
        </p>


        <h1>
          Admin Dashboard
        </h1>


        <p>
          Kelola wedding invitation
          dari satu dashboard.
        </p>

      </div>


      <div>

        <span>

          Login sebagai:

          <strong>
            <%= admin.username %>
          </strong>

        </span>


        <form
          method="POST"
          action="/admin/logout"
          style="display:inline;"
        >

          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >


          <button
            type="submit"
            class="button"
          >
            Logout
          </button>


        </form>


      </div>


    </header>


    <!-- ==================================================
         ALERT
    =================================================== -->

    <% if (message) { %>

      <div
        class="alert alert-success"
        role="alert"
      >

        <%= message %>

      </div>

    <% } %>


    <% if (error) { %>

      <div
        class="alert alert-error"
        role="alert"
      >

        <%= error %>

      </div>

    <% } %>


    <!-- ==================================================
         STATISTICS
    =================================================== -->

    <section
      class="dashboard-stats"
    >


      <div class="stat-card">

        <span>
          Total Wedding
        </span>

        <strong>
          <%= stats.totalWeddings %>
        </strong>

      </div>


      <div class="stat-card">

        <span>
          Published
        </span>

        <strong>
          <%= stats.publishedWeddings %>
        </strong>

      </div>


      <div class="stat-card">

        <span>
          Draft
        </span>

        <strong>
          <%= stats.draftWeddings %>
        </strong>

      </div>


      <div class="stat-card">

        <span>
          Total RSVP
        </span>

        <strong>
          <%= stats.totalRsvp %>
        </strong>

      </div>


    </section>


    <!-- ==================================================
         CREATE WEDDING
    =================================================== -->

    <section class="admin-card">


      <div class="card-header">

        <div>

          <p class="eyebrow">
            NEW INVITATION
          </p>


          <h2>
            Buat Wedding Baru
          </h2>

        </div>

      </div>


      <form
        method="POST"
        action="/admin/wedding/create"
        class="form"
      >


        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >


        <!-- SLUG -->

        <div class="form-group">


          <label for="create-slug">
            Slug
          </label>


          <input
            id="create-slug"
            name="slug"
            type="text"
            placeholder="contoh: aulia-rizky"
            pattern="[a-z0-9-]+"
            minlength="3"
            maxlength="100"
            required
          >


          <small>
            Slug ditentukan sendiri oleh Admin.
          </small>


          <div
            id="create-url"
            class="url-preview"
          >
            <%= baseUrl %>/
          </div>


        </div>


        <!-- BRIDE -->

        <h3>
          Mempelai Wanita
        </h3>


        <div class="form-group">

          <label>
            Nama
          </label>

          <input
            name="brideName"
            type="text"
            placeholder="Aulia"
            required
          >

        </div>


        <div class="form-group">

          <label>
            Nama Lengkap
          </label>

          <input
            name="brideFullName"
            type="text"
          >

        </div>


        <div class="form-group">

          <label>
            Nama Ayah
          </label>

          <input
            name="brideFather"
            type="text"
          >

        </div>


        <div class="form-group">

          <label>
            Nama Ibu
          </label>

          <input
            name="brideMother"
            type="text"
          >

        </div>


        <div class="form-group">

          <label>
            URL Foto
          </label>

          <input
            name="bridePhoto"
            type="url"
            placeholder="https://..."
          >

        </div>


        <!-- GROOM -->

        <h3>
          Mempelai Pria
        </h3>


        <div class="form-group">

          <label>
            Nama
          </label>

          <input
            name="groomName"
            type="text"
            placeholder="Rizky"
            required
          >

        </div>


        <div class="form-group">

          <label>
            Nama Lengkap
          </label>

          <input
            name="groomFullName"
            type="text"
          >

        </div>


        <div class="form-group">

          <label>
            Nama Ayah
          </label>

          <input
            name="groomFather"
            type="text"
          >

        </div>


        <div class="form-group">

          <label>
            Nama Ibu
          </label>

          <input
            name="groomMother"
            type="text"
          >

        </div>


        <div class="form-group">

          <label>
            URL Foto
          </label>

          <input
            name="groomPhoto"
            type="url"
            placeholder="https://..."
          >

        </div>


        <!-- BASIC INFORMATION -->

        <h3>
          Informasi Pernikahan
        </h3>


        <div class="form-group">

          <label>
            Tanggal
          </label>

          <input
            name="date"
            type="text"
            placeholder="Sabtu, 20 Juni 2026"
          >

        </div>


        <div class="form-group">

          <label>
            Deskripsi
          </label>

          <textarea
            name="description"
            rows="5"
            placeholder="Deskripsi singkat..."
          ></textarea>

        </div>


        <div class="form-group">

          <label>
            Quote
          </label>

          <textarea
            name="quote"
            rows="3"
            placeholder="Quote pernikahan..."
          ></textarea>

        </div>


        <!-- MUSIC -->

        <h3>
          Music
        </h3>


        <div class="form-group">

          <label>

            <input
              type="checkbox"
              name="musicEnabled"
            >

            Aktifkan musik

          </label>

        </div>


        <div class="form-group">

          <label>
            URL Musik
          </label>

          <input
            name="musicUrl"
            type="url"
            placeholder="https://..."
          >

        </div>


        <!-- STATUS -->

        <div class="form-group">

          <label>
            Status
          </label>


          <select
            name="status"
          >

            <option value="draft">
              Draft
            </option>

            <option value="published">
              Published
            </option>

          </select>


        </div>


        <button
          type="submit"
          class="button"
        >
          + Buat Wedding Invitation
        </button>


      </form>


    </section>


    <!-- ==================================================
         WEDDING LIST
    =================================================== -->

    <section class="admin-card">


      <div class="card-header">

        <div>

          <p class="eyebrow">
            INVITATIONS
          </p>


          <h2>
            Daftar Wedding
          </h2>

        </div>

      </div>


      <% if (
        !weddings ||
        weddings.length === 0
      ) { %>


        <div class="empty-state">

          <p>
            Belum ada wedding invitation.
          </p>

        </div>


      <% } %>


      <% weddings.forEach(
        function(wedding)
      { %>


        <article
          class="wedding-admin-item"
        >


          <div>


            <span
              class="status status-<%= wedding.status %>"
            >

              <%= wedding.status %>

            </span>


            <h3>

              <%= wedding.groom.name || "Groom" %>

              &

              <%= wedding.bride.name || "Bride" %>

            </h3>


            <p>

              Slug:

              <strong>
                <%= wedding.slug %>
              </strong>

            </p>


            <!-- DYNAMIC URL -->

            <p>

              Link Invitation:

              <br>

              <a
                href="<%= wedding.invitationUrl %>"
                target="_blank"
                rel="noopener noreferrer"
              >

                <%= wedding.invitationUrl %>

              </a>

            </p>


            <p>

              Contoh personalized link:

              <br>

              <code>
                <%= wedding.invitationUrl %>?to=Nama%20Tamu
              </code>

            </p>


          </div>


          <div class="admin-actions">


            <!-- PUBLISH -->

            <form
              method="POST"
              action="/admin/wedding/status"
            >

              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >


              <input
                type="hidden"
                name="slug"
                value="<%= wedding.slug %>"
              >


              <button
                type="submit"
                class="button"
              >

                <% if (
                  wedding.status ===
                  "published"
                ) { %>

                  Unpublish

                <% } else { %>

                  Publish

                <% } %>

              </button>


            </form>


            <!-- RSVP -->

            <button
              type="button"
              class="button"
              onclick="viewRSVP('<%= wedding.slug %>')"
            >
              Lihat RSVP
            </button>


            <!-- EDIT -->

            <button
              type="button"
              class="button"
              onclick="toggleEdit('<%= wedding.slug %>')"
            >
              Edit
            </button>


            <!-- DELETE -->

            <form
              method="POST"
              action="/admin/wedding/delete"
              onsubmit="return confirmDelete('<%= wedding.slug %>')"
            >

              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >


              <input
                type="hidden"
                name="slug"
                value="<%= wedding.slug %>"
              >


              <button
                type="submit"
                class="button button-danger"
              >
                Hapus
              </button>


            </form>


          </div>


          <!-- =================================================
               EDIT
          ================================================== -->

          <div
            id="edit-<%= wedding.slug %>"
            class="edit-panel"
            hidden
          >


            <h3>
              Edit Wedding
            </h3>


            <form
              method="POST"
              action="/admin/wedding/update"
              class="form"
            >


              <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
              >


              <input
                type="hidden"
                name="slug"
                value="<%= wedding.slug %>"
              >


              <div class="form-group">

                <label>
                  Slug
                </label>

                <input
                  type="text"
                  value="<%= wedding.slug %>"
                  disabled
                >

              </div>


              <div class="form-group">

                <label>
                  Bride
                </label>

                <input
                  name="brideName"
                  value="<%= wedding.bride.name || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Bride Full Name
                </label>

                <input
                  name="brideFullName"
                  value="<%= wedding.bride.fullName || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Bride Father
                </label>

                <input
                  name="brideFather"
                  value="<%= wedding.bride.father || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Bride Mother
                </label>

                <input
                  name="brideMother"
                  value="<%= wedding.bride.mother || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Bride Photo
                </label>

                <input
                  name="bridePhoto"
                  type="url"
                  value="<%= wedding.bride.photo || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Groom
                </label>

                <input
                  name="groomName"
                  value="<%= wedding.groom.name || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Groom Full Name
                </label>

                <input
                  name="groomFullName"
                  value="<%= wedding.groom.fullName || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Groom Father
                </label>

                <input
                  name="groomFather"
                  value="<%= wedding.groom.father || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Groom Mother
                </label>

                <input
                  name="groomMother"
                  value="<%= wedding.groom.mother || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Groom Photo
                </label>

                <input
                  name="groomPhoto"
                  type="url"
                  value="<%= wedding.groom.photo || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Tanggal
                </label>

                <input
                  name="date"
                  value="<%= wedding.date || '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Deskripsi
                </label>

                <textarea
                  name="description"
                  rows="4"
                ><%= wedding.description || '' %></textarea>

              </div>


              <div class="form-group">

                <label>
                  Quote
                </label>

                <textarea
                  name="quote"
                  rows="3"
                ><%= wedding.quote || '' %></textarea>

              </div>


              <div class="form-group">

                <label>

                  <input
                    type="checkbox"
                    name="musicEnabled"

                    <% if (
                      wedding.music &&
                      wedding.music.enabled
                    ) { %>

                      checked

                    <% } %>

                  >

                  Aktifkan Musik

                </label>

              </div>


              <div class="form-group">

                <label>
                  URL Musik
                </label>

                <input
                  name="musicUrl"
                  type="url"
                  value="<%= wedding.music ? wedding.music.url || '' : '' %>"
                >

              </div>


              <div class="form-group">

                <label>
                  Status
                </label>

                <select
                  name="status"
                >

                  <option
                    value="draft"
                    <%= wedding.status === "draft"
                      ? "selected"
                      : "" %>
                  >
                    Draft
                  </option>


                  <option
                    value="published"
                    <%= wedding.status === "published"
                      ? "selected"
                      : "" %>
                  >
                    Published
                  </option>

                </select>

              </div>


              <button
                type="submit"
                class="button"
              >
                Simpan Perubahan
              </button>


            </form>


          </div>


        </article>


      <% }); %>


    </section>


  </main>


  <!-- =====================================================
       RSVP MODAL
  ====================================================== -->

  <div
    id="rsvp-modal"
    class="modal"
    hidden
  >


    <div
      class="modal-content"
    >


      <button
        type="button"
        class="modal-close"
        onclick="closeRSVP()"
      >
        ×
      </button>


      <h2>
        Data RSVP
      </h2>


      <div
        id="rsvp-content"
      >
        Memuat data...
      </div>


    </div>


  </div>


  <script>

    /*
    |--------------------------------------------------------------------------
    | DYNAMIC DOMAIN PREVIEW
    |--------------------------------------------------------------------------
    */

    const createSlug =
      document.getElementById(
        "create-slug"
      );

    const createUrl =
      document.getElementById(
        "create-url"
      );


    if (
      createSlug &&
      createUrl
    ) {

      createSlug.addEventListener(
        "input",
        function () {

          let value =
            this.value
              .toLowerCase()
              .replace(
                /[^a-z0-9-]/g,
                "-"
              )
              .replace(
                /-+/g,
                "-"
              )
              .replace(
                /^-|-$/g,
                ""
              );

          this.value =
            value;


          createUrl.textContent =
            "<%= baseUrl %>/" +
            value;

        }
      );

    }


    /*
    |--------------------------------------------------------------------------
    | EDIT
    |--------------------------------------------------------------------------
    */

    function toggleEdit(
      slug
    ) {

      const panel =
        document.getElementById(
          "edit-" + slug
        );

      if (!panel) {
        return;
      }

      panel.hidden =
        !panel.hidden;


      if (!panel.hidden) {

        panel.scrollIntoView({
          behavior:
            "smooth",

          block:
            "start",
        });

      }

    }


    /*
    |--------------------------------------------------------------------------
    | DELETE
    |--------------------------------------------------------------------------
    */

    function confirmDelete(
      slug
    ) {

      return confirm(
        "Yakin ingin menghapus wedding \"" +
        slug +
        "\"?\n\n" +
        "Data invitation dan RSVP terkait akan dihapus."
      );

    }


    /*
    |--------------------------------------------------------------------------
    | RSVP
    |--------------------------------------------------------------------------
    */

    async function viewRSVP(
      slug
    ) {

      const modal =
        document.getElementById(
          "rsvp-modal"
        );

      const content =
        document.getElementById(
          "rsvp-content"
        );


      modal.hidden =
        false;


      content.textContent =
        "Memuat data RSVP...";


      try {

        const response =
          await fetch(
            "/admin/wedding/" +
              encodeURIComponent(
                slug
              ) +
              "/rsvp"
          );


        const data =
          await response.json();


        if (
          !data.success
        ) {

          content.textContent =
            data.message ||
            "Gagal mengambil RSVP.";

          return;

        }


        if (
          !data.rsvps.length
        ) {

          content.textContent =
            "Belum ada RSVP.";

          return;

        }


        content.innerHTML =
          "";


        const title =
          document.createElement(
            "p"
          );

        title.textContent =
          "Total RSVP: " +
          data.total;


        content.appendChild(
          title
        );


        data.rsvps.forEach(
          function(rsvp) {

            const article =
              document.createElement(
                "article"
              );

            article.className =
              "rsvp-item";


            const name =
              document.createElement(
                "h3"
              );

            name.textContent =
              rsvp.name;


            const attendance =
              document.createElement(
                "p"
              );

            attendance.textContent =
              "Kehadiran: " +
              rsvp.attendance;


            const guestCount =
              document.createElement(
                "p"
              );

            guestCount.textContent =
              "Jumlah Tamu: " +
              rsvp.guestCount;


            const message =
              document.createElement(
                "p"
              );

            message.textContent =
              "Pesan: " +
              (
                rsvp.message ||
                "-"
              );


            article.appendChild(
              name
            );

            article.appendChild(
              attendance
            );

            article.appendChild(
              guestCount
            );

            article.appendChild(
              message
            );


            content.appendChild(
              article
            );

          }
        );


      } catch (error) {

        console.error(
          error
        );

        content.textContent =
          "Terjadi kesalahan saat mengambil RSVP.";

      }

    }


    function closeRSVP() {

      const modal =
        document.getElementById(
          "rsvp-modal"
        );

      modal.hidden =
        true;

    }

  </script>


</body>

</html>
