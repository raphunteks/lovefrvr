                  data-media-role="gallery"
                  data-media-slug="<%= wedding.slug %>"
                >

                <small class="muted">
                  Maksimal 15 gambar per wedding.
                </small>

              </div>


              <!-- =================================================
                   MUSIC
              ================================================== -->

              <div class="section-title">

                <h3>
                  Music MP3
                </h3>

              </div>


              <div class="media-box">


                <% if (
                  wedding.music?.mediaId
                ) { %>

                  <audio
                    controls
                    preload="none"
                    style="width:100%;margin:10px 0"
                    src="/media/<%= encodeURIComponent(wedding.slug) %>/<%= encodeURIComponent(wedding.music.mediaId) %>"
                  ></audio>

                  <p class="muted">
                    <%= wedding.music.name || "Wedding Music" %>
                  </p>

                <% } %>


                <input
                  type="file"
                  accept="audio/mpeg,audio/mp3"
                  data-media-role="music"
                  data-media-slug="<%= wedding.slug %>"
                >

                <small class="muted">
                  MP3 maksimal 8 MB.
                  File akan disimpan sebagai Base64 di Upstash Redis.
                </small>

              </div>


              <!-- =================================================
                   EVENTS
              ================================================== -->

              <div class="section-title">

                <h3>
                  Detail Acara
                </h3>

              </div>


              <div
                class="dynamic-list events-list"
                data-slug="<%= wedding.slug %>"
              >


                <% (wedding.events || []).forEach(
                  function(event, index)
                { %>


                  <div class="dynamic-item event-item">


                    <div class="dynamic-item-header">

                      <strong>
                        Acara #<%= index + 1 %>
                      </strong>

                      <button
                        type="button"
                        class="danger small"
                        onclick="this.closest('.event-item').remove()"
                      >
                        Hapus
                      </button>

                    </div>


                    <div class="form-grid">


                      <div class="form-group">

                        <label>
                          Type
                        </label>

                        <input
                          data-field="type"
                          value="<%= event.type || "" %>"
                          placeholder="Akad / Resepsi"
                        >

                      </div>


                      <div class="form-group">

                        <label>
                          Judul
                        </label>

                        <input
                          data-field="title"
                          value="<%= event.title || "" %>"
                        >

                      </div>


                      <div class="form-group">

                        <label>
                          Tanggal
                        </label>

                        <input
                          data-field="date"
                          value="<%= event.date || "" %>"
                        >

                      </div>


                      <div class="form-group">

                        <label>
                          Jam Mulai
                        </label>

                        <input
                          data-field="startTime"
                          value="<%= event.startTime || "" %>"
                        >

                      </div>


                      <div class="form-group">

                        <label>
                          Jam Selesai
                        </label>

                        <input
                          data-field="endTime"
                          value="<%= event.endTime || "" %>"
                        >

                      </div>


                      <div class="form-group">

                        <label>
                          Venue
                        </label>

                        <input
                          data-field="venue"
                          value="<%= event.venue || "" %>"
                        >

                      </div>


                      <div class="form-group full">

                        <label>
                          Alamat
                        </label>

                        <textarea
                          data-field="address"
                        ><%= event.address || "" %></textarea>

                      </div>


                      <div class="form-group full">

                        <label>
                          Google Maps URL
                        </label>

                        <input
                          data-field="mapsUrl"
                          value="<%= event.mapsUrl || "" %>"
                        >

                      </div>


                      <div class="form-group full">

                        <label>
                          Deskripsi
                        </label>

                        <textarea
                          data-field="description"
                        ><%= event.description || "" %></textarea>

                      </div>


                    </div>

                  </div>


                <% }); %>


              </div>


              <button
                type="button"
                class="secondary"
                onclick="addEvent(
                  '<%= wedding.slug %>'
                )"
              >
                + Tambah Acara
              </button>


              <!-- =================================================
                   STORY
              ================================================== -->

              <div class="section-title">

                <h3>
                  Story / Timeline
                </h3>

              </div>


              <div
                class="dynamic-list story-list"
                data-slug="<%= wedding.slug %>"
              >


                <% (wedding.story || []).forEach(
                  function(item, index)
                { %>


                  <div class="dynamic-item story-item">


                    <div class="dynamic-item-header">

                      <strong>
                        Story #<%= index + 1 %>
                      </strong>

                      <button
                        type="button"
                        class="danger small"
                        onclick="this.closest('.story-item').remove()"
                      >
                        Hapus
                      </button>

                    </div>


                    <div class="form-grid">


                      <div class="form-group">

                        <label>
                          Tanggal / Tahun
                        </label>

                        <input
                          data-field="date"
                          value="<%= item.date || "" %>"
                        >

                      </div>


                      <div class="form-group">

                        <label>
                          Judul
                        </label>

                        <input
                          data-field="title"
                          value="<%= item.title || "" %>"
                        >

                      </div>


                      <div class="form-group full">

                        <label>
                          Cerita
                        </label>

                        <textarea
                          data-field="description"
                        ><%= item.description || "" %></textarea>

                      </div>


                    </div>

                  </div>


                <% }); %>


              </div>


              <button
                type="button"
                class="secondary"
                onclick="addStory(
                  '<%= wedding.slug %>'
                )"
              >
                + Tambah Story
              </button>


              <!-- =================================================
                   GIFT
              ================================================== -->

              <div class="section-title">

                <h3>
                  Wedding Gift
                </h3>

              </div>


              <div
                class="dynamic-list gift-list"
                data-slug="<%= wedding.slug %>"
              >


                <% (wedding.gift || []).forEach(
                  function(gift, index)
                { %>


                  <div class="dynamic-item gift-item">


                    <div class="dynamic-item-header">

                      <strong>
                        Gift #<%= index + 1 %>
                      </strong>

                      <button
                        type="button"
                        class="danger small"
                        onclick="this.closest('.gift-item').remove()"
                      >
                        Hapus
                      </button>

                    </div>


                    <div class="form-grid">


                      <div class="form-group">

                        <label>
                          Type
                        </label>

                        <input
                          data-field="type"
                          value="<%= gift.type || "Bank" %>"
                        >

                      </div>


                      <div class="form-group">

                        <label>
                          Bank
                        </label>

                        <input
                          data-field="bank"
                          value="<%= gift.bank || "" %>"
                          placeholder="BCA"
                        >

                      </div>


                      <div class="form-group">

                        <label>
                          Nomor Rekening
                        </label>

                        <input
                          data-field="accountNumber"
                          value="<%= gift.accountNumber || "" %>"
