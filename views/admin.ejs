function renderEditGallery() {

  const container =
    document.getElementById(
      "editGallery"
    );

  container.innerHTML =
    "";

  (
    window.editGalleryImages ||
    []
  ).forEach(
    (image, index) => {

      const item =
        document.createElement(
          "div"
        );

      item.className =
        "gallery-item";

      item.innerHTML = `

        <img
          src="${image.data}"
          alt="Gallery"
        >

        <input
          class="edit-gallery-caption"
          value="${escapeHtml(image.caption || "")}"
          placeholder="Caption"
          style="margin-top:8px"
        >

        <button
          type="button"
          class="danger"
          style="width:100%;margin-top:8px"
          onclick="removeEditGallery(${index})"
        >
          Hapus
        </button>

      `;

      item
        .querySelector(
          ".edit-gallery-caption"
        )
        .addEventListener(
          "input",
          event => {

            window
              .editGalleryImages[
                index
              ]
              .caption =
              event.target.value;

          }
        );

      container.appendChild(
        item
      );

    }
  );

}


function removeEditGallery(
  index
) {

  window
    .editGalleryImages
    .splice(
      index,
      1
    );

  renderEditGallery();

}


/* =========================================================
   SUBMIT EDIT
========================================================= */

async function submitEditWedding(
  originalWedding
) {

  let bridePhoto =
    originalWedding.bride?.photo ||
    null;

  let groomPhoto =
    originalWedding.groom?.photo ||
    null;

  let coverImage =
    originalWedding.coverImage ||
    null;


  try {

    const brideFile =
      document.getElementById(
        "editBridePhoto"
      ).files[0];

    if (brideFile) {

      bridePhoto =
        await readAndCompressImage(
          brideFile
        );

    }


    const groomFile =
      document.getElementById(
        "editGroomPhoto"
      ).files[0];

    if (groomFile) {

      groomPhoto =
        await readAndCompressImage(
          groomFile
        );

    }


    const coverFile =
      document.getElementById(
        "editCoverPhoto"
      ).files[0];

    if (coverFile) {

      coverImage =
        await readAndCompressImage(
          coverFile
        );

    }


    const events =
      Array
        .from(
          document.querySelectorAll(
            "#editEvents .repeatable"
          )
        )
        .map(
          element => ({
            type:
              element.querySelector(
                ".event-type"
              ).value,

            title:
              element.querySelector(
                ".event-title"
              ).value,

            date:
              element.querySelector(
                ".event-date"
              ).value,

            startTime:
              element.querySelector(
                ".event-start"
              ).value,

            endTime:
              element.querySelector(
                ".event-end"
              ).value,

            venue:
              element.querySelector(
                ".event-venue"
              ).value,

            address:
              element.querySelector(
                ".event-address"
              ).value,

            mapsUrl:
              element.querySelector(
                ".event-maps"
              ).value,

            description:
              element.querySelector(
                ".event-description"
              ).value
          })
        );


    const story =
      Array
        .from(
          document.querySelectorAll(
            "#editStories .repeatable"
          )
        )
        .map(
          element => ({
            date:
              element.querySelector(
                ".story-date"
              ).value,

            title:
              element.querySelector(
                ".story-title"
              ).value,

            description:
              element.querySelector(
                ".story-description"
              ).value
          })
        );


    const gift =
      Array
        .from(
          document.querySelectorAll(
            "#editGift .repeatable"
          )
        )
        .map(
          element => ({
            type:
              element.querySelector(
                ".gift-type"
              ).value,

            bank:
              element.querySelector(
                ".gift-bank"
              ).value,

            accountName:
              element.querySelector(
                ".gift-account-name"
              ).value,

            accountNumber:
              element.querySelector(
                ".gift-account-number"
              ).value,

            description:
              element.querySelector(
                ".gift-description"
              ).value
          })
        );


    const payload = {

      slug:
        document.getElementById(
          "editSlug"
        ).value,

      status:
        document.getElementById(
          "editStatus"
        ).value,

      brideName:
        document.getElementById(
          "editBrideName"
        ).value,

      brideFullName:
        document.getElementById(
          "editBrideFullName"
        ).value,

      bridePhoto,

      groomName:
        document.getElementById(
          "editGroomName"
        ).value,

      groomFullName:
        document.getElementById(
          "editGroomFullName"
        ).value,

      groomPhoto,

      coverImage,

      quote:
        document.getElementById(
          "editQuote"
        ).value,

      description:
        document.getElementById(
          "editDescription"
        ).value,

      date:
        document.getElementById(
          "editDate"
        ).value,

      timezone:
        document.getElementById(
          "editTimezone"
        ).value,

      events,

      story,

      gallery:
        window.editGalleryImages,

      gift,

      musicUrl:
        document.getElementById(
          "editMusicUrl"
        ).value
    };


    const response =
      await fetch(
        `/admin/wedding/${encodeURIComponent(editSlug)}/edit`,
        {
          method:
            "POST",

          headers: {
            "Content-Type":
              "application/json",

            "X-CSRF-Token":
              CSRF_TOKEN
          },

          body:
            JSON.stringify(
              payload
            )
        }
      );


    const result =
      await response.json();


    if (
      !response.ok ||
      !result.success
    ) {

      throw new Error(
        result.message ||
        "Gagal update wedding."
      );

    }


    showMessage(
      result.message
    );

    closeEditModal();


    setTimeout(
      () => {
        location.reload();
      },
      800
    );


  } catch (error) {

    showMessage(
      error.message,
      "warning"
    );

  }

}


/* =========================================================
   PUBLISH / UNPUBLISH
========================================================= */

async function changePublish(
  slug,
  action
) {

  const confirmation =
    action ===
    "publish"
      ? "Publish wedding ini?"
      : "Unpublish wedding ini?";

  if (
    !confirm(
      confirmation
    )
  ) {
    return;
  }


  try {

    const response =
      await fetch(
        `/admin/wedding/${encodeURIComponent(slug)}/${action}`,
        {
          method:
            "POST",

          headers: {
            "X-CSRF-Token":
              CSRF_TOKEN
          }
        }
      );


    const result =
      await response.json();


    if (
      !response.ok ||
      !result.success
    ) {

      throw new Error(
        result.message ||
        "Gagal mengubah status."
      );

    }


    showMessage(
      result.message
    );


    setTimeout(
      () => {
        location.reload();
      },
      700
    );


  } catch (error) {

    showMessage(
      error.message,
      "warning"
    );

  }

}


