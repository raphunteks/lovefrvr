  document.getElementById(
    "galleryPreview"
  );


galleryInput.addEventListener(
  "change",
  async () => {

    const files =
      Array.from(
        galleryInput.files
      );

    if (
      galleryImages.length +
        files.length >
      MAX_GALLERY
    ) {

      showMessage(
        `Maksimal ${MAX_GALLERY} gambar.`,
        "warning"
      );

      return;

    }

    for (
      const file of files
    ) {

      try {

        const image =
          await readAndCompressImage(
            file
          );

        galleryImages.push(
          image
        );

      } catch (error) {

        showMessage(
          error.message,
          "warning"
        );

      }

    }

    renderGallery();

    galleryInput.value = "";

  }
);


function renderGallery() {

  galleryPreview.innerHTML =
    "";

  galleryImages.forEach(
    (image, index) => {

      const item =
        document.createElement(
          "div"
        );

      item.className =
        "gallery-item";

      item.innerHTML = `

        <img
          src="${image.data}"
          alt="Gallery ${index + 1}"
        >

        <input
          type="text"
          placeholder="Caption"
          value="${escapeHtml(image.caption || "")}"
          class="gallery-caption"
          style="margin-top:8px"
        >

        <button
          type="button"
          class="danger"
          style="margin-top:8px;width:100%"
          onclick="removeGallery(${index})"
        >
          Hapus
        </button>

      `;

      item
        .querySelector(
          ".gallery-caption"
        )
        .addEventListener(
          "input",
          event => {

            galleryImages[
              index
            ].caption =
              event.target.value;

          }
        );

      galleryPreview.appendChild(
        item
      );

    }
  );

}


function removeGallery(
  index
) {

  galleryImages.splice(
    index,
    1
  );

  renderGallery();

}


