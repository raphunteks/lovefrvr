/* =========================================================
   EDIT FORM SUBMIT
========================================================= */

document
  .querySelectorAll(
    ".editWeddingForm"
  )
  .forEach(
    function(form) {

      form.addEventListener(
        "submit",
        async function(
          event
        ) {

          event.preventDefault();

          const oldSlug =
            form.dataset.slug;

          const formData =
            new FormData(
              form
            );

          const payload = {

            slug:
              formData.get(
                "slug"
              ),

            status:
              formData.get(
                "status"
              ),

            groomName:
              formData.get(
                "groomName"
              ),

            groomFullName:
              formData.get(
                "groomFullName"
              ),

            brideName:
              formData.get(
                "brideName"
              ),

            brideFullName:
              formData.get(
                "brideFullName"
              ),

            date:
              formData.get(
                "date"
              ),

            timezone:
              formData.get(
                "timezone"
              ),

            openingTitle:
              formData.get(
                "openingTitle"
              ),

            openingSubtitle:
              formData.get(
                "openingSubtitle"
              ),

            openingDescription:
              formData.get(
                "openingDescription"
              ),

            quote:
              formData.get(
                "quote"
              ),

            description:
              formData.get(
                "description"
              ),

            showCountdown:
              form.querySelector(
                '[name="showCountdown"]'
              ).checked,

            showStory:
              form.querySelector(
                '[name="showStory"]'
              ).checked,

            showGallery:
              form.querySelector(
                '[name="showGallery"]'
              ).checked,

            showGift:
              form.querySelector(
                '[name="showGift"]'
              ).checked,

            showRsvp:
              form.querySelector(
                '[name="showRsvp"]'
              ).checked,

            bottomNavigation:
              form.querySelector(
                '[name="bottomNavigation"]'
              ).checked,

            /*
               Media tidak diubah
               melalui form text.
               Media sudah langsung
               masuk Redis melalui
               endpoint upload.
            */

            events:
              collectDynamicList(
                form.querySelector(
                  ".events-list"
                ),
                "event-item"
              ),

            story:
              collectDynamicList(
                form.querySelector(
                  ".story-list"
                ),
                "story-item"
              ),

            gift:
              collectDynamicList(
                form.querySelector(
                  ".gift-list"
                ),
                "gift-item"
              )

          };


          /*
             Ambil wedding data saat ini
             supaya media references
             tidak hilang ketika update text.
          */

          try {

            const current =
              await requestJSON(
                "/admin/wedding/" +
                encodeURIComponent(
                  oldSlug
                ) +
                "/data",
                {
                  method:
                    "GET"
                }
              );

            payload.gallery =
              current.wedding.gallery ||
              [];

            payload.coverImage =
              current.wedding.coverImage ||
              null;

            payload.groomPhoto =
              current.wedding.groom?.photo ||
              null;

            payload.bridePhoto =
              current.wedding.bride?.photo ||
              null;

            payload.musicEnabled =
              current.wedding.music?.enabled ||
              false;

            payload.musicUrl =
              current.wedding.music?.url ||
              "";

            payload.musicMediaId =
              current.wedding.music?.mediaId ||
              "";

            payload.musicName =
              current.wedding.music?.name ||
              "";

            /*
               Story photo dipertahankan.
            */

            const oldStory =
              current.wedding.story ||
              [];

            payload.story =
              payload.story.map(
                function(item, index) {

                  return {

                    ...item,

                    photo:
                      oldStory[index]?.photo ||
                      null

                  };

                }
              );


            const result =
              await requestJSON(
                "/admin/wedding/" +
                encodeURIComponent(
                  oldSlug
                ) +
                "/edit",
                {

                  method:
                    "POST",

                  body:
                    JSON.stringify(
                      payload
                    )

                }
              );


            showMessage(
              result.message
            );

            setTimeout(
              function() {

                location.reload();

              },
              700
            );


          } catch (
            error
          ) {

            showMessage(
              error.message,
              "error"
            );

          }

        }
      );

    }
  );


/* =========================================================
   RSVP
========================================================= */

async function showRSVP(
  slug
) {

  const modal =
    document.getElementById(
      "rsvpModal"
    );

  const content =
    document.getElementById(
      "rsvpContent"
    );

  modal.classList.add(
    "open"
  );

  content.innerHTML =
    "<p>Memuat RSVP...</p>";

  try {

    const result =
      await requestJSON(
        "/admin/wedding/" +
        encodeURIComponent(
          slug
        ) +
        "/rsvp",
        {
          method:
            "GET"
        }
      );

    if (
      !result.rsvps.length
    ) {

      content.innerHTML = `
        <div class="empty">
          Belum ada RSVP.
        </div>
      `;

      return;

    }

    const stats =
      result.stats;

    let html = `

      <div class="stats-row">

        <div class="mini-stat">
          <small>Total</small>
          <strong>${stats.total}</strong>
        </div>

        <div class="mini-stat">
          <small>Hadir</small>
          <strong>${stats.hadir}</strong>
        </div>

        <div class="mini-stat">
          <small>Tidak Hadir</small>
          <strong>${stats.tidakHadir}</strong>
        </div>

        <div class="mini-stat">
          <small>Jumlah Tamu</small>
          <strong>${stats.guestCount}</strong>
        </div>

      </div>

      <br>

      <div class="rsvp-table-wrap">

        <table>

          <thead>

            <tr>
              <th>Nama</th>
              <th>Kehadiran</th>
              <th>Tamu</th>
              <th>Pesan</th>
              <th>Waktu</th>
            </tr>

          </thead>

          <tbody>
    `;


    result.rsvps.forEach(
      function(item) {

        html += `

          <tr>

            <td>
              ${escapeHtml(
                item.name
              )}
            </td>

            <td>
              ${escapeHtml(
                attendanceLabel(
                  item.attendance
                )
              )}
            </td>

            <td>
              ${escapeHtml(
                item.guestCount
              )}
            </td>

            <td>
              ${escapeHtml(
                item.message ||
                "-"
              )}
            </td>

            <td>
              ${escapeHtml(
                item.createdAt
              )}
            </td>

          </tr>

        `;

      }
    );


    html += `

          </tbody>

        </table>

      </div>

    `;

    content.innerHTML =
      html;

  } catch (
    error
  ) {

    content.innerHTML = `
      <div class="notice error">
        ${escapeHtml(
          error.message
        )}
      </div>
    `;

  }

}


function attendanceLabel(
  value
) {

  if (
    value ===
    "hadir"
  ) {

    return "Hadir";

  }

  if (
    value ===
    "tidak_hadir"
  ) {

    return "Tidak Hadir";

  }

  if (
    value ===
    "masih_menentukan"
  ) {

    return "Masih Menentukan";

  }

  return value || "-";

}


/* =========================================================
   ESCAPE
========================================================= */

function escapeHtml(
  value
) {

  return String(
    value ??
      ""
  )
    .replace(
      /&/g,
      "&amp;"
    )
    .replace(
      /</g,
      "&lt;"
    )
    .replace(
      />/g,
      "&gt;"
    )
    .replace(
      /"/g,
      "&quot;"
    )
    .replace(
      /'/g,
      "&#039;"
    );

}


/* =========================================================
   MODAL
========================================================= */

function closeModal(
  id
) {

  const modal =
    document.getElementById(
      id
    );

  if (modal) {

    modal.classList.remove(
      "open"
    );

  }

}


document
  .querySelectorAll(
    ".modal"
  )
  .forEach(
    function(modal) {

      modal.addEventListener(
        "click",
        function(event) {

          if (
            event.target ===
            modal
          ) {

            modal.classList.remove(
              "open"
            );

          }

        }
      );

    }
  );


document.addEventListener(
  "keydown",
  function(event) {

    if (
      event.key ===
      "Escape"
    ) {

      document
        .querySelectorAll(
          ".modal.open"
        )
        .forEach(
          function(modal) {

            modal.classList.remove(
              "open"
            );

          }
        );

    }

  }
);

</script>

