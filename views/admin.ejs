========================================================= */

function setupSingleImage(
  inputId,
  previewId,
  setter
) {

  const input =
    document.getElementById(
      inputId
    );

  const preview =
    document.getElementById(
      previewId
    );

  input.addEventListener(
    "change",
    async () => {

      const file =
        input.files[0];

      if (!file) {
        return;
      }

      try {

        const image =
          await readAndCompressImage(
            file
          );

        setter(image);

        preview.style.display =
          "block";

        preview.innerHTML = `
          <img
            src="${image.data}"
            alt="Preview"
          >
        `;

      } catch (error) {

        input.value = "";

        setter(null);

        showMessage(
          error.message,
          "warning"
        );

      }

    }
  );

}


