<!DOCTYPE html>
<html lang="id">
<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Admin Dashboard — LOVEFOREVER
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f7f5f2;
      color: #2b2927;
      font-family:
        Arial,
        Helvetica,
        sans-serif;
    }

    .admin-layout {
      min-height: 100vh;
    }

    .admin-header {
      position: sticky;
      top: 0;
      z-index: 100;
      padding: 15px 20px;
      background: rgba(255,255,255,.94);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid #e5e0db;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .admin-brand {
      font-weight: 700;
      letter-spacing: 2px;
    }

    .admin-main {
      width: min(1250px, 100%);
      margin: auto;
      padding: 30px 18px 80px;
    }

    .dashboard-title {
      margin-bottom: 25px;
    }

    .dashboard-title h1 {
      margin-bottom: 8px;
    }

    .dashboard-title p {
      opacity: .65;
    }

    .summary-grid {
      display: grid;
      grid-template-columns:
        repeat(
          auto-fit,
          minmax(160px, 1fr)
        );
      gap: 15px;
      margin-bottom: 30px;
    }

    .summary-card {
      background: white;
      border: 1px solid #e6e1dc;
      border-radius: 16px;
      padding: 20px;
    }

    .summary-card small {
      opacity: .6;
    }

    .summary-card strong {
      display: block;
      font-size: 30px;
      margin-top: 8px;
    }

    .panel {
      background: white;
      border: 1px solid #e6e1dc;
      border-radius: 18px;
      margin-bottom: 25px;
      overflow: hidden;
    }

    .panel-header {
      padding: 20px;
      border-bottom: 1px solid #eee8e3;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .panel-body {
      padding: 20px;
    }

    .wedding-card {
      border: 1px solid #e8e3de;
      border-radius: 15px;
      padding: 18px;
      margin-bottom: 15px;
    }

    .wedding-card:last-child {
      margin-bottom: 0;
    }

    .wedding-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      flex-wrap: wrap;
    }

    .wedding-card h3 {
      margin: 0 0 5px;
    }

    .wedding-meta {
      opacity: .65;
      font-size: 14px;
      line-height: 1.7;
    }

    .status {
      display: inline-flex;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
    }

    .status-published {
      background: #e5f5e8;
      color: #256c35;
    }

    .status-draft {
      background: #f3eee8;
      color: #765e49;
    }

    .actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 15px;
    }

    button,
    .button-link {
      border: 0;
      border-radius: 9px;
      padding: 10px 14px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
    }

    button {
      background: #292624;
      color: white;
    }

    button.secondary,
    .button-link.secondary {
      background: #eee9e4;
      color: #292624;
    }

    button.danger {
      background: #b13c3c;
      color: white;
    }

    button.success {
      background: #357345;
      color: white;
    }

    .form-grid {
      display: grid;
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
      gap: 18px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    label {
      display: block;
      font-weight: 600;
      margin-bottom: 7px;
      font-size: 14px;
    }

    input,
    textarea,
    select {
      width: 100%;
      border: 1px solid #d8d1ca;
      border-radius: 9px;
      padding: 11px 12px;
      background: white;
      color: #222;
      font: inherit;
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    .image-upload {
      border: 1px dashed #cfc5bc;
      border-radius: 12px;
      padding: 15px;
      background: #fbfaf8;
    }

    .image-preview {
      margin-top: 10px;
      display: none;
    }

    .image-preview img {
      max-width: 180px;
      max-height: 150px;
      border-radius: 10px;
      object-fit: cover;
    }

    .repeatable {
      border: 1px solid #e4ddd7;
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 12px;
      background: #fcfbfa;
    }

    .repeatable-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .gallery-grid {
      display: grid;
      grid-template-columns:
        repeat(
          auto-fill,
          minmax(150px, 1fr)
        );
      gap: 12px;
    }

    .gallery-item {
      border: 1px solid #e3ddd7;
      border-radius: 10px;
      padding: 8px;
      background: white;
    }

    .gallery-item img {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 8px;
    }

    .notice {
      padding: 12px 15px;
      border-radius: 10px;
      margin-bottom: 15px;
      background: #f2eee9;
      line-height: 1.6;
      font-size: 14px;
    }

    .notice.warning {
      background: #fff2d8;
    }

    .notice.success {
      background: #e6f5e9;
    }

    .hidden {
      display: none !important;
    }

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.5);
      z-index: 500;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 15px;
    }

    .modal.open {
      display: flex;
    }

    .modal-content {
      background: white;
      border-radius: 18px;
      width: min(1100px, 100%);
      max-height: 90vh;
      overflow: auto;
      padding: 25px;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 20px;
    }

    .rsvp-table-wrapper {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      padding: 10px;
      border-bottom: 1px solid #eee;
      text-align: left;
      vertical-align: top;
      white-space: nowrap;
    }

    th {
      background: #f7f5f2;
    }

    .muted {
      opacity: .6;
    }

    @media (max-width: 700px) {

      .form-grid {
        grid-template-columns: 1fr;
      }

      .form-group.full {
        grid-column: auto;
      }

      .admin-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .panel-header {
        align-items: flex-start;
        flex-direction: column;
      }

    }

  </style>

</head>

<body>

<div class="admin-layout">


  <!-- =====================================================
       HEADER
  ====================================================== -->

  <header class="admin-header">

    <div class="admin-brand">
      LOVEFOREVER
    </div>

    <form
      method="POST"
      action="/admin/logout"
    >

      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <button
        type="submit"
        class="secondary"
      >
        Logout
      </button>

    </form>

  </header>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <main class="admin-main">


    <div class="dashboard-title">

      <h1>
        Admin Dashboard
      </h1>

      <p>
        Kelola wedding invitation,
        gallery, event, RSVP dan konten
        dari satu dashboard.
      </p>

    </div>


    <div id="globalMessage"></div>


    <!-- ===================================================
         SUMMARY
    ==================================================== -->

    <section class="summary-grid">

      <div class="summary-card">

        <small>
          Total Wedding
        </small>

        <strong>
          <%= weddings.length %>
        </strong>

      </div>


      <div class="summary-card">

        <small>
          Published
        </small>

        <strong>

          <%= weddings.filter(
            w =>
              w.status ===
              "published"
          ).length %>

        </strong>

      </div>


      <div class="summary-card">

        <small>
          Draft
        </small>

        <strong>

          <%= weddings.filter(
            w =>
              w.status !==
              "published"
          ).length %>

        </strong>

      </div>


      <div class="summary-card">

        <small>
          Total RSVP
        </small>

        <strong>

          <%= weddings.reduce(
            (sum, w) =>
              sum +
              (w.stats?.total || 0),
            0
          ) %>

        </strong>

      </div>

    </section>


    <!-- ===================================================
         CREATE WEDDING
    ==================================================== -->

    <section class="panel">

      <div class="panel-header">

        <div>

          <strong>
            Buat Wedding Baru
          </strong>

          <div class="muted">
            Slug ditentukan manual oleh Admin.
          </div>

        </div>

      </div>


      <div class="panel-body">

        <form
          id="createWeddingForm"
        >

          <input
            type="hidden"
            id="csrfToken"
            value="<%= csrfToken %>"
          >


          <!-- BASIC -->

          <h3>
            Informasi Dasar
          </h3>

          <div class="form-grid">

            <div class="form-group">

              <label>
                Slug
              </label>

              <input
                id="slug"
                name="slug"
                required
                placeholder="contoh-aulia-rizky"
                pattern="[a-zA-Z0-9-]+"
              >

              <small class="muted">
                URL:
                /slug-yang-anda-tentukan
              </small>

            </div>


            <div class="form-group">

              <label>
                Status
              </label>

              <select id="status">

                <option value="draft">
                  Draft
                </option>

                <option value="published">
                  Published
                </option>

              </select>

            </div>


            <div class="form-group">

              <label>
                Tanggal Pernikahan
              </label>

              <input
                type="datetime-local"
                id="date"
              >

            </div>


            <div class="form-group">

              <label>
                Timezone
              </label>

              <select id="timezone">

                <option value="Asia/Makassar">
                  Asia/Makassar — WITA
                </option>

                <option value="Asia/Jakarta">
                  Asia/Jakarta — WIB
                </option>

                <option value="Asia/Jayapura">
                  Asia/Jayapura — WIT
                </option>

              </select>

            </div>


            <div class="form-group full">

              <label>
                Quote
              </label>

              <textarea
                id="quote"
                placeholder="Tuliskan quote pernikahan..."
              ></textarea>

            </div>


            <div class="form-group full">

              <label>
                Deskripsi
              </label>

              <textarea
                id="description"
                placeholder="Deskripsi singkat undangan..."
              ></textarea>

            </div>

          </div>


          <!-- COUPLE -->

          <h3>
            Mempelai Pria
          </h3>

          <div class="form-grid">

            <div class="form-group">

              <label>
                Nama
              </label>

              <input
                id="groomName"
                placeholder="Rizky"
              >

            </div>


            <div class="form-group">

              <label>
                Nama Lengkap
              </label>

              <input
                id="groomFullName"
                placeholder="Rizky ..."
              >

            </div>


            <div class="form-group full">

              <label>
                Foto Mempelai Pria
              </label>

              <div class="image-upload">

                <input
                  type="file"
                  id="groomPhotoFile"
                  accept="image/jpeg,image/png,image/webp,image/gif"
                >

                <div
                  id="groomPhotoPreview"
                  class="image-preview"
                ></div>

              </div>

            </div>

          </div>


          <h3>
            Mempelai Wanita
          </h3>

          <div class="form-grid">

            <div class="form-group">

              <label>
                Nama
              </label>

              <input
                id="brideName"
                placeholder="Aulia"
              >

            </div>


            <div class="form-group">

              <label>
                Nama Lengkap
              </label>

              <input
                id="brideFullName"
                placeholder="Aulia ..."
              >

            </div>


            <div class="form-group full">

              <label>
                Foto Mempelai Wanita
              </label>

              <div class="image-upload">

                <input
                  type="file"
                  id="bridePhotoFile"
                  accept="image/jpeg,image/png,image/webp,image/gif"
                >

                <div
                  id="bridePhotoPreview"
                  class="image-preview"
                ></div>

              </div>

            </div>

          </div>


          <!-- COVER -->

          <h3>
            Cover Invitation
          </h3>

          <div class="form-group">

            <label>
              Cover Image
            </label>

            <div class="image-upload">

              <input
                type="file"
                id="coverImageFile"
                accept="image/jpeg,image/png,image/webp,image/gif"
              >

              <div
                id="coverImagePreview"
                class="image-preview"
              ></div>

            </div>

          </div>


          <!-- EVENTS -->

          <h3>
            Event / Acara
          </h3>

          <div id="eventsContainer"></div>

          <button
            type="button"
            class="secondary"
            id="addEventBtn"
          >
            + Tambah Event
          </button>


          <!-- STORY -->

          <h3 style="margin-top:30px">
            Story / Timeline
          </h3>

          <div id="storyContainer"></div>

          <button
            type="button"
            class="secondary"
            id="addStoryBtn"
          >
            + Tambah Story
          </button>


          <!-- GALLERY -->

          <h3 style="margin-top:30px">
            Gallery
          </h3>

          <div class="notice warning">

            <strong>Upload Base64:</strong>

            Foto diproses di browser,
            dikompresi, kemudian dikirim
            ke server dan disimpan di
            Upstash Redis.

            Maksimal sekitar
            <strong>1 MB per gambar</strong>
            setelah kompresi.

          </div>


          <div class="form-group">

            <label>
              Upload Gallery
            </label>

            <input
              type="file"
              id="galleryFiles"
              multiple
              accept="image/jpeg,image/png,image/webp,image/gif"
            >

          </div>


          <div
            id="galleryPreview"
            class="gallery-grid"
          ></div>


          <!-- GIFT -->

          <h3 style="margin-top:30px">
            Wedding Gift
          </h3>

          <div id="giftContainer"></div>

          <button
            type="button"
            class="secondary"
            id="addGiftBtn"
          >
            + Tambah Rekening
          </button>


          <!-- MUSIC -->

          <h3 style="margin-top:30px">
            Music
          </h3>

          <div class="form-group">

            <label>
              URL Music
            </label>

            <input
              id="musicUrl"
              type="url"
              placeholder="https://..."
            >

            <small class="muted">
              Untuk MVP music menggunakan URL.
            </small>

          </div>


          <!-- SUBMIT -->

          <div
            class="actions"
            style="margin-top:30px"
          >

            <button
              type="submit"
            >
              Simpan Wedding
            </button>

            <button
              type="reset"
              class="secondary"
              id="resetFormBtn"
            >
              Reset
            </button>

          </div>

        </form>

      </div>

    </section>


    <!-- ===================================================
         WEDDING LIST
    ==================================================== -->

    <section class="panel">

      <div class="panel-header">

        <div>

          <strong>
            Wedding Invitation
          </strong>

          <div class="muted">
            Daftar seluruh wedding.
          </div>

        </div>

      </div>


      <div class="panel-body">

        <% if (!weddings.length) { %>

          <div class="notice">
            Belum ada wedding.
          </div>

        <% } %>


        <% weddings.forEach(function(wedding) { %>

          <article
            class="wedding-card"
            data-slug="<%= wedding.slug %>"
          >

            <div class="wedding-card-header">

              <div>

                <h3>

                  <%= wedding.bride?.name || "Bride" %>

                  &

                  <%= wedding.groom?.name || "Groom" %>

                </h3>

                <div class="wedding-meta">

                  Slug:
                  <strong>
                    <%= wedding.slug %>
                  </strong>

                  <br>

                  URL:
                  <a
                    href="/<%= wedding.slug %>"
                    target="_blank"
                  >
                    /<%= wedding.slug %>
                  </a>

                  <br>

                  Gallery:
                  <%= wedding.gallery?.length || 0 %>
                  gambar

                  <br>

                  RSVP:
                  <%= wedding.stats?.total || 0 %>

                </div>

              </div>


              <div>

                <% if (
                  wedding.status ===
                  "published"
                ) { %>

                  <span
                    class="status status-published"
                  >
                    PUBLISHED
                  </span>

                <% } else { %>

                  <span
                    class="status status-draft"
                  >
                    DRAFT
                  </span>

                <% } %>

              </div>

            </div>


            <div class="actions">

              <button
                type="button"
                class="secondary"
                onclick="editWedding('<%= wedding.slug %>')"
              >
                Edit
              </button>


              <a
                href="/<%= wedding.slug %>"
                target="_blank"
                class="button-link secondary"
              >
                Preview
              </a>


              <button
                type="button"
                class="secondary"
                onclick="showRsvp('<%= wedding.slug %>')"
              >
                RSVP
              </button>


              <% if (
                wedding.status ===
                "published"
              ) { %>

                <button
                  type="button"
                  onclick="changePublish('<%= wedding.slug %>', 'unpublish')"
                >
                  Unpublish
                </button>

              <% } else { %>

                <button
                  type="button"
                  class="success"
                  onclick="changePublish('<%= wedding.slug %>', 'publish')"
                >
                  Publish
                </button>

              <% } %>


              <button
                type="button"
                class="danger"
                onclick="deleteWedding('<%= wedding.slug %>')"
              >
                Delete
              </button>

            </div>

          </article>

        <% }); %>

      </div>

    </section>


  </main>

</div>


<!-- =======================================================
     EDIT MODAL
======================================================== -->

<div
  id="editModal"
  class="modal"
>

  <div class="modal-content">

    <div class="modal-header">

      <h2>
        Edit Wedding
      </h2>

      <button
        type="button"
        class="secondary"
        onclick="closeEditModal()"
      >
        Tutup
      </button>

    </div>

    <div
      id="editContent"
    ></div>

  </div>

</div>


<!-- =======================================================
     RSVP MODAL
======================================================== -->

<div
  id="rsvpModal"
  class="modal"
>

  <div class="modal-content">

    <div class="modal-header">

      <h2>
        RSVP
      </h2>

      <button
        type="button"
        class="secondary"
        onclick="closeRsvpModal()"
      >
        Tutup
      </button>

    </div>

    <div
      id="rsvpContent"
    ></div>

  </div>

</div>


<script>

/* =========================================================
   GLOBAL
========================================================= */

const CSRF_TOKEN =
  document.getElementById(
    "csrfToken"
  ).value;

const MAX_IMAGE_BYTES =
  1024 * 1024;

const MAX_GALLERY =
  15;

let galleryImages = [];

let editSlug = null;


/* =========================================================
   MESSAGE
========================================================= */

function showMessage(
  message,
  type = "success"
) {

  const box =
    document.getElementById(
      "globalMessage"
    );

  box.innerHTML = `
    <div class="notice ${type}">
      ${escapeHtml(message)}
    </div>
  `;

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });

  setTimeout(() => {
    box.innerHTML = "";
  }, 5000);

}


/* =========================================================
   ESCAPE
========================================================= */

function escapeHtml(
  value
) {

  return String(value ?? "")
    .replace(
      /&/g,
      "&amp;"
    )
    .replace(
      /</g,
      "&lt;"
    )
    .replace(
      />/g,
      "&gt;"
    )
    .replace(
      /"/g,
      "&quot;"
    )
    .replace(
      /'/g,
      "&#039;"
    );

}


/* =========================================================
   IMAGE PROCESSING
========================================================= */

function readAndCompressImage(
  file
) {

  return new Promise(
    (resolve, reject) => {

      if (!file) {
        resolve(null);
        return;
      }

      if (
        !file.type.startsWith(
          "image/"
        )
      ) {
        reject(
          new Error(
            "File harus berupa gambar."
          )
        );

        return;
      }

      const reader =
        new FileReader();

      reader.onload = event => {

        const image =
          new Image();

        image.onload = () => {

          let width =
            image.naturalWidth;

          let height =
            image.naturalHeight;

          const MAX_DIMENSION =
            1800;

          if (
            width >
              MAX_DIMENSION ||
            height >
              MAX_DIMENSION
          ) {

            const ratio =
              Math.min(
                MAX_DIMENSION /
                  width,

                MAX_DIMENSION /
                  height
              );

            width =
              Math.round(
                width * ratio
              );

            height =
              Math.round(
                height * ratio
              );

          }

          const canvas =
            document.createElement(
              "canvas"
            );

          canvas.width =
            width;

          canvas.height =
            height;

          const ctx =
            canvas.getContext(
              "2d"
            );

          ctx.drawImage(
            image,
            0,
            0,
            width,
            height
          );

          let quality =
            0.82;

          let dataUrl =
            canvas.toDataURL(
              "image/jpeg",
              quality
            );

          while (
            dataUrl.length >
              MAX_IMAGE_BYTES *
              1.37 &&
            quality >
              0.35
          ) {

            quality -=
              0.08;

            dataUrl =
              canvas.toDataURL(
                "image/jpeg",
                quality
              );

          }

          const base64Part =
            dataUrl.split(
              ","
            )[1];

          const estimatedBytes =
            Math.floor(
              base64Part.length *
              0.75
            );

          if (
            estimatedBytes >
            MAX_IMAGE_BYTES
          ) {

            reject(
              new Error(
                "Gambar terlalu besar setelah kompresi. Pilih gambar yang lebih kecil."
              )
            );

            return;

          }

          resolve({
            data:
              dataUrl,

            mime:
              "image/jpeg",

            caption:
              ""
          });

        };

        image.onerror = () => {

          reject(
            new Error(
              "Gagal membaca gambar."
            )
          );

        };

        image.src =
          event.target.result;

      };

      reader.onerror = () => {

        reject(
          new Error(
            "Gagal membaca file."
          )
        );

      };

      reader.readAsDataURL(
        file
      );

    }
  );

}


