<!DOCTYPE html>
<html lang="id">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="theme-color"
    content="#f7f2ec"
  >

  <title>
    Admin Dashboard — LOVEFOREVER
  </title>

  <style>

    :root {
      --bg: #f5f1ed;
      --surface: #ffffff;
      --surface-soft: #faf8f6;
      --text: #2d2926;
      --muted: #77706b;
      --border: #e6dfd9;
      --accent: #8b7565;
      --danger: #a94b4b;
      --success: #47745b;
      --shadow:
        0 20px 60px rgba(45, 41, 38, .08);
      --radius: 22px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    a {
      color: inherit;
    }

    .admin-header {
      position: sticky;
      top: 0;
      z-index: 100;
      height: 76px;
      background: rgba(255,255,255,.94);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
    }

    .brand {
      font-size: 22px;
      letter-spacing: .18em;
      font-weight: 800;
    }

    .admin-main {
      width: min(1500px, calc(100% - 32px));
      margin: 0 auto;
      padding: 42px 0 100px;
    }

    .dashboard-title {
      margin-bottom: 30px;
    }

    .dashboard-title h1 {
      margin: 0 0 10px;
      font-size: clamp(32px, 5vw, 56px);
      letter-spacing: -.04em;
    }

    .dashboard-title p {
      color: var(--muted);
      font-size: 17px;
      line-height: 1.7;
      margin: 0;
    }

    .summary-grid {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .summary-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 26px;
      box-shadow: var(--shadow);
    }

    .summary-card small {
      display: block;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .summary-card strong {
      font-size: 40px;
      letter-spacing: -.04em;
    }

    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 28px;
      box-shadow: var(--shadow);
      overflow: hidden;
      margin-bottom: 24px;
    }

    .panel-header {
      padding: 28px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .panel-header h2,
    .panel-header h3 {
      margin: 0 0 6px;
    }

    .muted {
      color: var(--muted);
    }

    .panel-body {
      padding: 28px;
    }

    .section-title {
      margin:
        36px 0 18px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }

    .section-title:first-child {
      margin-top: 0;
    }

    .form-grid {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    label {
      display: block;
      font-size: 14px;
      font-weight: 750;
      margin-bottom: 8px;
    }

    input,
    textarea,
    select {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: #fff;
      color: var(--text);
      padding: 13px 15px;
      outline: none;
      transition:
        border .2s,
        box-shadow .2s;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: var(--accent);
      box-shadow:
        0 0 0 4px
        rgba(139,117,101,.10);
    }

    textarea {
      resize: vertical;
      min-height: 100px;
      line-height: 1.6;
    }

    .button-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    button,
    .button {
      border: 0;
      border-radius: 13px;
      padding: 12px 17px;
      background: var(--text);
      color: white;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition:
        transform .2s,
        opacity .2s;
    }

    button:hover,
    .button:hover {
      transform: translateY(-1px);
    }

    button.secondary,
    .button.secondary {
      background: #eee9e4;
      color: var(--text);
    }

    button.danger {
      background: var(--danger);
    }

    button.success {
      background: var(--success);
    }

    button.small,
    .button.small {
      padding: 9px 12px;
      font-size: 13px;
    }

    .notice {
      padding: 15px 17px;
      background: #f8f1df;
      border: 1px solid #eadcba;
      border-radius: 14px;
      margin-bottom: 20px;
    }

    .notice.success {
      background: #edf7f0;
      border-color: #cce5d3;
    }

    .notice.error {
      background: #fbeeee;
      border-color: #edcccc;
    }

    .wedding-card {
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 22px;
      margin-bottom: 18px;
      background: var(--surface-soft);
    }

    .wedding-card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
    }

    .wedding-card h3 {
      margin: 0 0 7px;
      font-size: 24px;
    }

    .slug {
      font-family: monospace;
      font-size: 13px;
      color: var(--muted);
      word-break: break-all;
    }

    .status {
      display: inline-flex;
      border-radius: 999px;
      padding: 7px 11px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .05em;
    }

    .status.published {
      background: #e8f5eb;
      color: #3e7050;
    }

    .status.draft {
      background: #eeeae6;
      color: #766d66;
    }

    .stats-row {
      display: grid;
      grid-template-columns:
        repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-top: 18px;
    }

    .mini-stat {
      background: white;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px;
    }

    .mini-stat small {
      color: var(--muted);
      display: block;
      margin-bottom: 5px;
    }

    .mini-stat strong {
      font-size: 22px;
    }

    .edit-panel {
      margin-top: 22px;
      padding-top: 22px;
      border-top: 1px solid var(--border);
    }

    .media-box {
      border: 1px dashed #cfc4bb;
      border-radius: 18px;
      padding: 18px;
      background: #fff;
    }

    .media-preview {
      width: 100%;
      max-height: 230px;
      object-fit: cover;
      border-radius: 15px;
      background: #eee;
      margin: 10px 0;
    }

    .media-preview.square {
      aspect-ratio: 1;
      max-width: 230px;
    }

    .gallery-preview {
      display: grid;
      grid-template-columns:
        repeat(auto-fill, minmax(130px, 1fr));
      gap: 12px;
    }

    .gallery-item {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      background: #eee;
      aspect-ratio: 1;
    }

    .gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .gallery-item button {
      position: absolute;
      right: 7px;
      top: 7px;
      width: 32px;
      height: 32px;
      padding: 0;
      border-radius: 50%;
      background: rgba(0,0,0,.72);
    }

    .dynamic-list {
      display: grid;
      gap: 15px;
    }

    .dynamic-item {
      border: 1px solid var(--border);
      border-radius: 17px;
      padding: 17px;
      background: #fff;
    }

    .dynamic-item-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 14px;
    }

    .empty {
      padding: 40px;
      text-align: center;
      color: var(--muted);
    }

    .modal {
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(20,17,15,.55);
      backdrop-filter: blur(10px);
      display: none;
      padding: 24px;
      overflow: auto;
    }

    .modal.open {
      display: block;
    }

    .modal-card {
      width: min(1100px, 100%);
      margin: 30px auto;
      background: white;
      border-radius: 26px;
      overflow: hidden;
      box-shadow: 0 40px 100px rgba(0,0,0,.25);
    }

    .modal-header {
      padding: 22px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .modal-body {
      padding: 22px;
    }

    .modal-close {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      padding: 0;
      background: #eee9e4;
      color: var(--text);
    }

    .rsvp-table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 800px;
    }

    th,
    td {
      padding: 13px;
      border-bottom: 1px solid var(--border);
      text-align: left;
      vertical-align: top;
    }

    th {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--muted);
    }

    .url-preview {
      margin-top: 8px;
      padding: 12px;
      background: #f4f1ee;
      border-radius: 10px;
      font-family: monospace;
      word-break: break-all;
      font-size: 13px;
    }

    .progress {
      height: 7px;
      border-radius: 999px;
      background: #eee;
      overflow: hidden;
      margin-top: 10px;
    }

    .progress > span {
      display: block;
      height: 100%;
      width: 0;
      background: var(--accent);
      transition: width .2s;
    }

    .sticky-save {
      position: sticky;
      bottom: 18px;
      z-index: 50;
      display: flex;
      justify-content: flex-end;
      margin-top: 20px;
      pointer-events: none;
    }

    .sticky-save button {
      pointer-events: auto;
      box-shadow:
        0 15px 40px rgba(0,0,0,.18);
    }

    @media (max-width: 1000px) {

      .summary-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }

      .stats-row {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }

    @media (max-width: 700px) {

      .admin-header {
        padding: 0 15px;
        height: 66px;
      }

      .brand {
        font-size: 17px;
      }

      .admin-main {
        width: min(
          100% - 20px,
          1500px
        );
        padding-top: 25px;
      }

      .summary-grid,
      .form-grid,
      .stats-row {
        grid-template-columns:
          1fr;
      }

      .panel-header,
      .panel-body {
        padding: 19px;
      }

      .wedding-card {
        padding: 17px;
      }

      .wedding-card-top {
        flex-direction: column;
      }

      .button-row {
        display: grid;
        grid-template-columns:
          1fr 1fr;
      }

      .button-row button,
      .button-row .button {
        width: 100%;
      }

      .modal {
        padding: 10px;
      }

      .modal-card {
        margin: 10px auto;
        border-radius: 18px;
      }

    }

  </style>

</head>


<body>


<header class="admin-header">

  <div class="brand">
    LOVEFOREVER
  </div>

  <form
    method="POST"
    action="/admin/logout"
  >

    <input
      type="hidden"
      name="_csrf"
      value="<%= csrfToken %>"
    >

    <button
      type="submit"
      class="secondary"
    >
      Logout
    </button>

  </form>

</header>


<main class="admin-main">


  <section class="dashboard-title">

    <h1>
      Admin Dashboard
    </h1>

    <p>
      Kelola wedding invitation,
      konten, media, event, RSVP,
      gallery dan musik dari satu tempat.
    </p>

  </section>


  <div id="globalMessage"></div>


  <!-- =====================================================
       SUMMARY
  ====================================================== -->

  <section class="summary-grid">

    <div class="summary-card">

      <small>
        Total Wedding
      </small>

      <strong>
        <%= weddings.length %>
      </strong>

    </div>


    <div class="summary-card">

      <small>
        Published
      </small>

      <strong>
        <%= weddings.filter(
          function(w) {
            return w.status === "published";
          }
        ).length %>
      </strong>

    </div>


    <div class="summary-card">

      <small>
        Draft
      </small>

      <strong>
        <%= weddings.filter(
          function(w) {
            return w.status !== "published";
          }
        ).length %>
      </strong>

    </div>


    <div class="summary-card">

      <small>
        Total RSVP
      </small>

      <strong>
        <%= weddings.reduce(
          function(sum, w) {
            return sum +
              Number(
                w.stats?.total || 0
              );
          },
          0
        ) %>
      </strong>

    </div>

  </section>


  <!-- =====================================================
       CREATE
  ====================================================== -->

  <section class="panel">

    <div class="panel-header">

      <div>

        <h2>
          Buat Wedding Baru
        </h2>

        <div class="muted">
          Slug ditentukan manual oleh Admin.
        </div>

      </div>

    </div>


    <div class="panel-body">


      <form id="createWeddingForm">


        <div class="section-title">
          <h3>
            Informasi Dasar
          </h3>
        </div>


        <div class="form-grid">


          <div class="form-group">

            <label>
              Slug
            </label>

            <input
              id="createSlug"
              required
              minlength="3"
              maxlength="100"
              pattern="[a-zA-Z0-9-]+"
              placeholder="contoh-aulia-rizky"
            >

            <div
              id="createUrl"
              class="url-preview"
            >
              https://loveforever.vercel.app/
            </div>

          </div>


          <div class="form-group">

            <label>
              Status
            </label>

            <select id="createStatus">

              <option value="draft">
                Draft
              </option>

              <option value="published">
                Published
              </option>

            </select>

          </div>


          <div class="form-group">

            <label>
              Nama Mempelai Pria
            </label>

            <input
              id="createGroomName"
              placeholder="Rizky"
            >

          </div>


          <div class="form-group">

            <label>
              Nama Lengkap Pria
            </label>

            <input
              id="createGroomFullName"
              placeholder="Rizky ..."
            >

          </div>


          <div class="form-group">

            <label>
              Nama Mempelai Wanita
            </label>

            <input
              id="createBrideName"
              placeholder="Aulia"
            >

          </div>


          <div class="form-group">

            <label>
              Nama Lengkap Wanita
            </label>

            <input
              id="createBrideFullName"
              placeholder="Aulia ..."
            >

          </div>


          <div class="form-group">

            <label>
              Tanggal Pernikahan
            </label>

            <input
              id="createDate"
              type="datetime-local"
            >

          </div>


          <div class="form-group">

            <label>
              Timezone
            </label>

            <select id="createTimezone">

              <option value="Asia/Jakarta">
                Asia/Jakarta — WIB
              </option>

              <option value="Asia/Makassar">
                Asia/Makassar — WITA
              </option>

              <option value="Asia/Jayapura">
                Asia/Jayapura — WIT
              </option>

            </select>

          </div>


        </div>


        <div class="section-title">

          <h3>
            Opening
          </h3>

        </div>


        <div class="form-grid">


          <div class="form-group">

            <label>
              Judul Opening
            </label>

            <input
              id="createOpeningTitle"
              value="The Wedding Of"
            >

          </div>


          <div class="form-group">

            <label>
              Subtitle
            </label>

            <input
              id="createOpeningSubtitle"
              value="Dengan penuh kebahagiaan"
            >

          </div>


          <div class="form-group full">

            <label>
              Deskripsi Opening
            </label>

            <textarea
              id="createOpeningDescription"
            >Kami mengundang Bapak/Ibu/Saudara/i untuk hadir dan memberikan doa restu pada hari bahagia kami.</textarea>

          </div>


        </div>


        <div class="section-title">

          <h3>
            Quote & Deskripsi
          </h3>

        </div>


        <div class="form-group">

          <label>
            Quote
          </label>

          <textarea
            id="createQuote"
            placeholder="Dan di antara tanda-tanda kekuasaan-Nya..."
          ></textarea>

        </div>


        <div class="form-group">

          <label>
            Deskripsi
          </label>

          <textarea
            id="createDescription"
            placeholder="Cerita singkat tentang pernikahan..."
          ></textarea>

        </div>


        <div class="section-title">

          <h3>
            Pengaturan
          </h3>

        </div>


        <div class="button-row">

          <label>
            <input
              id="createShowCountdown"
              type="checkbox"
              checked
              style="width:auto"
            >
            Countdown
          </label>

          <label>
            <input
              id="createShowStory"
              type="checkbox"
              checked
              style="width:auto"
            >
            Story
          </label>

          <label>
            <input
              id="createShowGallery"
              type="checkbox"
              checked
              style="width:auto"
            >
            Gallery
          </label>

          <label>
            <input
              id="createShowGift"
              type="checkbox"
              checked
              style="width:auto"
            >
            Gift
          </label>

          <label>
            <input
              id="createShowRsvp"
              type="checkbox"
              checked
              style="width:auto"
            >
            RSVP
          </label>

          <label>
            <input
              id="createBottomNavigation"
              type="checkbox"
              checked
              style="width:auto"
            >
            Bottom Navigation
          </label>

        </div>


        <div class="sticky-save">

          <button
            type="submit"
          >
            + Buat Wedding
          </button>

        </div>


      </form>

    </div>

  </section>


  <!-- =====================================================
       WEDDING LIST
  ====================================================== -->

  <section class="panel">

    <div class="panel-header">

      <div>

        <h2>
          Daftar Wedding
        </h2>

        <div class="muted">
          Semua wedding yang tersimpan di Upstash Redis.
        </div>

      </div>

    </div>


    <div class="panel-body">


      <% if (!weddings.length) { %>

        <div class="empty">
          Belum ada wedding invitation.
        </div>

      <% } %>


      <% weddings.forEach(
        function(wedding)
      { %>


        <article
          class="wedding-card"
          id="wedding-card-<%= wedding.slug %>"
        >


          <div class="wedding-card-top">


            <div>

              <h3>

                <%= wedding.groom?.name || "" %>

                &

                <%= wedding.bride?.name || "" %>

              </h3>

              <div class="slug">
                /<%= wedding.slug %>
              </div>

            </div>


            <span
              class="status <%= wedding.status === 'published' ? 'published' : 'draft' %>"
            >

              <%= wedding.status === "published"
                ? "PUBLISHED"
                : "DRAFT" %>

            </span>


          </div>


          <div class="stats-row">


            <div class="mini-stat">

              <small>
                RSVP
              </small>

              <strong>
                <%= wedding.stats?.total || 0 %>
              </strong>

            </div>


            <div class="mini-stat">

              <small>
                Hadir
              </small>

              <strong>
                <%= wedding.stats?.hadir || 0 %>
              </strong>

            </div>


            <div class="mini-stat">

              <small>
                Tamu
              </small>

              <strong>
                <%= wedding.stats?.guestCount || 0 %>
              </strong>

            </div>


            <div class="mini-stat">

              <small>
                Gallery
              </small>

              <strong>
                <%= wedding.gallery?.length || 0 %>
              </strong>

            </div>


          </div>


          <div class="button-row" style="margin-top:18px">


            <button
              type="button"
              class="secondary"
              onclick="openEdit('<%= wedding.slug %>')"
            >
              Edit
            </button>


            <a
              class="button secondary"
              href="/<%= encodeURIComponent(wedding.slug) %>"
              target="_blank"
              rel="noopener"
            >
              Buka
            </a>


            <button
              type="button"
              onclick="showRSVP('<%= wedding.slug %>')"
            >
              RSVP
            </button>


            <% if (wedding.status === "published") { %>

              <button
                type="button"
                class="secondary"
                onclick="changeStatus(
                  '<%= wedding.slug %>',
                  'unpublish'
                )"
              >
                Unpublish
              </button>

            <% } else { %>

              <button
                type="button"
                class="success"
                onclick="changeStatus(
                  '<%= wedding.slug %>',
                  'publish'
                )"
              >
                Publish
              </button>

            <% } %>


            <button
              type="button"
              class="danger"
              onclick="deleteWedding(
                '<%= wedding.slug %>'
              )"
            >
              Hapus
            </button>


          </div>


          <!-- =================================================
               EDIT PANEL
          ================================================== -->

          <div
            class="edit-panel"
            id="edit-<%= wedding.slug %>"
            hidden
          >

            <form
              class="editWeddingForm"
              data-slug="<%= wedding.slug %>"
            >

              <div class="section-title">
                <h3>
                  Edit Informasi Wedding
                </h3>
              </div>


              <div class="form-grid">


                <div class="form-group">

                  <label>
                    Slug
                  </label>

                  <input
                    name="slug"
                    value="<%= wedding.slug %>"
                    required
                    minlength="3"
                    maxlength="100"
                  >

                </div>


                <div class="form-group">

                  <label>
                    Status
                  </label>

                  <select name="status">

                    <option
                      value="draft"
                      <%= wedding.status !== "published"
                        ? "selected"
                        : "" %>
                    >
                      Draft
                    </option>

                    <option
                      value="published"
                      <%= wedding.status === "published"
                        ? "selected"
                        : "" %>
                    >
                      Published
                    </option>

                  </select>

                </div>


                <div class="form-group">

                  <label>
                    Mempelai Pria
                  </label>

                  <input
                    name="groomName"
                    value="<%= wedding.groom?.name || "" %>"
                  >

                </div>


                <div class="form-group">

                  <label>
                    Nama Lengkap Pria
                  </label>

                  <input
                    name="groomFullName"
                    value="<%= wedding.groom?.fullName || "" %>"
                  >

                </div>


                <div class="form-group">

                  <label>
                    Mempelai Wanita
                  </label>

                  <input
                    name="brideName"
                    value="<%= wedding.bride?.name || "" %>"
                  >

                </div>


                <div class="form-group">

                  <label>
                    Nama Lengkap Wanita
                  </label>

                  <input
                    name="brideFullName"
                    value="<%= wedding.bride?.fullName || "" %>"
                  >

                </div>


                <div class="form-group">

                  <label>
                    Tanggal Pernikahan
                  </label>

                  <input
                    name="date"
                    type="datetime-local"
                    value="<%= wedding.date || "" %>"
                  >

                </div>


                <div class="form-group">

                  <label>
                    Timezone
                  </label>

                  <select name="timezone">

                    <option
                      value="Asia/Jakarta"
                      <%= wedding.timezone === "Asia/Jakarta"
                        ? "selected"
                        : "" %>
                    >
                      Asia/Jakarta — WIB
                    </option>

                    <option
                      value="Asia/Makassar"
                      <%= wedding.timezone === "Asia/Makassar"
                        ? "selected"
                        : "" %>
                    >
                      Asia/Makassar — WITA
                    </option>

                    <option
                      value="Asia/Jayapura"
                      <%= wedding.timezone === "Asia/Jayapura"
                        ? "selected"
                        : "" %>
                    >
                      Asia/Jayapura — WIT
                    </option>

                  </select>

                </div>


              </div>


              <div class="section-title">

                <h3>
                  Opening
                </h3>

              </div>


              <div class="form-grid">


                <div class="form-group">

                  <label>
                    Judul
                  </label>

                  <input
                    name="openingTitle"
                    value="<%= wedding.opening?.title || "The Wedding Of" %>"
                  >

                </div>


                <div class="form-group">

                  <label>
                    Subtitle
                  </label>

                  <input
                    name="openingSubtitle"
                    value="<%= wedding.opening?.subtitle || "" %>"
                  >

                </div>


                <div class="form-group full">

                  <label>
                    Deskripsi
                  </label>

                  <textarea
                    name="openingDescription"
                  ><%= wedding.opening?.description || "" %></textarea>

                </div>


              </div>


              <div class="section-title">

                <h3>
                  Quote & Deskripsi
                </h3>

              </div>


              <div class="form-group">

                <label>
                  Quote
                </label>

                <textarea
                  name="quote"
                ><%= wedding.quote || "" %></textarea>

              </div>


              <div class="form-group">

                <label>
                  Deskripsi Wedding
                </label>

                <textarea
                  name="description"
                ><%= wedding.description || "" %></textarea>

              </div>


              <!-- =================================================
                   COVER
              ================================================== -->

              <div class="section-title">

                <h3>
                  Cover Image
                </h3>

              </div>


              <div class="media-box">

                <% if (
                  wedding.coverImage?.mediaId
                ) { %>

                  <img
                    class="media-preview"
                    src="/media/<%= encodeURIComponent(wedding.slug) %>/<%= encodeURIComponent(wedding.coverImage.mediaId) %>"
                    alt="Cover"
                  >

                <% } %>


                <input
                  type="file"
                  accept="image/jpeg,image/png,image/webp,image/gif"
                  data-media-role="cover"
                  data-media-slug="<%= wedding.slug %>"
                >

                <small class="muted">
                  Maksimal 1 MB. JPG, PNG, WEBP atau GIF.
                </small>

              </div>


              <!-- =================================================
                   GROOM
              ================================================== -->

              <div class="section-title">

                <h3>
                  Foto Mempelai Pria
                </h3>

              </div>


              <div class="media-box">

                <% if (
                  wedding.groom?.photo?.mediaId
                ) { %>

                  <img
                    class="media-preview square"
                    src="/media/<%= encodeURIComponent(wedding.slug) %>/<%= encodeURIComponent(wedding.groom.photo.mediaId) %>"
                    alt="Groom"
                  >

                <% } %>


                <input
                  type="file"
                  accept="image/jpeg,image/png,image/webp,image/gif"
                  data-media-role="groom"
                  data-media-slug="<%= wedding.slug %>"
                >

              </div>


              <!-- =================================================
                   BRIDE
              ================================================== -->

              <div class="section-title">

                <h3>
                  Foto Mempelai Wanita
                </h3>

              </div>


              <div class="media-box">

                <% if (
                  wedding.bride?.photo?.mediaId
                ) { %>

                  <img
                    class="media-preview square"
                    src="/media/<%= encodeURIComponent(wedding.slug) %>/<%= encodeURIComponent(wedding.bride.photo.mediaId) %>"
                    alt="Bride"
                  >

                <% } %>


                <input
                  type="file"
                  accept="image/jpeg,image/png,image/webp,image/gif"
                  data-media-role="bride"
                  data-media-slug="<%= wedding.slug %>"
                >

              </div>


              <!-- =================================================
                   GALLERY
              ================================================== -->

              <div class="section-title">

                <h3>
                  Gallery
                </h3>

              </div>


              <div class="media-box">


                <div
                  class="gallery-preview"
                  id="gallery-<%= wedding.slug %>"
                >


                  <% (wedding.gallery || []).forEach(
                    function(image)
                  { %>


                    <% if (image?.mediaId) { %>

                      <div
                        class="gallery-item"
                        data-gallery-media="<%= image.mediaId %>"
                      >

                        <img
                          src="/media/<%= encodeURIComponent(wedding.slug) %>/<%= encodeURIComponent(image.mediaId) %>"
                          alt="<%= image.caption || "Gallery" %>"
                          loading="lazy"
                        >

                        <button
                          type="button"
                          onclick="deleteMedia(
                            '<%= wedding.slug %>',
                            '<%= image.mediaId %>'
                          )"
