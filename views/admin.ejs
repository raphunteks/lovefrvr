</main>


<!-- =======================================================
     RSVP MODAL
======================================================== -->

<div
  id="rsvpModal"
  class="modal"
>

  <div class="modal-card">

    <div class="modal-header">

      <h2>
        Data RSVP
      </h2>

      <button
        type="button"
        class="modal-close"
        onclick="closeModal('rsvpModal')"
      >
        ×
      </button>

    </div>

    <div
      id="rsvpContent"
      class="modal-body"
    >
      Memuat...
    </div>

  </div>

</div>


<script>

const CSRF_TOKEN =
  <%- JSON.stringify(csrfToken) %>;

const BASE_URL =
  window.location.origin;


/* =========================================================
   GLOBAL MESSAGE
========================================================= */

function showMessage(
  message,
  type = "success"
) {

  const target =
    document.getElementById(
      "globalMessage"
    );

  target.innerHTML = "";

  const div =
    document.createElement(
      "div"
    );

  div.className =
    "notice " +
    (
      type === "error"
        ? "error"
        : "success"
    );

  div.textContent =
    message;

  target.appendChild(
    div
  );

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });

  setTimeout(
    function() {

      div.remove();

    },
    5000
  );

}


/* =========================================================
   API JSON HELPER
========================================================= */

async function requestJSON(
  url,
  options = {}
) {

  const response =
    await fetch(
      url,
      {
        ...options,

        headers: {
          "Content-Type":
            "application/json",

          "X-CSRF-Token":
            CSRF_TOKEN,

          ...(options.headers || {})

        }

      }
    );

  const text =
    await response.text();

  let data;

  try {

    data =
      JSON.parse(
        text
      );

  } catch {

    /*
       Ini sengaja ditangani agar
       error:

       Unexpected token '<'
       
       tidak muncul lagi.
    */

    throw new Error(
      "Server mengembalikan HTML, bukan JSON. Periksa error server/Vercel."
    );

  }

  if (
    !response.ok ||
    !data.success
  ) {

    throw new Error(
      data.message ||
      "Request gagal."
    );

  }

  return data;

}


/* =========================================================
   SLUG PREVIEW
========================================================= */

const createSlug =
  document.getElementById(
    "createSlug"
  );

const createUrl =
  document.getElementById(
    "createUrl"
  );


if (
  createSlug &&
  createUrl
) {

  createSlug.addEventListener(
    "input",
    function() {

      const value =
        this.value
          .toLowerCase()
          .replace(
            /\s+/g,
            "-"
          )
          .replace(
            /[^a-z0-9-]/g,
            ""
          )
          .replace(
            /-+/g,
            "-"
          )
          .replace(
            /^-|-$/g,
            ""
          );

      this.value =
        value;

      createUrl.textContent =
        BASE_URL +
        "/" +
        value;

    }
  );

}


/* =========================================================
   COLLECT CREATE FORM
========================================================= */

function collectCreateForm() {

  return {

    slug:
      document.getElementById(
        "createSlug"
      ).value,

    status:
      document.getElementById(
        "createStatus"
      ).value,

    groomName:
      document.getElementById(
        "createGroomName"
      ).value,

    groomFullName:
      document.getElementById(
        "createGroomFullName"
      ).value,

    brideName:
      document.getElementById(
        "createBrideName"
      ).value,

    brideFullName:
      document.getElementById(
        "createBrideFullName"
      ).value,

    date:
      document.getElementById(
        "createDate"
      ).value,

    timezone:
      document.getElementById(
        "createTimezone"
      ).value,

    openingTitle:
      document.getElementById(
        "createOpeningTitle"
      ).value,

    openingSubtitle:
      document.getElementById(
        "createOpeningSubtitle"
      ).value,

    openingDescription:
      document.getElementById(
        "createOpeningDescription"
      ).value,

    quote:
      document.getElementById(
        "createQuote"
      ).value,

    description:
      document.getElementById(
        "createDescription"
      ).value,

    openingEnabled:
      true,

    showCountdown:
      document.getElementById(
        "createShowCountdown"
      ).checked,

    showStory:
      document.getElementById(
        "createShowStory"
      ).checked,

    showGallery:
      document.getElementById(
        "createShowGallery"
      ).checked,

    showGift:
      document.getElementById(
        "createShowGift"
      ).checked,

    showRsvp:
      document.getElementById(
        "createShowRsvp"
      ).checked,

    bottomNavigation:
      document.getElementById(
        "createBottomNavigation"
      ).checked,

    events: [],

    story: [],

    gallery: [],

    gift: [],

    musicEnabled:
      false,

    musicUrl:
      "",

    musicMediaId:
      ""

  };

}


/* =========================================================
   CREATE
========================================================= */

document
  .getElementById(
    "createWeddingForm"
  )
  .addEventListener(
    "submit",
    async function(
      event
    ) {

      event.preventDefault();

      const payload =
        collectCreateForm();

      if (
        !payload.slug.trim()
      ) {

        showMessage(
          "Slug wajib diisi.",
          "error"
        );

        return;

      }

      try {

        const result =
          await requestJSON(
            "/admin/wedding/new",
            {

              method:
                "POST",

              body:
                JSON.stringify(
                  payload
                )

            }
          );

        showMessage(
          result.message
        );

        setTimeout(
          function() {

            location.reload();

          },
          700
        );

      } catch (
        error
      ) {

        showMessage(
          error.message,
          "error"
        );

      }

    }
  );


/* =========================================================
   OPEN EDIT
========================================================= */

function openEdit(
  slug
) {

  const panel =
    document.getElementById(
      "edit-" +
      slug
    );

  if (!panel) {

    return;

  }

  panel.hidden =
    false;

  panel.scrollIntoView({
    behavior:
      "smooth",

    block:
      "start"

  });

}


function closeEdit(
  slug
) {

  const panel =
    document.getElementById(
      "edit-" +
      slug
    );

  if (panel) {

    panel.hidden =
      true;

  }

}


/* =========================================================
   CHANGE STATUS
========================================================= */

async function changeStatus(
  slug,
  action
) {

  try {

    const result =
      await requestJSON(
        "/admin/wedding/" +
        encodeURIComponent(
          slug
        ) +
        "/" +
        action,
        {
          method:
            "POST"
        }
      );

    showMessage(
      result.message
    );

    setTimeout(
      function() {

        location.reload();

      },
      700
    );

  } catch (
    error
  ) {

    showMessage(
      error.message,
      "error"
    );

  }

}


/* =========================================================
   DELETE
========================================================= */

async function deleteWedding(
  slug
) {

  const first =
    confirm(
      "Hapus wedding \"" +
      slug +
      "\"?\n\nSemua data invitation dan RSVP akan dihapus."
    );

  if (!first) {

    return;

  }

  const second =
    confirm(
      "Konfirmasi sekali lagi. Data tidak dapat dikembalikan."
    );

  if (!second) {

    return;

  }

  try {

    const result =
      await requestJSON(
        "/admin/wedding/" +
        encodeURIComponent(
          slug
        ) +
        "/delete",
        {
          method:
            "POST"
        }
      );

    showMessage(
      result.message
    );

    setTimeout(
      function() {

        location.reload();

      },
      700
    );

  } catch (
    error
  ) {

    showMessage(
      error.message,
      "error"
    );

  }

}


/* =========================================================
   MEDIA FILE -> DATA URL
========================================================= */

function readFileAsDataURL(
  file
) {

  return new Promise(
    function(
      resolve,
      reject
    ) {

      const reader =
        new FileReader();

      reader.onload =
        function() {

          resolve(
            reader.result
          );

        };

      reader.onerror =
        function() {

          reject(
            new Error(
              "Gagal membaca file."
            )
          );

        };

      reader.readAsDataURL(
        file
      );

    }
  );

}


/* =========================================================
   MEDIA UPLOAD
========================================================= */

async function uploadMedia(
  slug,
  file,
  role
) {

  if (!file) {

    return;

  }

  const isAudio =
    role ===
    "music";

  const max =
    isAudio
      ? 8 * 1024 * 1024
      : 1 * 1024 * 1024;

  if (
    file.size >
    max
  ) {

    throw new Error(
      isAudio
        ? "MP3 maksimal 8 MB."
        : "Gambar maksimal 1 MB."
    );

  }

  const allowedImages = [
    "image/jpeg",
    "image/png",
    "image/webp",
    "image/gif"
  ];

  if (
    !isAudio &&
    !allowedImages.includes(
      file.type
    )
  ) {

    throw new Error(
      "Format gambar tidak didukung."
    );

  }

  if (
    isAudio &&
    ![
      "audio/mpeg",
      "audio/mp3"
    ].includes(
      file.type
    )
  ) {

    throw new Error(
      "File harus MP3."
    );

  }

  const data =
    await readFileAsDataURL(
      file
    );

  const result =
    await requestJSON(
      "/admin/wedding/" +
      encodeURIComponent(
        slug
      ) +
      "/media",
      {

        method:
          "POST",

        body:
          JSON.stringify({

            data,

            mime:
              file.type,

            name:
              file.name,

            caption:
              "",

            kind:
              isAudio
                ? "audio"
                : "image",

            role

          })

      }
    );

  return result;

}


/* =========================================================
   MEDIA INPUT HANDLER
========================================================= */

document
  .querySelectorAll(
    "input[type=file][data-media-role]"
  )
  .forEach(
    function(input) {

      input.addEventListener(
        "change",
        async function() {

          const files =
            Array.from(
              this.files ||
                []
            );

          if (
            !files.length
          ) {

            return;

          }

          const role =
            this.dataset
              .mediaRole;

          const slug =
            this.dataset
              .mediaSlug;

          try {

            if (
              role ===
              "gallery"
            ) {

              for (
                const file of
                files
              ) {

                await uploadMedia(
                  slug,
                  file,
                  role
                );

              }

            } else {

              await uploadMedia(
                slug,
                files[0],
                role
              );

            }

            showMessage(
              "Media berhasil diupload ke Upstash Redis."
            );

            setTimeout(
              function() {

                location.reload();

              },
              600
            );

          } catch (
            error
          ) {

            showMessage(
              error.message,
              "error"
            );

          }

        }
      );

    }
  );


