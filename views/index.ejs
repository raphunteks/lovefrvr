<!DOCTYPE html>
<html lang="id">
<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="theme-color"
    content="#f7f2eb"
  >

  <title>
    LOVEFOREVER — Wedding Invitation
  </title>


  <meta
    name="description"
    content="LOVEFOREVER — Elegant digital wedding invitation."
  >


  <style>

    * {
      box-sizing: border-box;
    }


    :root {
      --bg: #f7f2eb;
      --surface: #fffdf9;
      --text: #302b27;
      --muted: #8c837b;
      --line: #ded7cf;
      --accent: #75675c;
    }


    html,
    body {
      margin: 0;
      min-height: 100%;
    }


    body {

      background:
        radial-gradient(
          circle at top,
          rgba(255,255,255,.8),
          transparent 50%
        ),
        var(--bg);

      color:
        var(--text);

      font-family:
        Inter,
        Arial,
        sans-serif;

    }


    .page {

      width:
        min(
          100%,
          1500px
        );

      min-height:
        100vh;

      margin:
        auto;

      padding:
        40px 25px 80px;

    }


    header {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      margin-bottom:
        80px;

    }


    .logo {

      font-size:
        21px;

      font-weight:
        800;

      letter-spacing:
        .18em;

    }


    .admin {

      color:
        var(--text);

      text-decoration:
        none;

      padding:
        10px 16px;

      border:
        1px solid
        var(--line);

      border-radius:
        999px;

      background:
        rgba(
          255,
          255,
          255,
          .5
        );

    }


    .hero {

      max-width:
        900px;

      margin:
        0 auto 100px;

      text-align:
        center;

    }


    .eyebrow {

      margin:
        0 0 20px;

      letter-spacing:
        .35em;

      font-size:
        11px;

      color:
        var(--muted);

    }


    h1 {

      margin:
        0;

      font-family:
        Georgia,
        "Times New Roman",
        serif;

      font-size:
        clamp(
          48px,
          9vw,
          105px
        );

      font-weight:
        500;

      line-height:
        .95;

    }


    .hero p {

      max-width:
        650px;

      margin:
        28px auto 0;

      color:
        var(--muted);

      font-size:
        17px;

      line-height:
        1.8;

    }


    .weddings {

      display:
        grid;

      grid-template-columns:
        repeat(
          auto-fit,
          minmax(
            280px,
            1fr
          )
        );

      gap:
        25px;

    }


    .card {

      overflow:
        hidden;

      border:
        1px solid
        var(--line);

      border-radius:
        24px;

      background:
        rgba(
          255,
          255,
          255,
          .65
        );

      box-shadow:
        0 20px 50px
        rgba(
          50,
          40,
          30,
          .05
        );

      transition:
        transform .3s ease,
        box-shadow .3s ease;

    }


    .card:hover {

      transform:
        translateY(
          -5px
        );

      box-shadow:
        0 30px 60px
        rgba(
          50,
          40,
          30,
          .09
        );

    }


    .card-image {

      aspect-ratio:
        4 / 3;

      background:
        #ece5dc;

      overflow:
        hidden;

    }


    .card-image img {

      width:
        100%;

      height:
        100%;

      object-fit:
        cover;

    }


    .card-body {

      padding:
        25px;

      text-align:
        center;

    }


    .card-body small {

      display:
        block;

      color:
        var(--muted);

      letter-spacing:
        .25em;

      font-size:
        10px;

      margin-bottom:
        10px;

    }


    .card-body h2 {

      margin:
        0;

      font-family:
        Georgia,
        serif;

      font-size:
        28px;

      font-weight:
        500;

    }


    .card-body p {

      color:
        var(--muted);

      line-height:
        1.7;

    }


    .button {

      display:
        inline-flex;

      align-items:
        center;

      justify-content:
        center;

      padding:
        13px 22px;

      border:
        0;

      border-radius:
        999px;

      background:
        var(--accent);

      color:
        white;

      text-decoration:
        none;

      font-weight:
        700;

    }


    .empty {

      text-align:
        center;

      padding:
        80px 20px;

      color:
        var(--muted);

      border:
        1px dashed
        var(--line);

      border-radius:
        24px;

    }


    footer {

      margin-top:
        100px;

      text-align:
        center;

      color:
        var(--muted);

      font-size:
        12px;

      letter-spacing:
        .1em;

    }


    @media (
      max-width: 600px
    ) {

      .page {
        padding:
          25px 15px 60px;
      }

      header {
        margin-bottom:
          55px;
      }

      .hero {
        margin-bottom:
          60px;
      }

      .hero p {
        font-size:
          15px;
      }

    }

  </style>

</head>


<body>

<div class="page">


  <header>

    <div class="logo">
      LOVEFOREVER
    </div>


    <a
      href="/login"
      class="admin"
    >
      Admin
    </a>

  </header>


  <section class="hero">

    <p class="eyebrow">
      DIGITAL WEDDING INVITATION
    </p>

    <h1>
      Love<br>
      Forever
    </h1>

    <p>
      Sebuah ruang digital untuk menyimpan
      cerita, doa, dan momen bahagia
      menuju hari istimewa.
    </p>

  </section>


  <% if (error) { %>

    <div class="empty">

      <%= error %>

    </div>

  <% } %>


  <% if (weddings.length) { %>

    <section class="weddings">

      <% weddings.forEach(function(wedding) { %>

        <article class="card">


          <div class="card-image">

            <% if (
              wedding.cover &&
              wedding.cover.url
            ) { %>

              <img
                src="<%= wedding.cover.url %>"
                alt="<%= wedding.title %>"
                loading="lazy"
              >

            <% } else { %>

              <div
                style="
                  width:100%;
                  height:100%;
                  display:flex;
                  align-items:center;
                  justify-content:center;
                  font-family:Georgia,serif;
                  font-size:34px;
                "
              >
                LOVE
              </div>

            <% } %>

          </div>


          <div class="card-body">

            <small>
              <%= wedding.title %>
            </small>


            <h2>

              <%= wedding.bride.name %>

              &

              <%= wedding.groom.name %>

            </h2>


            <% if (wedding.date) { %>

              <p>
                <%= wedding.date %>
              </p>

            <% } %>


            <a
              class="button"
              href="/<%= encodeURIComponent(
                wedding.slug
              ) %>"
            >
              Buka Undangan
            </a>

          </div>


        </article>

      <% }) %>

    </section>

  <% } else { %>

    <div class="empty">

      Belum ada wedding yang
      dipublikasikan.

    </div>

  <% } %>


  <footer>

    LOVEFOREVER · DIGITAL WEDDING INVITATION

  </footer>


</div>

</body>
</html>
