<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#fdfbf7">
  <title>LOVEFOREVER — Wedding Invitation</title>
  <meta name="description" content="Platform Undangan Pernikahan Eksklusif">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #FDFBF7; --text: #3A332E; --muted: #7D746D;
      --accent: #9A826B; --surface: #FFFFFF;
      --font-serif: 'Cormorant Garamond', serif;
      --font-sans: 'Plus Jakarta Sans', sans-serif;
    }
    
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--font-sans); }
    a { color: inherit; text-decoration: none; }
    
    .site-header { position: sticky; top: 0; z-index: 100; height: 70px; display: flex; align-items: center; justify-content: space-between; padding: 0 30px; background: rgba(253,251,247,0.9); backdrop-filter: blur(15px); border-bottom: 1px solid rgba(0,0,0,0.05); }
    .brand { font-family: var(--font-serif); font-weight: 600; letter-spacing: 0.15em; font-size: 22px; color: var(--accent); }
    .header-admin-link { padding: 8px 20px; border-radius: 50px; background: rgba(154,130,107,0.1); color: var(--accent); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; transition: all 0.3s; }
    .header-admin-link:hover { background: var(--accent); color: #fff; }
    
    .hero { min-height: 80svh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 60px 20px; position: relative; }
    .badge-pill { padding: 6px 16px; background: rgba(154,130,107,0.1); color: var(--accent); border-radius: 50px; font-size: 10px; font-weight: 700; letter-spacing: 0.25em; text-transform: uppercase; margin-bottom: 24px; display: inline-block;}
    .hero h1 { font-family: var(--font-serif); font-size: clamp(50px, 10vw, 100px); font-weight: 400; line-height: 1; margin: 0; color: var(--text); }
    .hero h1 span { font-style: italic; color: var(--accent); }
    .hero p { max-width: 500px; margin: 24px auto 36px; font-size: 14px; color: var(--muted); line-height: 1.8; }
    .btn-primary { background: var(--accent); color: #fff; padding: 14px 32px; border-radius: 50px; font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; box-shadow: 0 10px 25px rgba(154,130,107,0.25); transition: all 0.3s; }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 15px 30px rgba(154,130,107,0.35); }
    
    .invitations-section { max-width: 1000px; margin: 0 auto; padding: 80px 20px 120px; text-align: center; }
    .section-title { font-family: var(--font-serif); font-size: 40px; font-weight: 400; margin-bottom: 40px; }
    
    .wedding-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
    .wedding-card { background: var(--surface); border: 1px solid rgba(0,0,0,0.03); border-radius: 20px; padding: 40px 30px; box-shadow: 0 15px 40px rgba(0,0,0,0.02); text-align: center; transition: transform 0.4s; }
    .wedding-card:hover { transform: translateY(-5px); box-shadow: 0 20px 50px rgba(0,0,0,0.05); }
    .wedding-card h3 { font-family: var(--font-serif); font-size: 28px; font-weight: 500; margin: 15px 0 10px; line-height: 1.2; }
    .wedding-card p { font-size: 13px; color: var(--muted); margin-bottom: 24px; }
    .btn-outline { display: inline-block; padding: 10px 24px; border: 1px solid var(--accent); color: var(--accent); border-radius: 50px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; transition: all 0.3s; }
    .btn-outline:hover { background: var(--accent); color: #fff; }
    
    .empty-state { padding: 60px 20px; color: var(--muted); font-size: 14px; border: 1px dashed rgba(154,130,107,0.3); border-radius: 20px; }
    .site-footer { text-align: center; padding: 40px 20px; border-top: 1px solid rgba(0,0,0,0.05); color: var(--muted); font-size: 12px; letter-spacing: 0.1em; }
  </style>
</head>
<body>

<header class="site-header">
  <a href="/" class="brand">LOVEFOREVER</a>
  <a href="/admin/login" class="header-admin-link">Dashboard</a>
</header>

<main>
  <section class="hero">
    <div class="badge-pill">PREMIUM INVITATION</div>
    <h1>Love <span>Forever</span></h1>
    <p>Platform eksklusif untuk membagikan kisah cinta dan mengundang kerabat pada hari bahagia Anda dengan desain yang elegan dan tak lekang oleh waktu.</p>
    <a href="#invitations" class="btn-primary">Lihat Undangan</a>
  </section>

  <section id="invitations" class="invitations-section">
    <h2 class="section-title">Daftar Undangan</h2>

    <% if (!weddings || weddings.length === 0) { %>
      <div class="empty-state">
        <p>Belum ada wedding invitation yang dipublikasikan saat ini.</p>
      </div>
    <% } else { %>
      <div class="wedding-grid">
        <% weddings.forEach(function(wedding) { %>
          <article class="wedding-card">
            <div class="badge-pill" style="margin-bottom: 10px;">WEDDING OF</div>
            <h3><%= wedding.groom?.name || "Groom" %> <br><span style="font-style:italic;color:var(--accent);font-size:0.7em;">&</span><br> <%= wedding.bride?.name || "Bride" %></h3>
            <% if (wedding.date) { %>
              <p><%= new Date(wedding.date).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            <% } %>
            <a href="/<%= encodeURIComponent(wedding.slug) %>" class="btn-outline">Buka Undangan</a>
          </article>
        <% }); %>
      </div>
    <% } %>
  </section>
</main>

<footer class="site-footer">
  &copy; <%= new Date().getFullYear() %> LOVEFOREVER. All Rights Reserved.
</footer>

</body>
</html>
